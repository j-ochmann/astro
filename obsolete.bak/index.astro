---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Icon } from 'astro-icon/components';
import { 
  getI18nPaths, 
  useTranslations 
} from '@/content/config/i18n';

export async function getStaticPaths() {
  return getI18nPaths();
}

const { lang } = Astro.params;
const t = useTranslations(lang);

// Ukázková data (v praxi nahraďte importem z vašeho zdroje)
const marketDataMock = [
  { id: 'p1', name_cs: 'Senzor teploty', name_en: 'Temperature Sensor', category: 'IoT', price: 25.50, stock: 150, trend: '+2%' },
  { id: 'p2', name_cs: 'Řídící jednotka', name_en: 'Control Unit', category: 'Hardware', price: 1200, stock: 12, trend: '-5%' },
  { id: 'p3', name_cs: 'Průmyslová brána', name_en: 'Industrial Gateway', category: 'Network', price: 450.75, stock: 45, trend: '+0.5%' },
];

// Příprava čistých dat pro server-side rendering
const allMarketItems = marketDataMock.map(item => ({
  id: item.id,
  name: lang === 'cs' ? item.name_cs : item.name_en,
  category: item.category,
  price: item.price,
  stock: item.stock,
  trend: item.trend
}));
---

<StarlightPage 
  frontmatter={{ 
    title: String(t('market.table.title') || 'Market Overview'), 
    template: 'doc' 
  }}
>
  <div class="table-controls">
    <div class="search-box">
      <input 
        type="text" 
        id="tableSearch" 
        placeholder={String(t('market.table.search') || 'Hledat položku...')} 
        aria-label="Search market"
      />
    </div>
    
    <div class="export-group">
      <span class="export-label">Export:</span>
      <div class="export-buttons">
        <button class="export-btn" data-type="json">JSON</button>
        <button class="export-btn" data-type="csv">CSV</button>
        <button class="export-btn" data-type="xml">XML</button>
        <button class="export-btn" data-type="yaml">YAML</button>
      </div>
    </div>
  </div>

  <div class="table-wrapper">
    <table id="marketTable">
      <thead>
        <tr>
          <th data-sort="name">{t('market.stats.name') || 'Název'} <Icon name="lucide:arrow-up-down" /></th>
          <th data-sort="category">{t('market.stats.category') || 'Kategorie'} <Icon name="lucide:arrow-up-down" /></th>
          <th data-sort="price">{t('market.stats.price') || 'Cena'} <Icon name="lucide:arrow-up-down" /></th>
          <th data-sort="stock">{t('market.stats.stock') || 'Sklad'} <Icon name="lucide:arrow-up-down" /></th>
          <th>{t('market.stats.trend') || 'Trend'}</th>
        </tr>
      </thead>
      <tbody id="tableBody">
        {allMarketItems.map(item => (
          <tr data-item={JSON.stringify(item)}>
            <td class="mono">{item.name}</td>
            <td><span class="badge">{item.category}</span></td>
            <td class="price-cell" data-price={item.price}>
              {/* Zde se zobrazí cena naformátovaná klientským skriptem */}
              {item.price}
            </td>
            <td>{item.stock.toLocaleString(lang)} ks</td>
            <td class={item.trend.startsWith('+') ? 'trend-up' : 'trend-down'}>{item.trend}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</StarlightPage>

<style>
  .table-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2rem;
    padding: 1.25rem;
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-hairline);
  }

  .search-box { flex: 1; min-width: 250px; }
  .search-box input {
    width: 100%;
    height: 2.2rem;
    padding: 0 1rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-white);
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 4px;
  }

  .export-group { display: flex; align-items: center; gap: 1rem; }
  .export-label { font-size: 0.75rem; font-weight: bold; color: var(--sl-color-gray-3); text-transform: uppercase; }
  .export-buttons { display: flex; background: var(--sl-color-gray-4); border-radius: 4px; overflow: hidden; gap: 1px; }
  
  .export-btn {
    border: none;
    height: 2rem;
    padding: 0 0.85rem;
    background: var(--sl-color-gray-5);
    color: var(--sl-color-white);
    cursor: pointer;
    font-size: 0.75rem;
    font-weight: 600;
  }
  .export-btn:hover { background: var(--sl-color-accent-low); }

  .table-wrapper { overflow-x: auto; border: 1px solid var(--sl-color-hairline); }
  table { width: 100%; border-collapse: collapse; font-size: 0.875rem; margin: 0; }
  th { background: var(--sl-color-gray-6); padding: 1rem 0.75rem; text-align: left; cursor: pointer; border-bottom: 2px solid var(--sl-color-hairline); white-space: nowrap; }
  td { padding: 0.85rem 0.75rem; border-bottom: 1px solid var(--sl-color-hairline); }
  
  .mono { font-family: var(--sl-font-mono); color: var(--sl-color-accent-high); font-weight: 600; }
  .badge { background: var(--sl-color-gray-5); padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.75rem; }
  .price-cell { font-weight: 700; color: var(--sl-color-white); white-space: nowrap; }
  .trend-up { color: #10b981; font-weight: bold; }
  .trend-down { color: #ef4444; font-weight: bold; }

  th svg { width: 14px; height: 14px; margin-left: 4px; opacity: 0.4; vertical-align: middle; }
</style>

<script is:inline>
  function formatAllPrices() {
    // Načtení měny z localStorage na straně klienta
    const userCurrency = localStorage.getItem('user-currency') || 'CZK';
    const lang = document.documentElement.lang || 'cs';
    
    const formatter = new Intl.NumberFormat(lang, { 
      style: 'currency', 
      currency: userCurrency 
    });

    document.querySelectorAll('.price-cell').forEach(cell => {
      const price = parseFloat(cell.getAttribute('data-price') || '0');
      cell.textContent = formatter.format(price);
    });
  }

  function initMarketTable() {
    const searchInput = document.getElementById('tableSearch');
    const table = document.getElementById('marketTable');
    const tableBody = document.getElementById('tableBody');
    const exportBtns = document.querySelectorAll('.export-btn');

    if (!table || !tableBody) return;

    const rows = Array.from(tableBody.querySelectorAll('tr'));

    // 1. Formátování cen
    formatAllPrices();

    // 2. Vyhledávání
    searchInput?.addEventListener('input', () => {
      const term = searchInput.value.toLowerCase();
      rows.forEach(row => {
        row.style.display = row.innerText.toLowerCase().includes(term) ? '' : 'none';
      });
    });

    // 3. Řazení
    table.querySelectorAll('th[data-sort]').forEach(th => {
      th.addEventListener('click', () => {
        const col = th.getAttribute('data-sort');
        const isAsc = th.classList.contains('asc');
        
        const sortedRows = rows.sort((a, b) => {
          const dataA = JSON.parse(a.getAttribute('data-item') || '{}');
          const dataB = JSON.parse(b.getAttribute('data-item') || '{}');
          const valA = dataA[col];
          const valB = dataB[col];
          
          if (typeof valA === 'number') return isAsc ? valB - valA : valA - valB;
          return isAsc ? String(valB).localeCompare(String(valA)) : String(valA).localeCompare(String(valB));
        });

        table.querySelectorAll('th').forEach(h => h.classList.remove('asc', 'desc'));
        th.classList.toggle('asc', !isAsc);
        th.classList.toggle('desc', isAsc);
        tableBody.append(...sortedRows);
      });
    });

    // 4. Exporty
    exportBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const type = btn.getAttribute('data-type');
        const visibleData = rows
          .filter(r => r.style.display !== 'none')
          .map(r => JSON.parse(r.getAttribute('data-item') || '{}'));

        if (visibleData.length === 0) return;

        let content = '';
        if (type === 'json') content = JSON.stringify(visibleData, null, 2);
        else if (type === 'csv') {
          const keys = Object.keys(visibleData[0]);
          content = [keys.join(','), ...visibleData.map(row => keys.map(k => `"${row[k]}"`).join(','))].join('\n');
        } else if (type === 'xml') {
          content = `<items>${visibleData.map(item => `<item>${Object.entries(item).map(([k,v]) => `<${k}>${v}</${k}>`).join('')}</item>`).join('')}</items>`;
        } else if (type === 'yaml') {
          content = visibleData.map(item => Object.entries(item).map(([k,v]) => `${k}: ${v}`).join('\n')).join('\n---\n');
        }

        const blob = new Blob([content], { type: 'text/plain' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `market_export.${type}`;
        a.click();
      });
    });
  }

  // Spuštění inicializace
  initMarketTable();

  // Kompatibilita se Starlight (Astro View Transitions)
  document.addEventListener('astro:after-swap', initMarketTable);
</script>

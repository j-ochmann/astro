---
import Pagination from '@astrojs/starlight/components/Pagination.astro';
---

<style is:global>
  /* 1. TOTÁLNÍ RESET STARLIGHT STRUKTURY */
  :root {
    --sl-content-pad-x: 0 !important;
    --sl-content-pad-y: 0 !important;
    --sl-content-width: 100% !important;
    --sl-nav-height: 0px !important;
  }

  html, body {
    margin: 0 !important;
    padding: 0 !important;
    overflow: hidden !important;
    height: 100vh !important;
    width: 100vw !important;
    background-color: #000003 !important;
  }

  .page, .main-frame, main, .content-panel, .sl-container, .sl-markdown-content {
    margin: 0 !important;
    padding: 0 !important;
    max-width: 100% !important;
    display: block !important;
  }

  .content-panel {
    margin-top: -20px !important;
    margin-bottom: -20px !important;
  }

  /* 2. FIXNÍ GRAF NA CELÉ OKNO */
  #3d-graph {
    position: fixed !important;
    inset: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    z-index: 1;
  }

  /* 3. SKLENĚNÉ H1 - RESPONZIVNÍ PÍSMO */
  h1 {
    position: fixed !important;
    top: 2rem !important;
    left: calc(var(--sl-sidebar-width) / 2 + 50%) !important;
    transform: translateX(-50%) !important;
    z-index: 100 !important;
    margin: 0 !important;
    padding: 0.5rem 1.5rem !important;
    background: rgba(255, 255, 255, 0.05) !important;
    backdrop-filter: blur(12px) !important;
    border: 1px solid rgba(255, 255, 255, 0.2) !important;
    border-radius: 12px !important;
    color: white !important;
    /* Plynulé zmenšení z 1.2rem na 0.9rem podle šířky okna */
    font-size: clamp(0.9rem, 2vw, 1.2rem) !important;
    white-space: nowrap;
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
  }

  /* 4. TLAČÍTKA PAGINACE - RESPONZIVNÍ PÍSMO */
  .pagination-links {
    position: fixed !important;
    bottom: 2rem !important;
    left: calc(var(--sl-sidebar-width) + 2rem) !important;
    right: 2rem !important;
    z-index: 100 !important;
    display: flex !important;
    justify-content: space-between !important;
    border: none !important;
    gap: 1rem;
  }

  .pagination-links a {
    background: rgba(255, 255, 255, 0.05) !important;
    backdrop-filter: blur(10px) !important;
    border: 1px solid rgba(255, 255, 255, 0.2) !important;
    border-radius: 12px !important;
    padding: 0.8rem 1.2rem !important;
    color: white !important;
    text-decoration: none !important;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
    /* Plynulé zmenšení písma v tlačítkách */
    font-size: clamp(0.8rem, 1.5vw, 1rem) !important;
    flex: 1;
    min-width: 0;
    max-width: 450px;
  }

  /* Vynucení bílé pro vnitřní texty (label a název) a šipky */
  .pagination-links a .link-title,
  .pagination-links a .rel-label,
  .pagination-links a svg {
    color: white !important;
    fill: white !important;
    opacity: 1 !important;
  }

  /* Responzivní chování pro velmi malé displeje */
  @media (max-width: 800px) {
    .pagination-links {
      left: 1rem !important;
      right: 1rem !important;
    }
    h1 {
      top: 1rem !important;
    }
  }

  .right-sidebar-panel, .sidebar-pane {
    border: none !important;
  }
</style>

<div id="3d-graph"></div>
<Pagination {...Astro.props} />

<script>
  import '@/scripts/examples/3d-graph.js';
</script>


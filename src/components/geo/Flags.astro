---
// Flags.astro
interface Props {
  countries: Array<{
    code: string;
    name?: string;
  }>;
}

const { countries = [] } = Astro.props;
---

<div class="flag-grid">
  {countries.map((country) => {
    const code = country.code.toLowerCase();
    return (
      <div class="flag-card" title={country.name}>
        <span class={`fi fi-${code} fib`}></span>
        <code>{code}</code>
        <span class="country-name">{country.name}</span>
      </div>
    );
  })}
</div>

<style>
  .flag-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(45px, 1fr));
    gap: 1rem;
    padding: 1rem;
  }
  .flag-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(35px, 1fr));
    align-items: start;
  }
  .flag-card {
    /* content-visibility: auto; */
    contain-intrinsic-size: 50px 70px;
    will-change: transform;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-top: 0;
    transition: transform 0.2s ease-in-out;
  }

  .flag-card:hover {
    transform: scale(2);
    z-index: 10;
    /* transition: transform 0.2s ease-in-out; */
  }

  .fi {
    width: 2rem !important;
    height: 2rem !important;
    margin-bottom: -0.3rem; /* Snížení mezery */
    border: 1px solid #525252;
    border-radius: 50%;
    overflow: hidden; /* Zajistí, že obsah nepřesáhne kruh */

    /* Přikáže obrázku na pozadí, aby vyplnil celý kontejner */
    background-size: cover !important;
    background-position: center;
    z-index: 1;
  }

  code {
    font-family: monospace;
    /* background: #cfcfcf; */
    padding: 0px 2px 0px 2px;
    border-radius: 5px;
    transform: rotate(-35deg);
    margin: -0.3rem 0 0 1.5rem; /* Posun nahoru a doprava */
    /* z-index: 10 */;
  }

  .country-name {
    display: none;
    font-size: 0.5rem;
    margin-top: 0.2rem;
  }

  .flag-card:hover .country-name {
    display: block;
  }
</style>

---
import { Icon } from 'astro-icon/components';

interface Props {
  data: any[];
  columns: any[];
  basePath: string;
  lang: string;
}

const { data, columns, basePath, lang } = Astro.props;

const isoCol = columns.find(c => c.key === 'code');
const nameCol = columns.find(c => c.key === 'nameEn');
const nativeCol = columns.find(c => c.key === 'native');
const typeCol = columns.find(c => c.key === 'type');
---

<div class="table-container glass-panel shadow-unified">
  <table id="languageTable">
    <thead>
      <tr>
        <th class="num-col">#</th>
        <th class="code-col" data-sort="code">
          <div class="th-content">
            <span>{isoCol?.label || 'ISO'}</span>
            <Icon name="lucide:arrow-up-down" class="sort-icon" />
          </div>
        </th>
        <th class="name-col" data-sort="nameEn">
          <div class="th-content">
            <span>{nameCol?.label || 'Language'}</span>
            <Icon name="lucide:arrow-up-down" class="sort-icon" />
          </div>
        </th>
        <th class="native-col" data-sort="native">
          <div class="th-content">
            <span>{nativeCol?.label || 'Native'}</span>
            <Icon name="lucide:arrow-up-down" class="sort-icon" />
          </div>
        </th>
        <th class="type-col" data-sort="type">
          <div class="th-content">
            <span>{typeCol?.label || 'Type'}</span>
            <Icon name="lucide:arrow-up-down" class="sort-icon" />
          </div>
        </th>
        <th class="states-col" data-sort="usageCount">
          <div class="th-content">
            <span>{lang === 'cs' ? 'Státy' : 'States'}</span>
            <Icon name="lucide:arrow-up-down" class="sort-icon" />
          </div>
        </th>
      </tr>
    </thead>
    <tbody id="tableBody">
      {data.map((item, index) => (
        <tr 
          class="item-row table-row" 
          data-json={JSON.stringify(item)}
          data-category={item.type?.toLowerCase() || ""}
        >
          <td class="num-col index-cell">{index + 1}</td>
          <td class="col-code mono">{item.code}</td>
          <td class="col-name">
            <a href={`${basePath}/${item.code?.toLowerCase()}/`} class="item-link">
              <span class="lang-name">{item.nameEn}</span>
            </a>
          </td>
          <td class="col-native">{item.native}</td>
          <td class="col-type">
             <span class="type-badge" style={`--type-color: ${item.typeColor}`}>
               {item.type}
             </span>
          </td>
          <td class="col-states">
            <div class="states-wrapper">
              <span class="usage-badge">{item.usageCount}</span>
              <div class="flag-wrap">
                {item.flags?.map((f: string) => (
                  <span class:list={['fi', `fi-${f}`, 'mini-flag']} title={f.toUpperCase()}></span>
                ))}
              </div>
            </div>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .table-container { overflow-x: auto; width: 100%; margin-top: 1rem; }
  table { width: 100%; border-collapse: separate; border-spacing: 0; table-layout: auto; }
  
  th { 
    background: var(--accent-bg) !important; color: var(--accent) !important; 
    padding: 0.75rem; text-align: left; cursor: pointer; font-size: 0.7rem; 
    text-transform: uppercase; border-bottom: 2px solid var(--sl-color-gray-5); white-space: nowrap;
  }

  td { padding: 0.75rem 0.6rem; border-bottom: 1px solid var(--sl-color-gray-6); font-size: 0.85rem; vertical-align: middle; }
  tr:hover { background: var(--accent-bg); }

  .num-col { width: 1%; text-align: center; color: var(--sl-color-gray-4); }
  .code-col { width: 1%; min-width: 80px; }
  .name-col { width: 15%; min-width: 150px; }
  .native-col { width: 15%; color: var(--sl-color-gray-3); font-style: italic; }
  .type-col { width: 10%; }
  .states-col { width: auto; }

  .mono { font-family: var(--sl-font-mono); font-weight: 600; color: var(--accent); }

  .type-badge {
    font-size: 0.7rem;
    padding: 2px 8px;
    border-radius: 10px;
    background: color-mix(in srgb, var(--type-color), transparent 85%);
    color: var(--type-color);
    border: 1px solid color-mix(in srgb, var(--type-color), transparent 70%);
    font-weight: 600;
  }

  .states-wrapper { display: flex; align-items: center; gap: 0.75rem; }
  .usage-badge { 
    font-family: var(--sl-font-mono); font-weight: 700; background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-2); padding: 2px 6px; border-radius: 4px; font-size: 0.75rem;
    min-width: 28px; text-align: center; flex-shrink: 0;
  }

  .flag-wrap { display: flex; gap: 4px; flex-wrap: wrap; align-items: center; }
  .mini-flag { width: 1.2rem; height: 0.9rem; border-radius: 2px; box-shadow: 0 1px 2px rgba(0,0,0,0.1); flex-shrink: 0; }

  .lang-name { color: #ffffff !important; font-weight: 600; }
  :global(html[data-theme='light']) .lang-name { color: #000000 !important; }

  .th-content { display: flex; align-items: center; gap: 0.4rem; }
  .sort-icon { width: 12px; height: 12px; opacity: 0.3; }
  .item-link { text-decoration: none !important; }
</style>

<script>
  function initLangTable() {
    const tableBody = document.getElementById('tableBody');
    if (!tableBody) return;

    document.addEventListener('click', (e) => {
      const th = (e.target as HTMLElement).closest('th[data-sort]');
      if (!th) return;

      const col = th.getAttribute('data-sort')!;
      const isAsc = th.classList.contains('asc');
      const rows = Array.from(tableBody.querySelectorAll('.table-row'));

      const sorted = rows.sort((a, b) => {
        const dataA = JSON.parse(a.getAttribute('data-json') || '{}');
        const dataB = JSON.parse(b.getAttribute('data-json') || '{}');
        const vA = dataA[col];
        const vB = dataB[col];
        
        if (typeof vA === 'number' && typeof vB === 'number') return isAsc ? vB - vA : vA - vB;
        return isAsc ? String(vB).localeCompare(String(vA)) : String(vA).localeCompare(String(vB));
      });

      document.querySelectorAll('th').forEach(h => h.classList.remove('asc', 'desc'));
      th.classList.toggle('asc', !isAsc);
      th.classList.toggle('desc', isAsc);
      sorted.forEach(row => tableBody.appendChild(row));
    });
  }
  initLangTable();
  document.addEventListener('astro:after-swap', initLangTable);
</script>

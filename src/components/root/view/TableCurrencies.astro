---
import { Icon } from 'astro-icon/components';

interface Column {
  key: string;
  label: string;
  isMono?: boolean;
  isNumeric?: boolean;
}

interface Props {
  data: any[];
  columns: Column[];
  basePath: string;
  lang: string;
}

const { data, columns, basePath, lang } = Astro.props;

const codeColumn = columns.find(col => col.key === 'code');
const nameColumn = columns.find(col => col.key === 'name');
const groupColumn = columns.find(col => col.key === 'continent');
---

<div class="table-container glass-panel shadow-unified">
  <table id="currencyTable">
    <thead>
      <tr>
        <th class="num-col">#</th>
        <th class="code-col" data-sort="code">
          <div class="th-content">
            <span>{codeColumn?.label || 'Code'}</span>
            <Icon name="lucide:arrow-up-down" class="sort-icon" />
          </div>
        </th>
        <th class="name-col" data-sort="name">
          <div class="th-content">
            <span>{nameColumn?.label || 'Currency'}</span>
            <Icon name="lucide:arrow-up-down" class="sort-icon" />
          </div>
        </th>
        <th class="group-col" data-sort="continent">
          <div class="th-content">
            <span>{groupColumn?.label || 'Category'}</span>
            <Icon name="lucide:arrow-up-down" class="sort-icon" />
          </div>
        </th>
        <th class="states-col" data-sort="usageCount">
          <div class="th-content">
            <span>{lang === 'cs' ? 'Státy' : 'States'}</span>
            <Icon name="lucide:arrow-up-down" class="sort-icon" />
          </div>
        </th>
      </tr>
    </thead>
    <tbody id="tableBody">
      {data.map((item, index) => (
        <tr 
          class="item-row table-row" 
          data-json={JSON.stringify(item)}
          data-category={item.continent?.toLowerCase() || ""}
        >
          <td class="num-col index-cell">{index + 1}</td>
          <td class="col-code mono">{item.code}</td>
          <td class="col-name">
            <a href={`${basePath}/${item.code?.toLowerCase()}/`} class="item-link">
              <span class="currency-name">{item.name}</span>
            </a>
          </td>
          <td class="col-group">
            <div class="group-cell">
              <span class="dot" style={`background-color: ${item.continentColor}`}></span>
              <span>{item.continent}</span>
            </div>
          </td>
          <td class="col-states">
            <div class="states-wrapper">
              <span class="usage-badge">{item.usageCount}</span>
              <div class="flag-wrap">
                {item.flags?.map((f: string) => (
                  <span class:list={['fi', `fi-${f}`, 'mini-flag']} title={f.toUpperCase()}></span>
                ))}
              </div>
            </div>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .table-container { 
    overflow-x: auto; 
    width: 100%; 
    margin-top: 1rem; 
  }
  
  table { 
    width: 100%; 
    border-collapse: separate; 
    border-spacing: 0; 
    table-layout: auto; 
  }
  
  th { 
    background: var(--accent-bg) !important; 
    color: var(--accent) !important; 
    padding: 0.75rem; 
    text-align: left; 
    cursor: pointer; 
    font-size: 0.7rem; 
    text-transform: uppercase; 
    border-bottom: 2px solid var(--sl-color-gray-5); 
    white-space: nowrap;
  }

  td { 
    padding: 0.75rem 0.6rem; 
    border-bottom: 1px solid var(--sl-color-gray-6); 
    font-size: 0.85rem; 
    vertical-align: middle; 
  }
  
  tr:hover { 
    background: var(--accent-bg); 
  }

  /* Šířky sloupců */
  .num-col { width: 1%; text-align: center; color: var(--sl-color-gray-4); }
  .code-col { width: 1%; min-width: 80px; }
  .name-col { width: 20%; min-width: 150px; }
  .group-col { width: 1%; min-width: 130px; }
  .states-col { width: auto; }

  .mono { 
    font-family: var(--sl-font-mono); 
    font-weight: 600; 
    color: var(--accent); 
  }

  /* Sloučený sloupec States se zarovnáním na střed */
  .states-wrapper { 
    display: flex; 
    align-items: center; 
    gap: 0.75rem; 
  }
  
  .usage-badge { 
    font-family: var(--sl-font-mono); 
    font-weight: 700; 
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-2);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 0.75rem;
    min-width: 28px;
    text-align: center;
    flex-shrink: 0;
  }

  .flag-wrap { 
    display: flex; 
    gap: 4px; 
    flex-wrap: wrap; 
    align-items: center;
    max-width: 100%;
    padding: 0.25rem 0;
  }
  
  .mini-flag { 
    width: 1.2rem; 
    height: 0.9rem; 
    border-radius: 2px; 
    box-shadow: 0 1px 2px rgba(0,0,0,0.2); 
    display: block;
    flex-shrink: 0;
  }

  .currency-name { 
    color: #ffffff !important; 
    font-weight: 600; 
  }
  
  :global(html[data-theme='light']) .currency-name { color: #000000 !important; }

  .group-cell { 
    display: flex; 
    align-items: center; 
    gap: 0.5rem; 
    white-space: nowrap; 
  }
  
  .dot { 
    width: 7px; 
    height: 7px; 
    border-radius: 50%; 
    flex-shrink: 0; 
  }

  .th-content { 
    display: flex; 
    align-items: center; 
    gap: 0.4rem; 
  }
  
  .sort-icon { 
    width: 12px; 
    height: 12px; 
    opacity: 0.3; 
  }
  
  .item-link { 
    text-decoration: none !important; 
  }

  :global(html[data-theme='light']) td { border-bottom-color: var(--sl-color-gray-5); }
  :global(html[data-theme='light']) .usage-badge { 
    background: var(--sl-color-gray-5); 
    color: var(--sl-color-gray-1); 
  }
</style>

<script>
  function initCurrencyTable() {
    const tableBody = document.getElementById('tableBody');
    if (!tableBody) return;

    document.addEventListener('click', (e) => {
      const th = (e.target as HTMLElement).closest('th[data-sort]');
      if (!th) return;

      const col = th.getAttribute('data-sort')!;
      const isAsc = th.classList.contains('asc');
      const rows = Array.from(tableBody.querySelectorAll('.table-row'));

      const sorted = rows.sort((a, b) => {
        const vA = JSON.parse(a.getAttribute('data-json') || '{}')[col];
        const vB = JSON.parse(b.getAttribute('data-json') || '{}')[col];
        
        if (typeof vA === 'number' && typeof vB === 'number') {
            return isAsc ? vB - vA : vA - vB;
        }
        return isAsc 
            ? String(vB).localeCompare(String(vA)) 
            : String(vA).localeCompare(String(vB));
      });

      document.querySelectorAll('th').forEach(h => h.classList.remove('asc', 'desc'));
      th.classList.toggle('asc', !isAsc);
      th.classList.toggle('desc', isAsc);

      sorted.forEach(row => tableBody.appendChild(row));
      
      const updateIndices = () => {
        tableBody.querySelectorAll('.index-cell').forEach((cell, i) => {
          cell.textContent = (i + 1).toString();
        });
      };
      updateIndices();
    });
  }

  initCurrencyTable();
  document.addEventListener('astro:after-swap', initCurrencyTable);
</script>

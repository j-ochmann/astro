---
// src/components/root/view/UniversalTable.astro
import BaseTable from './BaseTable.astro';

export interface Column {
  key: string;
  label: string;
  type?: 'country' | 'link' | 'continent' | 'usage' | 'code' | 'text' | 'native';
  isNumeric?: boolean;
  isMono?: boolean;
}

interface Props {
  id: string; // Toto chybělo v chybové hlášce
  data: any[];
  columns: any[]; // Pro teď any, aby se to nepralo s definicí v indexu
  basePath: string;
  lang: string;
}

const { id, data, columns, basePath, lang } = Astro.props;
---

<BaseTable id={id} columns={columns}>
  {data.map((item: any, index: number) => (
    <tr 
      class="table-row" 
      data-json={JSON.stringify(item)}
      data-category={item.continent?.toLowerCase() || ""}
    >
      <td class="num-col index-cell">{index + 1}</td>
      
      {columns.map((col: any) => (
        <td class:list={[{ 'text-right': col.isNumeric }]}>
          {(() => {
            switch(col.type) {
              case 'country': 
                return (
                  <a href={`${basePath}/${item.code?.toLowerCase()}/`} class="item-link">
                    <span class:list={['fi', `fi-${item.code?.toLowerCase()}`, 'table-flag']}></span>
                    {item[col.key]}
                  </a>
                );
              case 'link':
                return (
                  <a href={`${basePath}/${item.code?.toLowerCase()}/`} class="item-link">
                    {item[col.key]}
                  </a>
                );
              case 'code':
                return <span class="mono">{item[col.key]}</span>;
              case 'continent':
                return (
                  <div class="group-cell">
                    <span class="dot" style={`background-color: ${item.continentColor}`}></span>
                    <span>{item[col.key]}</span>
                  </div>
                );
              case 'usage':
                return (
                  <div class="group-cell">
                    <span class="usage-badge">{item.usageCount}</span>
                    <div class="flag-wrap" style="display: flex; gap: 4px;">
                      {item.flags?.map((f: string) => <span class:list={['fi', `fi-${f.toLowerCase()}`]}></span>)}
                    </div>
                  </div>
                );
              default:
                return (
                  <span class:list={[{ 'mono': col.isMono || col.type === 'code' }]}>
                    {col.isNumeric && typeof item[col.key] === 'number' 
                      ? item[col.key].toLocaleString(lang) 
                      : item[col.key]}
                  </span>
                );
            }
          })()}
        </td>
      ))}
    </tr>
  ))}
</BaseTable>

<script>
  function initTable() {
    const tables = document.querySelectorAll('table[id]');
    tables.forEach(table => {
      const tbody = table.querySelector('.table-body') as HTMLElement;
      if (!tbody) return;

      table.querySelectorAll('th[data-sort]').forEach(th => {
        th.addEventListener('click', () => {
          const col = th.getAttribute('data-sort')!;
          const isAsc = th.classList.contains('asc');
          const rows = Array.from(tbody.querySelectorAll('.table-row'));

          const sorted = rows.sort((a, b) => {
            const dataA = JSON.parse(a.getAttribute('data-json') || '{}');
            const dataB = JSON.parse(b.getAttribute('data-json') || '{}');
            const vA = dataA[col];
            const vB = dataB[col];
            
            if (typeof vA === 'number' && typeof vB === 'number') {
              return isAsc ? vB - vA : vA - vB;
            }
            return isAsc 
              ? String(vB).localeCompare(String(vA)) 
              : String(vA).localeCompare(String(vB));
          });

          table.querySelectorAll('th').forEach(h => h.classList.remove('asc', 'desc'));
          th.classList.toggle('asc', !isAsc);
          th.classList.toggle('desc', isAsc);
          sorted.forEach(row => tbody.appendChild(row));
          
          let idx = 1;
          tbody.querySelectorAll('.table-row:not(.hidden) .index-cell').forEach(c => {
             (c as HTMLElement).textContent = (idx++).toString();
          });
        });
      });
    });
  }

  initTable();
  document.addEventListener('astro:after-swap', initTable);
</script>

---
// src/components/root/view/UniversalTable.astro
import BaseTable, { type Column } from './BaseTable.astro';

interface Props {
  id: string;
  data: any[];
  columns: Column[];
  basePath: string;
  lang: string;
  accentColor?: string;
}

const { id, data, columns, basePath, lang, accentColor } = Astro.props;
---

<BaseTable id={id} columns={columns} accentColor={accentColor}>
  {data.map((item: any, index: number) => (
    <tr 
      class="table-row data-item" 
      data-json={JSON.stringify(item)} 
      data-category={item.type?.toLowerCase() || ""}
      data-code={item.code} 
    >
      <td class="num-col index-cell">{index + 1}</td>
      {columns.map((col: Column) => (
        <td class:list={[{ 'text-right': col.isNumeric }]}>
          {(() => {
            switch(col.type) {
              case 'country': // PŘIDÁNO: Zpětná podpora pro tabulku států
                return (
                  <a href={`${basePath}/${item.code?.toLowerCase()}/`} class="item-link">
                    <span class:list={['fi', `fi-${item.code?.toLowerCase()}`, 'table-flag']}></span>
                    <strong class="display-name">{item[col.key]}</strong>
                  </a>
                );
              case 'language-name': // Pro tabulku jazyků
                return (
                  <a href={`${basePath}/${item.code?.toLowerCase()}/`} class="item-link">
                    <strong class="display-name">{item[col.key]}</strong>
                  </a>
                );
              case 'code':
                return <span class="mono accent-mono">{item[col.key]}</span>;
              case 'continent':
                return (
                  <div class="group-cell">
                    <span class="dot" style={`background-color: ${item.typeColor || "#94a3b8"}`}></span>
                    <span class="standard-text">{item[col.key]}</span>
                  </div>
                );
              case 'flags':
                return (
                  <div class="states-wrapper">
                    <span class="usage-badge">{item.usageCount || 0}</span>
                    <div class="flag-wrap">
                      {item.flags?.slice(0, 6).map((f: string) => (
                        <span class:list={['fi', `fi-${f.toLowerCase()}`, 'mini-flag']} title={f.toUpperCase()}></span>
                      ))}
                    </div>
                  </div>
                );
              case 'status':
                return <div class="status-cell mono" style="min-width: 50px;">---</div>;
              case 'test':
                return <div class="test-slot" style="min-width: 40px; display: flex; justify-content: center;"></div>; 
              default:
                return (
                  <span class:list={[
                    { 'mono': col.isMono }, 
                    { 'standard-text': !col.isMono },
                    { 'opacity-60 italic': col.key === 'native' }
                  ]}>
                    {col.isNumeric && typeof item[col.key] === 'number' 
                      ? item[col.key].toLocaleString(lang) 
                      : item[col.key]}
                  </span>
                );
            }
          })()}
        </td>
      ))}
    </tr>
  ))}
</BaseTable>

<style is:global>
  .mini-flag { width: 14px; height: 10px; border-radius: 1px; flex-shrink: 0; box-shadow: 0 1px 2px rgba(0,0,0,0.2); }
  .table-flag { margin-right: 8px; width: 20px; height: 15px; border-radius: 2px; display: inline-block; vertical-align: middle; }
  .states-wrapper { display: flex; align-items: center; gap: 0.5rem; }
  .usage-badge { 
    font-family: var(--sl-font-mono); font-weight: 700; background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-2); padding: 1px 5px; border-radius: 4px; font-size: 0.7rem; min-width: 22px; text-align: center;
  }
  .flag-wrap { display: flex; gap: 3px; flex-wrap: wrap; }

  /* Oprava klikatelnosti */
  .item-link { 
    text-decoration: none !important; 
    display: flex; 
    align-items: center; 
    color: inherit;
  }
  .display-name { 
    color: var(--sl-color-accent, #3b82f6); 
    cursor: pointer;
  }
  .item-link:hover .display-name {
    text-decoration: underline;
  }
</style>

---
interface Column {
  key: string;
  label: string;
}

interface Props {
  data: any[];
  columns: Column[];
  basePath: string;
}

const { data, columns, basePath } = Astro.props;
---

<div class="grid-wrapper" id="gridContainer">
  {data.map(item => (
    <div 
      class="atlas-card glass-panel shadow-unified item-row grid-card" 
      data-id={item.code} 
      data-category={item.continent?.toLowerCase() || item.category?.toLowerCase() || ""}
    >
      <div class="card-header">
        <div class="flag-stack">
          {item.flags ? (
            item.flags.slice(0, 4).map((flagCode: string) => (
              <span class:list={['fi', `fi-${flagCode.toLowerCase()}`, 'flag-small']}></span>
            ))
          ) : (
            item.code && <span class:list={['fi', `fi-${item.code.toLowerCase()}`, 'flag-small']}></span>
          )}
          {item.flags && item.flags.length > 4 && <span class="more-flags">+{item.flags.length - 4}</span>}
        </div>
        <span class="card-code">
          {item.code}
        </span>
      </div>
      <h3 class="card-title">{item.name}</h3>
      <div class="card-meta">
         {columns.slice(2, 6).map(col => (
           <div class="meta-item">
              <span class="meta-label">{col.label}</span> 
              <strong class="meta-value">
                {col.key === 'continent' ? (
                  <span class="continent-val">
                    <span class="dot" style={`background-color: ${item.continentColor}`}></span>
                    {item[col.key]}
                  </span>
                ) : item[col.key]}
              </strong>
           </div>
         ))}
      </div>
      <div class="card-action">
        <a href={`${basePath}/${item.code?.toLowerCase()}/`} class="glass-button">Detail</a>
      </div>
    </div>
  ))}
</div>

<style>
  .grid-wrapper { 
    display: grid !important; 
    grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)) !important; 
    gap: 0.75rem !important; 
    margin-top: 1rem;
    align-items: stretch;
  }

  .atlas-card { 
    padding: 0.65rem 0.75rem; 
    display: flex; 
    flex-direction: column; 
    transition: all 0.2s ease; 
    position: relative; 
    min-height: 130px; 
    height: 100%; 
    overflow: hidden;
    margin-top: 0 !important;
  }

  .atlas-card:hover { border-color: var(--accent) !important; transform: translateY(-3px); }

  .card-header { 
    display: flex; 
    justify-content: space-between; 
    align-items: center; 
    margin-bottom: 0.75rem;
  }

  /* Skládání vlajek */
  .flag-stack { display: flex; align-items: center; gap: 2px; }
  .flag-small { width: 1.2rem; height: 0.9rem; border-radius: 2px; flex-shrink: 0; }
  .more-flags { font-size: 0.6rem; color: var(--sl-color-gray-4); margin-left: 2px; }
  
  .card-code { 
    font-family: var(--sl-font-mono); 
    font-size: 0.6rem; 
    color: var(--sl-color-gray-3); 
    border: 1px solid var(--sl-color-gray-5); 
    padding: 0px 4px; 
    border-radius: 4px; 
    line-height: 1.2;
  }

  .card-title { 
    margin: 0 0 0.15rem 0 !important; 
    font-size: 0.95rem !important; 
    color: #ffffff !important; 
    line-height: 1.1;
    font-weight: 700;
  }

  .card-meta { display: flex; flex-direction: column; gap: 0px; }
  
  .meta-item { 
    display: flex; 
    justify-content: space-between; 
    align-items: baseline;
    font-size: 0.68rem; 
    border-bottom: 1px solid var(--sl-color-gray-6); 
    padding: 1px 0; 
    line-height: 1.2;
  }

  .meta-item:last-child { border-bottom: none; }

  .meta-label { color: var(--sl-color-gray-4); }
  .meta-value { color: var(--sl-color-gray-2); }

  .continent-val { display: flex; align-items: center; gap: 4px; }
  .dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }

  :global(html[data-theme='light']) .card-title { color: #000000 !important; }
  :global(html[data-theme='light']) .meta-label { color: #4b5563 !important; }
  :global(html[data-theme='light']) .meta-value { color: #111827 !important; }
  :global(html[data-theme='light']) .meta-item { border-bottom-color: #e5e7eb !important; }
  :global(html[data-theme='light']) .card-code { color: #6b7280; border-color: #d1d5db; }

  .card-action { 
    position: absolute; bottom: 0; left: 0; right: 0; 
    padding: 0.5rem; transform: translateY(100%); transition: 0.3s ease; 
    background: rgba(0,0,0,0.9); backdrop-filter: blur(10px); z-index: 10;
  }

  .atlas-card:hover .card-action { transform: translateY(0); }
  
  .glass-button { 
    display: block; text-align: center; background: var(--accent); 
    color: #ffffff !important; border-radius: 0.4rem; padding: 0.35rem; 
    font-weight: bold; text-decoration: none !important; font-size: 0.75rem; 
  }
  
  :global(html[data-theme='light']) .card-action { 
    background: rgba(255, 255, 255, 0.95); border-top: 1px solid #e5e7eb; 
  }
</style>

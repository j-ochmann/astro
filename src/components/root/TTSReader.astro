---
const target = Astro.props.target ?? '.sl-markdown-content';
---

<button
  id="tts-btn"
  type="button"
  data-target={target}
  aria-label="Přečíst obsah stránky"
>
  🔊 Přečíst stránku
</button>

<script is:inline>
  if (!('speechSynthesis' in window)) {
    console.warn('[TTS] SpeechSynthesis not supported');
  }

  // 🔥 Warm-up hlasů co nejdřív
  speechSynthesis.getVoices();

  const btn = document.getElementById('tts-btn');

  function extractReadableText(root) {
    const nodes = root.querySelectorAll(
      'h1, h2, h3, h4, h5, h6, p, li, blockquote'
    );

    return Array.from(nodes)
      .map((n) => (n instanceof HTMLElement ? n.innerText.trim() : ''))
      .filter(Boolean)
      .join('\n\n');
  }

  function pickVoice() {
    const voices = speechSynthesis.getVoices();
    if (!voices.length) return null;

    return (
      voices.find(v => v.lang?.startsWith('cs'))
      ?? voices.find(v => v.lang?.startsWith('en'))
      ?? voices[0]
    );
  }

  function safeSpeak(text) {
    if (!text) return;

    // ❗ rušíme jen když je to opravdu potřeba
    if (speechSynthesis.speaking || speechSynthesis.pending) {
      speechSynthesis.cancel();
    }

    const utterance = new SpeechSynthesisUtterance(text);
    utterance.volume = 1;
    utterance.rate = 1;
    utterance.pitch = 1;

    const voice = pickVoice();
    if (!voice) {
      alert('V prohlížeči není dostupný žádný hlas pro předčítání.');
      return;
    }

    utterance.voice = voice;

    utterance.onstart = () => console.log('[TTS] started');
    utterance.onend = () => console.log('[TTS] ended');
    utterance.onerror = (e) => console.error('[TTS] error', e);

    speechSynthesis.speak(utterance);
  }

  if (btn) {
    btn.addEventListener('click', () => {
      const selector = btn.dataset.target;
      if (!selector) return;

      const root = document.querySelector(selector);
      if (!root) {
        alert('Text ke čtení nebyl nalezen.');
        return;
      }

      const text = extractReadableText(root);
      if (!text) {
        alert('Nebyl nalezen žádný čitelný text.');
        return;
      }

      // poslední pojistka – někdy Chrome hlasy lazy-loadne až teď
      if (!speechSynthesis.getVoices().length) {
        speechSynthesis.getVoices();
      }

      safeSpeak(text);
    });
  }
</script>

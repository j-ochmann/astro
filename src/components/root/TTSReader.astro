---
import { Icon } from 'astro-icon/components';
---

<div class="tts-wrapper">
  <button id="tts-toggle" type="button" class="theme-toggle-btn" aria-label="Přečíst stránku">
    <div class="tts-icon-container icon-play">
      <Icon name="line-md:play-filled" width="24" height="24" />
    </div>
    <div class="tts-icon-container icon-stop">
      <Icon name="line-md:square-filled" width="24" height="24" />
    </div>
  </button>
</div>

<style lang="scss">
  @use "@/styles/mixins" as *;

  .theme-toggle-btn {
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
    outline: none;
    appearance: none;
  }

  .tts-icon-container {
    @include icon-glass;
    
    // Reset velikosti SVG, aby sedělo v "glass" ohraničení
    :global(svg) {
      width: 22px !important;
      height: 22px !important;
      fill: currentColor;
    }
  }

  /* Default: show play, hide stop */
  .tts-wrapper .icon-play {
    display: flex;
  }
  .tts-wrapper .icon-stop {
    display: none;
  }

  /* When playing: hide play, show stop */
  .tts-wrapper.is-playing .icon-play {
    display: none;
  }
  .tts-wrapper.is-playing .icon-stop {
    display: flex;
  }
</style>

<script>
declare global {
  interface Window {
    __ttsReaderInitialized?: boolean;
  }
}

(() => {
  if (window.__ttsReaderInitialized) return;
  window.__ttsReaderInitialized = true;

  const button = document.getElementById("tts-toggle") as HTMLButtonElement | null;
  const wrapper = button?.closest('.tts-wrapper') as HTMLElement | null;

  // 1. Zabalíme vše do jedné podmínky, aby TS věděl, že elementy existují
  if (!button || !wrapper) return;

  const synth = window.speechSynthesis;
  let isReading = false;
  let queue: string[] = [];
  let currentIndex = 0;

  function initVoices(callback: () => void) {
    const voices = synth.getVoices();
    if (voices.length) {
      callback();
    } else {
      synth.onvoiceschanged = () => callback();
    }
  }

  initVoices(() => {
    console.log("[TTS] voices ready", synth.getVoices().map(v => v.name));
  });

  function getMainText() {
    const main = document.querySelector("main");
    if (!main) return (document.body.innerText?.trim() ?? "");

    const contentClone = main.cloneNode(true) as HTMLElement;

    const junk = contentClone.querySelectorAll('aside, [aria-hidden="true"], .sr-only, .anchor-link, script, style');
    junk.forEach(el => el.remove());

    // Použijeme Array.from nebo přetypování v forEach
    const blockElements = contentClone.querySelectorAll('h1, h2, h3, h4, h5, h6, p, li, tr, dt, dd');
    
    blockElements.forEach((el) => {
      const htmlEl = el as HTMLElement; // <-- Tady je to důležité přetypování
      if (htmlEl.textContent && !htmlEl.textContent.trim().endsWith('.')) {
        htmlEl.innerText += ' . ';
      } else {
        htmlEl.innerText += ' ';
      }
    });

    return contentClone.innerText.trim();
  }

  function detectLang(text: string) {
    const czChars = /[ěščřžýáíéúůňóďť]/i;
    return czChars.test(text) ? "cs-CZ" : "en-US";
  }

  function getVoice(lang: string) {
    const voices = synth.getVoices();
    return (
      voices.find(v => v.lang === lang) || 
      voices.find(v => v.lang.startsWith(lang.split("-")[0]))
    );
  }

  function chunkText(text: string) {
    // Rozdělí text podle interpunkce, aby každá věta byla samostatný "chunk"
    // [^.!?]+ znamená "všechno co není konec věty"
    // [.!?]+ znamená "jeden nebo více konců vět"
    const sentences = text.match(/[^.!?]+[.!?]*/g) || [text];
    
    // Odstraníme prázdné kusy a ořežeme mezery
    return sentences
      .map(s => s.trim())
      .filter(s => s.length > 0);
  }

  function speakNext() {
    // 2. Tady TS potřeboval ujistit, že wrapper a button stále existují
    if (!isReading || currentIndex >= queue.length) {
      isReading = false;
      wrapper!.classList.remove('is-playing');
      button!.setAttribute('aria-label', 'Přečíst stránku');
      return;
    }

    const text = queue[currentIndex];
    const lang = detectLang(text);
    const voice = getVoice(lang);
    const utterance = new SpeechSynthesisUtterance(text);
    
    utterance.lang = lang;
    utterance.voice = voice ?? null;

    utterance.onstart = () => {
      console.log(`[TTS] ${currentIndex + 1}/${queue.length}`, utterance.lang);
    };

    utterance.onend = () => {
      currentIndex++;
      speakNext();
    };

    utterance.onerror = () => {
      currentIndex++;
      speakNext();
    };

    synth.speak(utterance);
  }

  button.addEventListener("click", () => {
    if (isReading) {
      synth.cancel();
      isReading = false;
      wrapper.classList.remove('is-playing');
      button.setAttribute('aria-label', 'Přečíst stránku');
      return;
    }

    const text = getMainText();
    if (!text) return;

    queue = chunkText(text);
    currentIndex = 0;
    isReading = true;
    
    wrapper.classList.add('is-playing');
    button.setAttribute('aria-label', 'Zastavit čtení');
    speakNext();
  });
})();
</script>

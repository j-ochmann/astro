---
import { Icon } from 'astro-icon/components';
---

<div class="tts-wrapper" id="tts-container">
  <!-- Hlavní Play (vidět jen na začátku) -->
  <button id="tts-start" class="tts-btn main-play" aria-label="Přečíst stránku">
    <Icon name="line-md:play-filled" width="24" height="24" />
  </button>

  <!-- Ovládací panel (skrytý do startu) -->
  <div class="tts-controls">
    <button id="tts-stop" class="tts-btn stop-btn" aria-label="Ukončit">
      <Icon name="line-md:square-filled" width="24" height="24" />
    </button>

    <button id="tts-prev" class="tts-btn" aria-label="Předchozí sekce">
      <Icon name="lucide:skip-back" width="24" height="24" />
    </button>
    
    <button id="tts-toggle" class="tts-btn" aria-label="Pozastavit/Hrát">
      <div class="icon-pause"><Icon name="line-md:pause" width="24" height="24" /></div>
      <div class="icon-resume"><Icon name="line-md:play-filled" width="24" height="24" /></div>
    </button>

    <button id="tts-next" class="tts-btn" aria-label="Další sekce">
      <Icon name="lucide:skip-forward" width="24" height="24" />
    </button>
  </div>
</div>


<style lang="scss">
  @use "@/styles/mixins" as *;
.tts-wrapper {
  display: flex;
  gap: 0.5rem;
  align-items: center;

  .tts-controls { display: none; gap: 0.25rem; }

  // Aktivní stav
  &.is-active {
    .main-play { display: none; }
    .tts-controls { display: flex; }
  }

  // Logika přepínání ikon uvnitř tts-toggle
  #tts-toggle {
    .icon-resume { display: none; } // Výchozí stav: resume je skryté
    .icon-pause { display: flex; }  // Výchozí stav: pause je vidět
  }

  // Stav pauzy - musíme zacílit ikony uvnitř toggle buttonu
  &.is-paused {
    #tts-toggle {
      .icon-pause { display: none; }
      .icon-resume { display: flex; }
    }
  }

  .tts-btn {
    @include icon-glass;
    background: transparent;
    border: none;
    cursor: pointer;
    display: inline-flex; // Změněno na inline-flex pro lepší zarovnání
    align-items: center;
    justify-content: center;
    padding: 6px;
    color: currentColor;
    
    // Zajištění, aby divy uvnitř tlačítka neporušily flexbox
    div {
      display: flex;
      align-items: center;
      justify-content: center;
    }
  }
}

</style>

<script>
declare global {
  interface Window {
    __ttsReaderInitialized?: boolean;
  }
}

(() => {
  if (window.__ttsReaderInitialized) return;
  window.__ttsReaderInitialized = true;

  const container = document.getElementById("tts-container");
  const btnStart = document.getElementById("tts-start");
  const btnToggle = document.getElementById("tts-toggle");
  const btnStop = document.getElementById("tts-stop");
  const btnNext = document.getElementById("tts-next");
  const btnPrev = document.getElementById("tts-prev");

  if (!container || !btnStart || !btnToggle || !btnStop || !btnNext || !btnPrev) return;

  const synth = window.speechSynthesis;
  const pageLang = document.documentElement.lang || "cs";

  interface SpeechItem { text: string; el: HTMLElement; }
  let queue: SpeechItem[] = [];
  let currentIndex = 0;
  let isReading = false;

  function getVoice() {
    const voices = synth.getVoices();
    return voices.find(v => v.lang.startsWith(pageLang)) || voices.find(v => v.default) || null;
  }

  function prepareQueue() {
    const main = document.querySelector("main");
    if (!main) return;
    const elements = Array.from(main.querySelectorAll('h1, h2, h3, h4, h5, h6, p, li')) as HTMLElement[];
    
    queue = elements.map(el => {
      const clone = el.cloneNode(true) as HTMLElement;
      const junk = clone.querySelectorAll('aside, [aria-hidden="true"], .sr-only, .anchor-link, script, style');
      junk.forEach(j => j.remove());
      return { text: clone.innerText.trim() + " . ", el };
    }).filter(item => item.text.trim().length > 2);
  }

  function speak() {
    synth.cancel();
    
    if (!isReading || currentIndex < 0 || currentIndex >= queue.length) {
      if (currentIndex >= queue.length) stopTTS();
      return;
    }

    const item = queue[currentIndex];
    const utterance = new SpeechSynthesisUtterance(item.text);
    utterance.lang = pageLang;
    utterance.voice = getVoice();

    item.el.style.backgroundColor = "rgba(var(--accent-rgb), 0.1)";
    
    // Uložíme si index, který byl platný v době vytvoření této promluvy
    const utteranceIndex = currentIndex;

    utterance.onend = () => {
      item.el.style.backgroundColor = "";
      // KLÍČOVÁ ZMĚNA: Pokračujeme pouze, pokud se index mezitím nezměnil ručně
      if (isReading && currentIndex === utteranceIndex) {
        currentIndex++;
        speak();
      }
    };

    utterance.onerror = (event) => {
      // 'interrupted' znamená, že jsme klikli na Next/Prev/Stop - v tom případě nic neděláme
      if (event.error === 'interrupted') return;
      
      item.el.style.backgroundColor = "";
      if (isReading && currentIndex === utteranceIndex) {
        currentIndex++;
        speak();
      }
    };

    synth.speak(utterance);
  }

 
  function stopTTS() {
    synth.cancel();
    isReading = false;
    currentIndex = 0;
    queue.forEach(item => item.el.style.backgroundColor = "");
    container?.classList.remove('is-active', 'is-paused');
  }

  // Handlery
  btnStart.onclick = () => {
    prepareQueue();
    isReading = true;
    container.classList.add('is-active');
    speak();
  };

  btnToggle.onclick = () => {
    if (synth.speaking && !container.classList.contains('is-paused')) {
      synth.pause();
      container.classList.add('is-paused');
    } else {
      synth.resume();
      container.classList.remove('is-paused');
    }
  };

  btnStop.onclick = stopTTS;

  // Pomocná funkce pro bezpečný posun
  function navigate(direction: number) {
    // 1. Najdeme aktuální utterance (pokud existuje) a umlčíme jeho události
    // V SpeechSynthesis není přímý odkaz na aktuální Utterance, 
    // proto musíme prostě zrušit mluvení a index posunout ručně.
    
    if (queue[currentIndex]) {
      queue[currentIndex].el.style.backgroundColor = "";
    }

    synth.cancel();

    // 2. Posuneme index
    const newIndex = currentIndex + direction;
    if (newIndex >= 0 && newIndex < queue.length) {
      currentIndex = newIndex;
      // Krátký timeout zajistí, že se cancel() stihne v prohlížeči "usadit"
      setTimeout(() => speak(), 10);
    } else if (newIndex >= queue.length) {
      stopTTS();
    }
  }

  btnNext.onclick = () => navigate(1);
  btnPrev.onclick = () => navigate(-1);


  // Kliknutí na text v dokumentu
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const textBlock = target.closest('h1, h2, h3, h4, h5, h6, p, li') as HTMLElement;
    
    if (textBlock && textBlock.closest('main') && !target.closest('#tts-container')) {
      if (queue.length === 0) prepareQueue();
      const newIndex = queue.findIndex(item => item.el === textBlock);
      if (newIndex !== -1) {
        queue.forEach(item => item.el.style.backgroundColor = "");
        currentIndex = newIndex;
        isReading = true;
        container.classList.add('is-active', 'is-paused'); // Reset ikony
        container.classList.remove('is-paused');
        speak();
      }
    }
  });
})();
</script>

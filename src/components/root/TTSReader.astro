---
import { Icon } from 'astro-icon/components';
---

<div class="tts-wrapper" id="tts-container">
  <button id="tts-start" class="tts-btn main-play" aria-label="Přečíst stránku">
    <Icon name="line-md:play-filled" width="24" height="24" />
  </button>

  <div class="tts-controls">
    <button id="tts-stop" class="tts-btn stop-btn" aria-label="Ukončit">
      <Icon name="line-md:square-filled" width="24" height="24" />
    </button>
    <button id="tts-prev" class="tts-btn" aria-label="Předchozí věta">
      <Icon name="lucide:skip-back" width="24" height="24" />
    </button>
    <button id="tts-toggle" class="tts-btn" aria-label="Pozastavit/Hrát">
      <div class="icon-pause"><Icon name="line-md:pause" width="24" height="24" /></div>
      <div class="icon-resume"><Icon name="line-md:play-filled" width="24" height="24" /></div>
    </button>
    <button id="tts-next" class="tts-btn" aria-label="Další věta">
      <Icon name="lucide:skip-forward" width="24" height="24" />
    </button>
  </div>
</div>

<style lang="scss">
  @use "@/styles/mixins" as *;

  // Elegantní dvojitý gradient bez proužku a poskakování
  :global(.tts-sentence-highlight) {
    background: linear-gradient(
      90deg, 
      transparent 0%, 
      rgba(var(--accent-rgb, 59, 130, 246), 0.25) 10%, 
      transparent 100%
    ) !important;
    transition: background 0.4s ease-in-out;
    border-radius: 0px;
  }

  .tts-wrapper {
    display: flex; gap: 0.5rem; align-items: center;
    .tts-controls { display: none; gap: 0.25rem; align-items: center; }
    &.is-active { .main-play { display: none; } .tts-controls { display: flex; } }
    #tts-toggle { .icon-resume { display: none; } .icon-pause { display: flex; } }
    &.is-paused { #tts-toggle { .icon-pause { display: none; } .icon-resume { display: flex; } } }
    
    .tts-btn {
      @include icon-glass; background: transparent; border: none; cursor: pointer;
      display: inline-flex; align-items: center; justify-content: center;
      width: 22px; height: 22px; padding: 0; color: currentColor;
      div { display: flex; align-items: center; justify-content: center; }
    }
  }
</style>

<script>
interface ExtendedWindow extends Window { __ttsReaderInitialized?: boolean; }

(() => {
  const _window = window as unknown as ExtendedWindow;
  if (_window.__ttsReaderInitialized) return;
  _window.__ttsReaderInitialized = true;

  const container = document.getElementById("tts-container");
  const btnStart = document.getElementById("tts-start") as HTMLButtonElement;
  const btnToggle = document.getElementById("tts-toggle") as HTMLButtonElement;
  const btnStop = document.getElementById("tts-stop") as HTMLButtonElement;
  const btnNext = document.getElementById("tts-next") as HTMLButtonElement;
  const btnPrev = document.getElementById("tts-prev") as HTMLButtonElement;

  if (!container || !btnStart || !btnToggle || !btnStop || !btnNext || !btnPrev) return;

  const synth = window.speechSynthesis;
  interface SentenceItem { text: string; el: HTMLElement; }
  
  let sentences: SentenceItem[] = [];
  let currentIndex = 0;
  let isReading = false;

  function prepareQueue() {
    const main = document.querySelector("main");
    if (!main) return;
    const elements = Array.from(main.querySelectorAll('h1, h2, h3, h4, h5, h6, p, li')) as HTMLElement[];
    
    sentences = [];
    elements.forEach(el => {
      const text = el.innerText.trim();
      if (text.length < 2) return;
      
      const parts = text.match(/[^.?!]+[.?!]+|[^.?!]+$/g);
      if (parts) {
        parts.forEach(part => {
          if (part.trim().length > 1) {
            sentences.push({ text: part.trim(), el });
          }
        });
      }
    });
  }

  function updateVisuals() {
    // Najdeme všechny dříve zvýrazněné a vyčistíme je
    document.querySelectorAll('.tts-sentence-highlight').forEach(el => el.classList.remove('tts-sentence-highlight'));
    
    const current = sentences[currentIndex];
    if (current && isReading) {
      current.el.classList.add('tts-sentence-highlight');
      current.el.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  }

  function speak() {
    synth.cancel();
    if (!isReading || currentIndex >= sentences.length) {
      if (currentIndex >= sentences.length) stopTTS();
      return;
    }

    updateVisuals();

    const item = sentences[currentIndex];
    const utterance = new SpeechSynthesisUtterance(item.text);
    utterance.lang = document.documentElement.lang || "cs";
    
    utterance.onend = () => {
      if (isReading && !container?.classList.contains('is-paused')) {
        currentIndex++;
        speak();
      }
    };

    // Stabilita hlasů
    const voices = synth.getVoices();
    if (voices.length > 0) {
      utterance.voice = voices.find(v => v.lang.startsWith(utterance.lang)) || null;
    }

    synth.speak(utterance);
  }

  function stopTTS() {
    isReading = false;
    synth.cancel();
    document.querySelectorAll('.tts-sentence-highlight').forEach(el => el.classList.remove('tts-sentence-highlight'));
    currentIndex = 0;
    container?.classList.remove('is-active', 'is-paused');
  }

  btnStart.onclick = () => {
    prepareQueue();
    isReading = true;
    container?.classList.add('is-active');
    speak();
  };

  btnToggle.onclick = () => {
    if (!isReading) return;
    if (!container?.classList.contains('is-paused')) {
      container?.classList.add('is-paused');
      synth.cancel();
    } else {
      container?.classList.remove('is-paused');
      speak();
    }
  };

  btnStop.onclick = stopTTS;
  btnNext.onclick = () => { if (currentIndex < sentences.length - 1) { currentIndex++; speak(); } };
  btnPrev.onclick = () => { if (currentIndex > 0) { currentIndex--; speak(); } };

 // Reakce na kliknutí v textu (včetně pauzy)
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const textBlock = target.closest('h1, h2, h3, h4, h5, h6, p, li') as HTMLElement;
    
    // Pokud klikneme mimo text nebo na ovládací panel, ignorujeme
    if (!textBlock || !textBlock.closest('main') || target.closest('#tts-container')) return;

    if (sentences.length === 0) prepareQueue();
    const newIndex = sentences.findIndex(s => s.el === textBlock);

    if (newIndex !== -1) {
      // KLÍČOVÁ ZMĚNA: Pokud klikneme na právě čtený odstavec
      if (isReading && currentIndex >= 0 && sentences[currentIndex].el === textBlock) {
        // Simulujeme stisk tlačítka Pause/Resume
        btnToggle.click();
      } else {
        // Pokud klikneme na jiný odstavec, skočíme tam a začneme číst
        stopTTS();
        currentIndex = newIndex;
        isReading = true;
        container?.classList.add('is-active');
        speak();
      }
    }
  });
})();
</script>

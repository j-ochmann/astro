---

---

<button id="tts-toggle" type="button">
  🔊 Přečíst
</button>

<script>
declare global {
  interface Window {
    __ttsReaderInitialized?: boolean;
  }
}

(() => {
  if (window.__ttsReaderInitialized) return;
  window.__ttsReaderInitialized = true;

  const button = document.getElementById("tts-toggle");
  if (button) {
    const synth = window.speechSynthesis;
    // inicializace hlasů
    function initVoices(callback: () => void) {
      const voices = synth.getVoices();
      if (voices.length) {
        callback();
      } else {
        synth.onvoiceschanged = () => callback();
      }
    }

    initVoices(() => {
      console.log("[TTS] voices ready", synth.getVoices().map(v => v.name));
    });

    let isReading = false;
    let queue: string[] = [];
    let currentIndex = 0;

    // ---------------------------
    // Utils
    // ---------------------------

    function getMainText() {
      const main =
        document.querySelector("main") ||
        document.querySelector("article") ||
        document.body;

      return main?.innerText?.trim() ?? "";
    }

    function detectLang(text: string) {
      // hodně jednoduchá, ale funkční heuristika
      const czChars = /[ěščřžýáíéúůňóďť]/i;
      return czChars.test(text) ? "cs-CZ" : "en-US";
    }

    function getVoice(lang: string) {
      const voices = synth.getVoices();

      return (
        voices.find(v => v.lang === lang) ||
        voices.find(v => v.lang.startsWith(lang.split("-")[0]))
      );
    }

    function chunkText(text: string, size = 250) {
      const chunks = [];
      let start = 0;

      while (start < text.length) {
        let end = start + size;

        // snažíme se řezat na tečce
        const lastDot = text.lastIndexOf(".", end);
        if (lastDot > start + 50) end = lastDot + 1;

        chunks.push(text.slice(start, end).trim());
        start = end;
      }

      return chunks.filter(Boolean);
    }

    // ---------------------------
    // Speech
    // ---------------------------

    function speakNext() {
      if (!isReading || currentIndex >= queue.length) {
        console.log("[TTS] done");
        isReading = false;
        button!.textContent = "🔊 Přečíst";
        return;
      }

      const text = queue[currentIndex];
      const lang = detectLang(text);
      const voice = getVoice(lang);

      const utterance = new SpeechSynthesisUtterance(text);
      utterance.lang = lang;
      utterance.voice = voice ?? null;

      /*utterance.onstart = () =>
        console.log(`[TTS] start chunk ${currentIndex + 1}/${queue.length}`, lang);*/
      utterance.onstart = () => {
        console.log(
          `[TTS] start chunk ${currentIndex + 1}/${queue.length}`,
          "lang:", utterance.lang,
          "voice:", utterance.voice?.name
        );
      };

      utterance.onend = () => {
        currentIndex++;
        speakNext();
      };

      utterance.onerror = (e) => {
        console.error("[TTS] error", e);
        currentIndex++;
        speakNext();
      };

      synth.speak(utterance);
    }

    // ---------------------------
    // Button handler
    // ---------------------------

    button.addEventListener("click", () => {
      if (isReading) {
        synth.cancel();
        isReading = false;
        button!.textContent = "🔊 Přečíst stránku";
        console.log("[TTS] cancelled");
        return;
      }

      const text = getMainText();

      if (!text) {
        console.warn("[TTS] no text found");
        return;
      }

      queue = chunkText(text);
      currentIndex = 0;
      isReading = true;

      console.log("[TTS] chunks:", queue.length);
      button!.textContent = "⏹ Zastavit";
      speakNext();
    });
  }
})();
</script>

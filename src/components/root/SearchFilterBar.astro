---
// src/components/root/SearchFilterBar.astro
import { Icon } from '@astrojs/starlight/components';

interface FilterOption {
  label: string;
  value: string;
  count?: number;
}

interface Props {
  searchPlaceholder?: string;
  filterLabel?: string;
  filterOptions?: FilterOption[];
  viewLabel?: string;
  downloadLabel?: string;
}

const { 
  searchPlaceholder = "Search...", 
  filterLabel = "Asset Type",
  filterOptions = [],
  viewLabel = "View",
  downloadLabel = "Download"
} = Astro.props;

const totalTypesCount = filterOptions.length;
const totalItemsSum = filterOptions.reduce((acc, opt) => acc + (opt.count || 0), 0);
---

<div class="controls-row">
  <div class="search-container">
    <div class="search-icon-inside"><Icon name="magnifier" size="1.1rem" /></div>
    <input
      type="text"
      id="searchTab"
      class="glass-panel main-input"
      placeholder={searchPlaceholder}
      autocomplete="off"
    />
  </div>

  <div class="export-group">
    {/* Logika dropdown-wrapperu, který drží baseline */}
    <div class="dropdown-wrapper">
      {totalTypesCount > 0 && (
        <div class="dropdown">
          <button class="glass-btn glass-panel" id="catBtn">
            <i class="fa-solid fa-layer-group fa-fw"></i>
            <span class="btn-text">{filterLabel}</span>
            <span class="badge-count">{totalTypesCount}</span>
          </button>
          <div class="dropdown-content glass-panel" id="catMenu">
            <button class="cat-item menu-btn active" data-cat="">
              <span class="item-label">All Assets</span>
              <span class="badge-cat">{totalItemsSum}</span>
            </button>
            <div class="menu-divider"></div>
            {filterOptions.map(opt => (
              <button class="cat-item menu-btn" data-cat={opt.value}>
                <span class="item-label">{opt.label}</span>
                {opt.count !== undefined && <span class="badge-cat">{opt.count}</span>}
              </button>
            ))}
          </div>
        </div>
      )}
    </div>

    <div class="dropdown">
      <button class="glass-btn glass-panel" id="viewBtn">
        <i class="fa-solid fa-table-cells-large fa-fw"></i>
        <span class="btn-text">{viewLabel}</span>
      </button>
      <div class="dropdown-content glass-panel" id="viewMenu">
        <button class="view-item menu-btn active" data-view="table">
          <span class="view-inner">
            <i class="fa-solid fa-table fa-fw"></i>
            <span>Table</span>
          </span>
          <Icon name="right-arrow" size="0.8rem" class="active-indicator" />
        </button>
        <button class="view-item menu-btn" data-view="grid">
          <span class="view-inner">
            <i class="fa-solid fa-grip fa-fw"></i>
            <span>Grid</span>
          </span>
          <Icon name="right-arrow" size="0.8rem" class="active-indicator" />
        </button>
      </div>
    </div>

    <div class="dropdown">
      <button class="glass-btn glass-panel icon-only" id="dlBtn" title={downloadLabel}>
        <i class="fa-solid fa-download"></i>
      </button>
      <div class="dropdown-content glass-panel dl-menu" id="dlMenu">
        <button class="menu-btn" onclick="window.exportData('json')">
          <span class="view-inner">
            <i class="fa-solid fa-file-code fa-fw"></i>
            <span>JSON Export</span>
          </span>
          <span class="ext-tag">.json</span>
        </button>
        <button class="menu-btn" onclick="window.exportData('csv')">
          <span class="view-inner">
            <i class="fa-solid fa-file-csv fa-fw"></i>
            <span>CSV Export</span>
          </span>
          <span class="ext-tag">.csv</span>
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  /* FIX: Vynucené sjednocení všech kontejnerů na flex-center */
  .controls-row, 
  .search-container,
  .export-group, 
  .dropdown-wrapper,
  .dropdown {
    display: flex !important;
    align-items: center !important;
    height: 44px !important;
    box-sizing: border-box !important;
    margin: 0 !important;
  }

  .controls-row {
    width: 100%;
    gap: 0.75rem;
    margin-bottom: 1.5rem !important;
    position: relative;
  }

  .search-container {
    flex: 1;
    position: relative;
  }

  .export-group {
    gap: 0.5rem;
  }

  /* Font Awesome Global Fix */
  :global(.fa-solid), :global(.fas) {
    font-family: "Font Awesome 6 Free" !important;
    font-weight: 900 !important;
    display: inline-block !important;
  }

  /* Stylování panelů */
  .glass-panel.glass-panel {
    background: rgba(20, 20, 25, 0.5) !important;
    backdrop-filter: blur(20px) saturate(180%) !important;
    -webkit-backdrop-filter: blur(20px) saturate(180%) !important;
    border: 1px solid rgba(255, 255, 255, 0.12) !important;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4) !important;
    color: #ffffff !important;
    border-radius: 0.75rem !important;
  }

  /* Light mode korekce */
  :global([data-theme="light"]) .glass-panel.glass-panel {
    background: rgba(255, 255, 255, 0.4) !important;
    border: 1px solid rgba(0, 0, 0, 0.1) !important;
    box-shadow: 0 8px 32px rgba(31, 38, 135, 0.1) !important;
    color: var(--sl-color-gray-1) !important;
  }

  /* Main Input */
  .main-input.main-input {
    width: 100%;
    height: 44px !important;
    padding: 0 1rem 0 3.2rem !important;
    font-size: 0.9rem;
    outline: none !important;
  }

  .search-icon-inside {
    position: absolute;
    left: 1.2rem;
    z-index: 10;
    color: var(--sl-color-gray-3);
  }

  /* Tlačítka postavená na FLEX místo INLINE-FLEX */
  .glass-btn.glass-btn {
    height: 44px !important;
    padding: 0 1.1rem !important;
    cursor: pointer !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 0.7rem !important;
    font-size: 0.85rem !important;
    font-weight: 600 !important;
    line-height: 1 !important;
    white-space: nowrap;
    transition: all 0.3s ease !important;
  }

  .glass-btn i { color: #9d7cfd !important; }

  .icon-only {
    width: 44px !important;
    padding: 0 !important;
  }

  /* Ikony a Badge - sjednocení na flex */
  .glass-btn i, .glass-btn :global(svg) {
    display: flex !important;
    align-items: center;
    justify-content: center;
    width: 1rem;
  }

  .badge-count.badge-count {
    background: rgba(157, 124, 253, 0.25) !important;
    color: #9d7cfd !important;
    border: 1px solid rgba(157, 124, 253, 0.4) !important;
    min-width: 1.6rem;
    height: 1.3rem;
    border-radius: 0.4rem;
    font-size: 0.75rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: 0.2rem;
  }

  /* Dropdown Obsah */
  .dropdown { position: relative; }
  .dropdown-content.glass-panel {
    display: none;
    position: absolute;
    top: 54px;
    right: 0;
    min-width: 240px;
    z-index: 1000;
    padding: 0.6rem !important;
    flex-direction: column;
    gap: 4px;
  }
  .dropdown-content.show { display: flex; }

  .menu-btn.menu-btn {
    width: 100%;
    padding: 0.8rem 1rem;
    background: transparent !important;
    border: none !important;
    border-radius: 0.5rem;
    font-size: 0.85rem;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: rgba(255, 255, 255, 0.7) !important;
  }

  :global([data-theme="light"]) .menu-btn { color: var(--sl-color-gray-2) !important; }

  .menu-divider { height: 1px; background: rgba(255, 255, 255, 0.1); margin: 4px 8px; }
  .view-inner { display: flex; align-items: center; gap: 0.8rem; }
  .menu-btn.active { background: rgba(157, 124, 253, 0.15) !important; color: #9d7cfd !important; font-weight: 700; }
  
  .badge-cat {
    font-size: 0.7rem;
    background: rgba(157, 124, 253, 0.1) !important;
    color: #9d7cfd !important;
    padding: 1px 7px;
    border-radius: 4px;
    border: 1px solid rgba(157, 124, 253, 0.2) !important;
  }

  .active-indicator { opacity: 0; color: #9d7cfd; }
  .active .active-indicator { opacity: 1; }

  @media (max-width: 900px) { .btn-text { display: none; } }
</style>

---
import ThemeSelect from '@/components/starlight/ThemeSelect.astro';
import TTSReader from '@/components/root/TTSReader.astro';
import LanguageSelect from '@/components/starlight/LanguageSelect.astro';
import Search from '@/components/starlight/Search.astro';
---

<div class="toolbar">
  <div class="left-section">
    <ThemeSelect />
    <TTSReader />
  </div>
  <div class="right-section">
    <LanguageSelect />
    <Search />
    <div class="mobile-only">
      <button id="custom-mobile-menu-toggle" aria-expanded="false" aria-label="Menu" class="mobile-nav-toggle">
        <svg class="menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg class="close-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
</div>

<script>
  function init() {
    const btn = document.getElementById('custom-mobile-menu-toggle');
    if (!btn) return;
    btn.onclick = () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', (!isExpanded).toString());
      document.body.toggleAttribute('data-mobile-menu-expanded');
    };

    // Pojistka: Pokud někdo klikne na odkaz v menu, zavřeme ho a resetujeme ikonu
    const observer = new MutationObserver(() => {
      const isExpanded = document.body.hasAttribute('data-mobile-menu-expanded');
      btn.setAttribute('aria-expanded', isExpanded.toString());
    });
    observer.observe(document.body, { attributes: true, attributeFilter: ['data-mobile-menu-expanded'] });
  }
  init();
  document.addEventListener('astro:after-swap', init);
</script>

<style lang="scss">
  .toolbar {
    position: fixed !important; 
    top: 0 !important;
    left: 0 !important;
    height: 50px !important;
    z-index: 1000; /* Musí být nad sidebarem */
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 10px;
    backdrop-filter: blur(8px) saturate(180%);
    border-bottom: 1px solid color-mix(in srgb, var(--sl-color-hairline), transparent 80%);
    
    /* Desktop šířka */
    width: var(--sl-sidebar-width, 300px) !important;

    .left-section, .right-section { display: flex; align-items: center; gap: 8px; }
    .mobile-only { display: none; }

    /* Mobilní verze */
    @media (max-width: 50rem) {
      width: 100% !important;
      left: 0 !important;
      right: 0 !important;
      transform: translate(0) !important; /* Klíčové: neulétne se sidebarem */
      visibility: visible !important;

      .mobile-only { 
        display: flex; 
        margin-left: 8px; 
      }

      .mobile-nav-toggle {
        width: 38px; height: 38px; border-radius: 50%;
        border: 1px solid var(--sl-color-hairline);
        background: transparent;
        color: var(--sl-color-white);
        display: flex; align-items: center; justify-content: center;
        cursor: pointer;
        padding: 0;

        svg { width: 1.25rem; height: 1.25rem; display: block; }
        .close-icon { display: none; }
        
        &[aria-expanded="true"] {
          .menu-icon { display: none; }
          .close-icon { display: block; }
        }
      }
    }
  }

  /* Odsunutí obsahu na mobilu */
  @media (max-width: 50rem) {
    :global(.main-frame) {
      padding-top: 50px !important;
    }
  }

  /* Styl tlačítek témat a hledání (zachováno z tvé verze) */
  :global(.starlight-theme-select select),
  .right-section :global(sl-search button) {
    background: var(--sl-color-bg) !important;
    border: 1px solid var(--sl-color-hairline) !important;
    border-radius: 50% !important;
    width: 38px !important;
    height: 38px !important;
  }

</style>
---
// src/components/root/bar/PageBar.astro
import BasePageBar, { type Props as BaseProps } from './BasePageBar.astro';

interface Props extends BaseProps {
  accentColor?: string;
  allLabel?: string;
  mainIcon?: string;
}

const { accentColor, ...rest } = Astro.props;

// Příprava inline stylu pro barvy
const customStyle = accentColor ? `
  --filter-accent-color: ${accentColor}; 
  --filter-accent-bg: ${accentColor}22; 
  --filter-accent-border: ${accentColor}66;
` : `
  --filter-accent-color: var(--sl-color-accent-high);
  --filter-accent-bg: var(--sl-color-accent-low);
  --filter-accent-border: var(--sl-color-accent);
`;
---

<div class="page-bar-wrapper" style={customStyle}>
  <BasePageBar {...rest} />
</div>

<script>
  function initPageBarLogic() {
    const searchInput = document.getElementById('searchTab') as HTMLInputElement;
    const catMenu = document.getElementById('catMenu');
    const catBtn = document.getElementById('catBtn');
    const viewBtn = document.getElementById('viewBtn');
    const viewMenu = document.getElementById('viewMenu');
    const dlBtn = document.getElementById('dlBtn');
    const dlMenu = document.getElementById('dlMenu');

    // 1. Obsluha Dropdownů
    const toggleDropdown = (btn: HTMLElement | null, menu: HTMLElement | null) => {
      if (!btn || !menu) return;
      btn.onclick = (e) => {
        e.stopPropagation();
        const isOpen = menu.classList.contains('show');
        // Zavřít všechny ostatní
        document.querySelectorAll('.dropdown-content').forEach(m => m.classList.remove('show'));
        // Pokud nebyl otevřený, otevřít ho
        if (!isOpen) menu.classList.add('show');
      };
    };

    toggleDropdown(catBtn, catMenu);
    toggleDropdown(viewBtn, viewMenu);
    toggleDropdown(dlBtn, dlMenu);

    document.addEventListener('click', () => {
      document.querySelectorAll('.dropdown-content').forEach(m => m.classList.remove('show'));
    });

    // 2. Filtrování a Vyhledávání
    const runFilter = () => {
      const query = searchInput?.value.toLowerCase() || "";
      const activeCatBtn = catMenu?.querySelector('.cat-item.active') as HTMLElement;
      const category = activeCatBtn?.dataset.cat?.toLowerCase() || "";
      
      const rows = document.querySelectorAll('.table-row');
      let visibleIdx = 0;

      rows.forEach(row => {
        const htmlRow = row as HTMLElement;
        const rowData = JSON.parse(htmlRow.dataset.json || '{}');
        const rowCategory = htmlRow.dataset.category?.toLowerCase() || "";
        
        const contentString = Object.values(rowData).join(" ").toLowerCase();
        
        const matchSearch = contentString.includes(query);
        const matchCat = category === "" || rowCategory === category;

        if (matchSearch && matchCat) {
          htmlRow.style.display = ""; 
          visibleIdx++;
          const idxCell = htmlRow.querySelector('.index-cell');
          if (idxCell) idxCell.textContent = visibleIdx.toString();
        } else {
          htmlRow.style.display = "none";
        }
      });
    };

    searchInput?.addEventListener('input', runFilter);

    // 3. Klikání na kategorie
    catMenu?.querySelectorAll('.cat-item').forEach(btn => {
      btn.addEventListener('click', () => {
        catMenu.querySelectorAll('.cat-item').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        
        const label = btn.querySelector('.item-label')?.textContent;
        const btnText = catBtn?.querySelector('.btn-text');
        if (btnText && label) {
           btnText.textContent = label === 'All Items' ? 'Type' : label;
        }

        runFilter();
      });
    });
  }

  // Inicializace
  initPageBarLogic();
  document.addEventListener('astro:after-swap', initPageBarLogic);
</script>

<style is:global>
  /* Musí být global, aby to přebilo styl z BasePageBar */
  .dropdown-content.show { 
    display: flex !important; 
  }
</style>

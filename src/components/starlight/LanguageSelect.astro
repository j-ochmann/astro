---
import 'flag-icons/css/flag-icons.min.css';
import { locales, getFlagCode } from '@/content/config/i18n';
import config from 'virtual:starlight/user-config';

const currentLocale = Astro.currentLocale?.toString() || 'en';
const currentFlag = getFlagCode(currentLocale);

const getLanguageUrl = (targetLang: string) => {
  const pathParts = Astro.url.pathname.split('/').filter(Boolean);
  const langCodes = Object.keys(locales);
  if (pathParts.length > 0 && langCodes.includes(pathParts[0])) {
    pathParts.shift();
  }
  const slug = pathParts.join('/');
  const isRoot = config.locales?.root && config.locales.root.lang === targetLang;
  return isRoot ? (slug === '' ? '/' : `/${slug}`) : (slug === '' ? `/${targetLang}/` : `/${targetLang}/${slug}`);
};
---

{locales && Object.keys(locales).length > 1 && (
  <div class="language-picker-wrapper">
    <input type="checkbox" id="lang-toggle" class="lang-checkbox" />
    
    <label for="lang-toggle" class="language-button">
      <span class:list={['fi', `fi-${currentFlag}`, 'fib', 'current-fi']} aria-hidden="true"></span>
    </label>
    
    <label for="lang-toggle" class="glass-overlay"></label>

    <div class="language-dropdown">
      <div class="dropdown-content">
        {Object.entries(locales).map(([code, locale]) => {
          if (!locale) return null;
          const flagCode = getFlagCode(locale.lang);
          return (
            <a href={getLanguageUrl(code)} class:list={['lang-link', { active: code === currentLocale }]}>
              <span class={`fi fi-${flagCode}`} aria-hidden="true"></span>
              <span class="lang-label">{locale.label}</span>
            </a>
          );
        })}
      </div>
    </div>
  </div>
)}

<style lang="scss">
  /* 1. MANIPULACE S OKOLÍM (Vypnutí z-indexů a skla Toolbaru) */
  :global(body:has(.lang-checkbox:checked) .toolbar) {
    backdrop-filter: none !important;
    background: transparent !important;
    z-index: 10 !important; /* Shodíme celý toolbar dolů */
  }

  /* Shodíme i sekce uvnitř toolbarů, aby jejich stacking context nepřekážel */
  :global(body:has(.lang-checkbox:checked) .left-section),
  :global(body:has(.lang-checkbox:checked) .right-section) {
    z-index: 10 !important;
  }

  /* 2. ZÁMEK SCROLLU */
  :global(body:has(.lang-checkbox:checked)) {
    overflow: hidden !important;
    touch-action: none;
  }

  .language-picker-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    /* Při otevření wrapper vystřelí nahoru, aby přebil sourozence v sekci */
    z-index: 1000002 !important; 
  }

  .lang-checkbox {
    display: none !important;
  }

  /* 3. TLAČÍTKO (VLAJKA) */
  .language-button {
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    position: relative;
    z-index: 1000005 !important; /* Nejvyšší bod pro interakci */
    border: none !important;
    transition: transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);

    .current-fi {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      background-size: cover !important;
      background-position: center;
      display: block;
    }

    &:hover,
    .lang-checkbox:checked ~ & {
      transform: scale(1.3);
      animation: flag-pulse-glow 3s infinite ease-in-out;
    }
  }

  @keyframes flag-pulse-glow {
    0%, 100% { filter: drop-shadow(0 0 2px rgba(255,255,255,0.2)) brightness(1); }
    50% { filter: drop-shadow(0 0 15px currentColor) brightness(1.3); }
  }

  /* 4. SKLO (OVERLAY) */
  .glass-overlay {
    position: fixed !important;
    inset: 0 !important;
    width: 100vw !important;
    height: 100dvh !important;
    background: rgba(0, 0, 0, 0.6) !important;
    backdrop-filter: blur(8px) saturate(180%) !important;
    -webkit-backdrop-filter: blur(8px) saturate(180%) !important;
    z-index: 1000000 !important; /* Mezi Toolbarem a Dropdownem */
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s ease;
  }

  .lang-checkbox:checked ~ .glass-overlay {
    opacity: 1;
    visibility: visible;
  }

  /* 5. DROPDOWN (PRODLOUŽENÝ A ZAHUŠTĚNÝ) */
  .language-dropdown {
    position: absolute;
    top: calc(100% + 15px);
    right: 0;
    z-index: 1000004 !important;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-20px);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .lang-checkbox:checked ~ .language-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown-content {
    background: var(--sl-color-bg-sidebar) !important;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 1rem;
    padding: 0.25rem;
    min-width: 15rem;
    box-shadow: 0 25px 60px rgba(0,0,0,0.9);
    
    max-height: 85vh; /* Prodloužení na desktopu */
    overflow-y: auto;
    
    scrollbar-width: thin;
    scrollbar-color: var(--sl-color-gray-4) transparent;
  }

  /* 6. POLOŽKY (ZAHUŠTĚNO, HRANATÉ) */
  .lang-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.4rem 0.8rem; /* Maximální zahuštění */
    text-decoration: none;
    color: var(--sl-color-gray-2);
    border-radius: 0.4rem;
    font-size: 0.88rem;

    &:hover { 
      background: var(--sl-color-gray-6); 
      color: white;
    }
    
    &.active { 
      background: var(--sl-color-accent-low); 
      color: var(--sl-color-accent); 
    }

    .fi { 
      width: 1.4rem; 
      height: 0.95rem; 
      border-radius: 2px;
      object-fit: cover;
      flex-shrink: 0;
    }
  }

  /* 7. MOBILNÍ FIXY */
  @media (max-width: 50rem) {
    .language-dropdown {
      position: fixed !important;
      top: 60px !important;
      left: 10px !important;
      right: 10px !important;
      width: auto !important;
    }
    .dropdown-content {
      max-height: calc(100dvh - 80px) !important; /* Maximální délka na mobilu */
    }
  }
</style>

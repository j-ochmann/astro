---
import 'flag-icons/css/flag-icons.min.css';
import { locales, getFlagCode } from '@/content/config/i18n';
import config from 'virtual:starlight/user-config';

const currentLocale = Astro.currentLocale?.toString() || 'en';
const currentFlag = getFlagCode(currentLocale);

const getLanguageUrl = (targetLang: string) => {
  const pathParts = Astro.url.pathname.split('/').filter(Boolean);
  const langCodes = Object.keys(locales);
  if (pathParts.length > 0 && langCodes.includes(pathParts[0])) {
    pathParts.shift();
  }
  const slug = pathParts.join('/');
  const isRoot = config.locales?.root && config.locales.root.lang === targetLang;
  return isRoot ? (slug === '' ? '/' : `/${slug}`) : (slug === '' ? `/${targetLang}/` : `/${targetLang}/${slug}`);
};
---

{locales && Object.keys(locales).length > 1 && (
  <div class="language-picker-wrapper">
    <input type="checkbox" id="lang-toggle" class="lang-checkbox" />
    
    <label for="lang-toggle" class="language-button">
      <span class:list={['fi', `fi-${currentFlag}`, 'fib', 'current-fi']} aria-hidden="true"></span>
    </label>
    
    <label for="lang-toggle" class="glass-overlay"></label>

    <div class="language-dropdown">
      <div class="dropdown-content">
        {Object.entries(locales).map(([code, locale]) => {
          if (!locale) return null;
          const flagCode = getFlagCode(locale.lang);
          return (
            <a href={getLanguageUrl(code)} class:list={['lang-link', { active: code === currentLocale }]}>
              <span class={`fi fi-${flagCode}`} aria-hidden="true"></span>
              <span class="lang-label">{locale.label}</span>
            </a>
          );
        })}
      </div>
    </div>
  </div>
)}

<style lang="scss">
  /* A) ABSOLUTNÍ ZÁMEK SCROLLU */
  :global(body:has(.lang-checkbox:checked)) {
    overflow: hidden !important;
    position: fixed; /* Totální zastavení scrollu na všech OS */
    width: 100%;
    height: 100%;
  }

  .language-picker-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .lang-checkbox {
    display: none !important;
  }

  /* C) IKONA - Barevná pulzace */
  .language-button {
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    z-index: 10005; /* Tlačítko musí být nad sklem pro zavření */
    position: relative;
    border: none !important; 
    background: transparent !important;
    transition: transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
    
    .current-fi {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      background-size: cover !important;
      background-position: center;
      filter: drop-shadow(0 2px 4px rgba(0,0,0,0.3));
    }

    &:hover,
    .lang-checkbox:checked ~ & {
      transform: scale(1.3);
      animation: flag-pulse-glow 3s infinite ease-in-out;
    }
  }

  @keyframes flag-pulse-glow {
    0%, 100% { filter: drop-shadow(0 0 2px rgba(255,255,255,0.2)) brightness(1); }
    50% { filter: drop-shadow(0 0 15px currentColor) brightness(1.3); }
  }

  /* B) SKLO - Výraznější a přes celé */
  .glass-overlay {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    /* Shodné s tvým Toolbarem + tmavší podklad pro kontrast */
    background: color-mix(in srgb, var(--sl-color-bg), transparent 30%);
    backdrop-filter: blur(12px) saturate(180%);
    -webkit-backdrop-filter: blur(12px) saturate(180%);
    z-index: 9990; /* Pod dropdownem i tlačítkem */
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
  }

  .lang-checkbox:checked ~ .glass-overlay {
    opacity: 1;
    visibility: visible;
  }

  /* D) DROPDOWN - Maximální délka */
  .language-dropdown {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    z-index: 10000; /* Nad sklem */
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: all 0.2s ease;
  }

  .lang-checkbox:checked ~ .language-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown-content {
    background: var(--sl-color-bg-sidebar);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.75rem;
    padding: 0.25rem; /* Zahustění */
    min-width: 14rem;
    box-shadow: var(--sl-shadow-xl);
    
    /* Prodloužení téměř do konce displaye */
    max-height: 85vh; 
    overflow-y: auto;
    
    /* Vlastní scrollbar pro přehlednost */
    scrollbar-width: thin;
    scrollbar-color: var(--sl-color-gray-4) transparent;
  }

  /* E) POLOŽKY - Zahustění a hranaté vlajky */
  .lang-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.75rem; /* Užší padding pro zahuštění */
    text-decoration: none;
    color: var(--sl-color-gray-2);
    border-radius: 0.4rem;
    font-size: 0.95rem;

    &:hover { background: var(--sl-color-gray-6); color: white; }
    &.active { background: var(--sl-color-accent-low); color: var(--sl-color-accent); }

    .fi { 
      width: 1.4rem; 
      height: 1rem; 
      border-radius: 2px; /* Skoro hranaté, jen jemný detail */
      flex-shrink: 0;
      border: none !important;
    }
  }

  /* F) MOBILNÍ FIXY - Odpoutání ze stacking kontextu */
  @media (max-width: 50rem) {
    .language-dropdown {
      position: fixed !important;
      top: 60px !important;
      left: 10px !important;
      right: 10px !important;
      width: auto !important;
      margin: 0 auto;
    }
    .dropdown-content {
      max-height: calc(100dvh - 80px) !important; /* Maximální využití výšky */
      width: 100%;
    }
  }
</style>

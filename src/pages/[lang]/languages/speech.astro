---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getI18nPaths, getUsedLanguagesData, getUnusedLanguagesData } from '@/content/config/i18n';

export async function getStaticPaths() {
  return getI18nPaths();
}

const { lang } = Astro.params;

// Získáme všechna data o jazycích, která máme k dispozici
const usedLangs = getUsedLanguagesData();
const unusedLangs = getUnusedLanguagesData();
const allLangs = [...usedLangs, ...unusedLangs].sort((a, b) => a.nameEn.localeCompare(b.nameEn));
---

<StarlightPage frontmatter={{ title: 'TTS Voice Debugger', template: 'doc' }}>
  <p>Tato stránka testuje dostupnost hlasů ve vašem prohlížeči pro všechny definované jazyky.</p>
  
  <div class="voice-summary" id="voice-summary">
    Načítám systémové hlasy...
  </div>

  <table class="tts-debug-table">
    <thead>
      <tr>
        <th>Kód</th>
        <th>Název (EN)</th>
        <th>Nativně</th>
        <th>Dostupný hlas</th>
        <th>Akce</th>
      </tr>
    </thead>
    <tbody>
      {allLangs.map(l => (
        <tr data-lang-code={l.code.toLowerCase()}>
          <td class="mono">{l.code}</td>
          <td>{l.nameEn}</td>
          <td class="native-cell">{l.nameNative}</td>
          <td class="voice-info">---</td>
          <td>
            <button class="test-btn" data-code={l.code} data-text={l.nameNative}>
              Přehrát
            </button>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</StarlightPage>

<style>
  .tts-debug-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 2rem;
  }
  th, td {
    padding: 0.75rem;
    border-bottom: 1px solid var(--sl-color-hairline);
    text-align: left;
  }
  .mono { font-family: var(--sl-font-mono); font-weight: bold; color: var(--sl-color-accent); }
  .native-cell { font-style: italic; }
  .voice-info { font-size: 0.8rem; color: var(--sl-color-gray-3); }
  
  .voice-summary {
    padding: 1rem;
    background: var(--sl-color-gray-6);
    border-left: 4px solid var(--sl-color-accent);
    margin: 1rem 0;
  }

  .test-btn {
    background: var(--sl-color-accent);
    color: white;
    border: none;
    padding: 0.4rem 0.8rem;
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.8rem;
  }
  .test-btn:disabled {
    background: var(--sl-color-gray-5);
    opacity: 0.5;
    cursor: not-allowed;
  }
  .has-voice { color: #4ade80 !important; font-weight: bold; }
  .no-voice { color: #f87171 !important; }
</style>

<script>
  const synth = window.speechSynthesis;

  function updateTable() {
    const voices = synth.getVoices();
    const summaryEl = document.getElementById('voice-summary');
    const rows = document.querySelectorAll('tr[data-lang-code]');

    if (summaryEl) {
      summaryEl.innerHTML = `Nalezeno celkem <strong>${voices.length}</strong> systémových hlasů.`;
    }

    if (voices.length === 0) return; // Ještě nemáme hlasy, počkáme na další event

    rows.forEach(row => {
      const code = row.getAttribute('data-lang-code');
      const infoCell = row.querySelector('.voice-info');
      const btn = row.querySelector('.test-btn') as HTMLButtonElement;
      
      // Vyčištění kódu pro porovnání (např. cs-CZ -> cs)
      const cleanCode = code?.toLowerCase().split('-')[0];

      const matchingVoices = voices.filter(v => {
        const vLang = v.lang.toLowerCase().replace('_', '-');
        return vLang === code || vLang.startsWith(cleanCode + '-');
      });

      if (matchingVoices.length > 0) {
        if (infoCell) {
          infoCell.innerHTML = `<span style="color: #4ade80; font-weight: bold;">ANO (${matchingVoices.length})</span><br><small>${matchingVoices[0].name}</small>`;
        }
        if (btn) {
          btn.disabled = false; // AKTIVACE TLAČÍTKA
          btn.style.opacity = "1";
          btn.style.cursor = "pointer";
        }
      } else {
        if (infoCell) infoCell.innerHTML = `<span style="color: #f87171;">NE</span>`;
        if (btn) btn.disabled = true;
      }
    });
  }

  // 1. Zkusíme hned
  updateTable();

  // 2. Chrome/Android vyžaduje tento event, hlasy se načítají asynchronně
  if (typeof speechSynthesis !== 'undefined' && speechSynthesis.onvoiceschanged !== undefined) {
    speechSynthesis.onvoiceschanged = updateTable;
  }

  // 3. Brutální fallback pro jistotu (některé prohlížeče event neposílají správně)
  setTimeout(updateTable, 500);
  setTimeout(updateTable, 2000);

  // Obsluha kliknutí (delegace)
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.test-btn') as HTMLButtonElement;
    if (!btn || btn.disabled) return;

    const text = btn.getAttribute('data-text') || '';
    const code = btn.getAttribute('data-code')?.toLowerCase() || 'en';
    
    synth.cancel(); 

    const utterance = new SpeechSynthesisUtterance(text);
    utterance.lang = code;
    
    const voices = synth.getVoices();
    // Najdeme hlas pro daný kód
    const voice = voices.find(v => v.lang.toLowerCase().replace('_', '-').startsWith(code.split('-')[0]));
    
    if (voice) {
      utterance.voice = voice;
    }

    // Pro jistotu nastavíme i parametry, které občas pomůžou na Linuxu
    utterance.rate = 1;
    utterance.pitch = 1;
    utterance.volume = 1;

    synth.speak(utterance);
  });
</script>

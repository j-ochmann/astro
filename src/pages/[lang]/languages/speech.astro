---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Icon } from 'astro-icon/components';
import { 
  getI18nPaths, 
  getUsedLanguagesData, 
  getUnusedLanguagesData 
} from '@/content/config/i18n';

export async function getStaticPaths() {
  return getI18nPaths();
}

const { lang } = Astro.params;

const usedLangs = getUsedLanguagesData();
const unusedLangs = getUnusedLanguagesData();
const allLangs = ([...usedLangs, ...unusedLangs] as any[]).map(l => ({
  code: l.code,
  nameEn: l.nameEn,
  nameNative: l.nameNative,
  usageCount: l.usageCount || 0,
  isoLength: l.code.length
})).sort((a, b) => b.usageCount - a.usageCount);
---

<StarlightPage frontmatter={{ title: 'TTS Diagnostics Pro', template: 'doc' }}>
  
  <section class="debug-section">
    <h2>1. Systémové hlasy (Prohlížeč)</h2>
    <p>Toto jsou hlasy, které váš systém aktuálně reportuje jako dostupné.</p>
    <div class="table-wrapper">
      <table id="systemVoicesTable">
        <thead>
          <tr>
            <th>Jazyk (Lang)</th>
            <th>Název hlasu (Name)</th>
            <th>Local Service</th>
          </tr>
        </thead>
        <tbody id="systemVoicesBody">
          <tr><td colspan="3">Načítám hlasy ze systému...</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="debug-section">
    <h2>2. Testování vašich jazyků</h2>
    
    <div class="controls-grid">
      <div class="search-box">
        <input type="text" id="langSearch" placeholder="Hledat jazyk..." />
      </div>
      <div class="filter-group">
        <label><input type="checkbox" id="filterISO2" checked /> ISO 639-1 (2 chars)</label>
        <label><input type="checkbox" id="filterISO3" checked /> ISO 639-3 (3 chars)</label>
      </div>
    </div>

    <div class="table-wrapper">
      <table id="myLangsTable">
        <thead>
          <tr>
            <th data-sort="code">ISO <Icon name="lucide:arrow-up-down" /></th>
            <th data-sort="nameEn">Název <Icon name="lucide:arrow-up-down" /></th>
            <th data-sort="usageCount">Země <Icon name="lucide:arrow-up-down" /></th>
            <th>Status</th>
            <th>Test</th>
          </tr>
        </thead>
        <tbody id="myLangsBody">
          {allLangs.map(l => (
            <tr data-item={JSON.stringify(l)} data-iso={l.isoLength}>
              <td class="mono">{l.code}</td>
              <td>
                <strong>{l.nameEn}</strong><br/>
                <small>{l.nameNative}</small>
              </td>
              <td>{l.usageCount}</td>
              <td class="status-cell">---</td>
              <td>
                <button class="play-btn" data-code={l.code} data-text={l.nameNative} disabled>
                  <Icon name="line-md:play-filled" />
                </button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</StarlightPage>

<style is:global>
  .debug-section { margin-bottom: 3rem; }
  .debug-section h2 { margin-bottom: 1rem; border-bottom: 1px solid var(--sl-color-hairline); padding-bottom: 0.5rem; }

  .controls-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    background: var(--sl-color-gray-6);
    padding: 1rem;
    margin-bottom: 1rem;
    border-radius: 4px;
    align-items: center;
  }

  .search-box input {
    background: var(--sl-color-bg);
    color: white;
    border: 1px solid var(--sl-color-gray-4);
    padding: 0.4rem 0.8rem;
    border-radius: 4px;
    min-width: 200px;
  }

  .filter-group { display: flex; gap: 1rem; font-size: 0.9rem; }
  .filter-group label { display: flex; align-items: center; gap: 0.4rem; cursor: pointer; }

  .table-wrapper { 
    overflow-x: auto; 
    border: 1px solid var(--sl-color-hairline);
    background: var(--sl-color-bg);
  }

  table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
  th, td { padding: 0.6rem 0.8rem; border-bottom: 1px solid var(--sl-color-hairline); text-align: left; }
  th { background: var(--sl-color-gray-6); cursor: pointer; white-space: nowrap; }
  
  .mono { font-family: var(--sl-font-mono); color: var(--sl-color-accent-high); font-weight: bold; }
  .status-cell { font-weight: bold; }
  .status-ok { color: #4ade80; }
  .status-err { color: #f87171; }

  .play-btn {
    background: var(--sl-color-accent);
    color: white; border: none; border-radius: 50%;
    width: 30px; height: 30px; display: flex; align-items: center; justify-content: center;
    cursor: pointer; opacity: 0.2; transition: 0.2s;
  }
  .play-btn:not(:disabled) { opacity: 1; }
  .play-btn:not(:disabled):hover { transform: scale(1.1); }

  th svg { width: 12px; height: 12px; opacity: 0.5; vertical-align: middle; }
</style>

<script>
  const synth = window.speechSynthesis;
  
  function updateAll() {
    const voices = synth.getVoices();
    
    // 1. Aktualizace systémové tabulky
    const sysBody = document.getElementById('systemVoicesBody');
    if (sysBody && voices.length > 0) {
      sysBody.innerHTML = voices.map(v => `
        <tr>
          <td><code class="mono">${v.lang}</code></td>
          <td>${v.name}</td>
          <td>${v.localService ? '✅' : '🌐'}</td>
        </tr>
      `).join('');
    }

    // 2. Propojení s vašimi jazyky
    const rows = Array.from(document.querySelectorAll('#myLangsBody tr'));
    rows.forEach(row => {
      const data = JSON.parse(row.getAttribute('data-item') || '{}');
      const statusCell = row.querySelector('.status-cell');
      const btn = row.querySelector('.play-btn') as HTMLButtonElement;
      
      const cleanCode = data.code.toLowerCase().split('-')[0];
      const match = voices.find(v => {
        const vLang = v.lang.toLowerCase().replace('_', '-');
        return vLang === data.code.toLowerCase() || vLang.startsWith(cleanCode + '-');
      });

      if (match) {
        if (statusCell) statusCell.innerHTML = `<span class="status-ok">OK</span>`;
        if (btn) btn.disabled = false;
      } else {
        if (statusCell) statusCell.innerHTML = `<span class="status-err">NE</span>`;
        if (btn) btn.disabled = true;
      }
    });

    applyFilters();
  }

  function applyFilters() {
    const term = (document.getElementById('langSearch') as HTMLInputElement)?.value.toLowerCase();
    const showISO2 = (document.getElementById('filterISO2') as HTMLInputElement)?.checked;
    const showISO3 = (document.getElementById('filterISO3') as HTMLInputElement)?.checked;
    const rows = document.querySelectorAll('#myLangsBody tr');

    rows.forEach(row => {
      const r = row as HTMLElement;
      const isoLen = parseInt(r.getAttribute('data-iso') || '0');
      const text = r.innerText.toLowerCase();
      
      const matchesSearch = text.includes(term);
      const matchesISO = (isoLen === 2 && showISO2) || (isoLen === 3 && showISO3);
      
      r.style.display = (matchesSearch && matchesISO) ? '' : 'none';
    });
  }

  // Event Listeners pro filtry
  document.getElementById('langSearch')?.addEventListener('input', applyFilters);
  document.getElementById('filterISO2')?.addEventListener('change', applyFilters);
  document.getElementById('filterISO3')?.addEventListener('change', applyFilters);

  // Řazení tabulky
  document.querySelectorAll('#myLangsTable th[data-sort]').forEach(th => {
    th.addEventListener('click', () => {
      const col = th.getAttribute('data-sort');
      const body = document.getElementById('myLangsBody');
      const rows = Array.from(body?.querySelectorAll('tr') || []);
      const isAsc = th.classList.contains('asc');

      const sorted = rows.sort((a, b) => {
        const valA = JSON.parse(a.getAttribute('data-item') || '{}')[col!];
        const valB = JSON.parse(b.getAttribute('data-item') || '{}')[col!];
        return isAsc 
          ? (typeof valA === 'number' ? valB - valA : String(valB).localeCompare(String(valA)))
          : (typeof valA === 'number' ? valA - valB : String(valA).localeCompare(String(valB)));
      });

      th.classList.toggle('asc', !isAsc);
      body?.append(...sorted);
    });
  });

  // TTS Playback
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.play-btn') as HTMLButtonElement;
    if (!btn || btn.disabled) return;

    const text = btn.getAttribute('data-text') || '';
    const code = btn.getAttribute('data-code') || 'en';
    
    synth.cancel();
    const utterance = new SpeechSynthesisUtterance(text);
    utterance.lang = code;
    
    const voices = synth.getVoices();
    const voice = voices.find(v => v.lang.toLowerCase().replace('_', '-').startsWith(code.toLowerCase().split('-')[0]));
    if (voice) utterance.voice = voice;
    
    synth.speak(utterance);
  });

  // Init
  if (typeof speechSynthesis !== 'undefined') {
    speechSynthesis.onvoiceschanged = updateAll;
    updateAll();
    setTimeout(updateAll, 1000);
  }
</script>

---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Icon } from 'astro-icon/components';
import { 
  getI18nPaths, 
  useTranslations,
  getUsedLanguagesData,
  getUnusedLanguagesData
} from '@/content/config/i18n';

export async function getStaticPaths() {
  return getI18nPaths();
}

const { lang } = Astro.params;
const t = useTranslations(lang);

const usedLangs = getUsedLanguagesData();
const unusedLangs = getUnusedLanguagesData();

// Sjednocení dat pro testování
const allLangs = ([...usedLangs, ...unusedLangs] as any[]).map(l => ({
  code: l.code,
  nameEn: l.nameEn,
  nameNative: l.nameNative,
  usageCount: l.usageCount || 0
})).sort((a, b) => b.usageCount - a.usageCount);

const labels = {
  title: lang === 'cs' ? 'Diagnostika hlasů TTS' : 'TTS Voice Diagnostics',
  description: lang === 'cs' ? 'Test dostupnosti systémových hlasů pro atlas.' : 'System voice availability test.',
  systemVoices: lang === 'cs' ? 'Hlasy nalezené v systému:' : 'Voices found in system:',
  tableCode: 'ISO',
  tableName: lang === 'cs' ? 'Jazyk' : 'Language',
  tableVoice: lang === 'cs' ? 'Dostupný hlas' : 'Available Voice',
  tableAction: lang === 'cs' ? 'Test' : 'Test'
};
---

<StarlightPage frontmatter={{ title: labels.title, template: 'doc' }}>
  
  <div class="voice-debug-header">
    <p>{labels.description}</p>
    <div id="voice-summary" class="summary-box">
      <div class="spinner"></div> Načítám systémové hlasy...
    </div>
  </div>

  <div class="table-wrapper">
    <table id="ttsTestTable">
      <thead>
        <tr>
          <th>{labels.tableCode}</th>
          <th>{labels.tableName}</th>
          <th>{labels.tableVoice}</th>
          <th>{labels.tableAction}</th>
        </tr>
      </thead>
      <tbody id="tableBody">
        {allLangs.map(l => (
          <tr data-lang-code={l.code.toLowerCase()}>
            <td class="mono">{l.code}</td>
            <td>
              <span class="en-name">{l.nameEn}</span><br/>
              <small class="native-name">{l.nameNative}</small>
            </td>
            <td class="voice-info">---</td>
            <td>
              <button 
                class="test-btn" 
                data-code={l.code} 
                data-text={l.nameNative}
                disabled
              >
                <Icon name="line-md:play-filled" />
              </button>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</StarlightPage>

<style is:global>
  .voice-debug-header {
    margin-bottom: 2rem;
  }

  .summary-box {
    padding: 1.25rem;
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-hairline);
    border-left: 4px solid var(--sl-color-accent);
    border-radius: 4px;
  }

  .debug-voice-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
    max-height: 150px;
    overflow-y: auto;
    font-size: 0.75rem;
  }

  .debug-voice-list span {
    background: var(--sl-color-bg);
    padding: 2px 8px;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 12px;
    white-space: nowrap;
  }

  .debug-voice-list code {
    color: var(--sl-color-accent-high);
  }

  .table-wrapper {
    overflow-x: auto;
    border: 1px solid var(--sl-color-hairline);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  th, td {
    padding: 0.85rem 0.75rem;
    border-bottom: 1px solid var(--sl-color-hairline);
    text-align: left;
  }

  th { background: var(--sl-color-gray-6); }

  .mono { font-family: var(--sl-font-mono); font-weight: bold; }
  .native-name { opacity: 0.6; font-style: italic; }
  
  .test-btn {
    appearance: none;
    background: var(--sl-color-accent);
    color: white;
    border: none;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    cursor: pointer;
    opacity: 0.3;
    transition: all 0.2s ease;
  }

  .test-btn:not(:disabled) {
    opacity: 1;
  }

  .test-btn:not(:disabled):hover {
    transform: scale(1.1);
    background: var(--sl-color-accent-high);
  }

  .has-voice { color: #4ade80; font-weight: bold; }
  .no-voice { color: #f87171; }

  .spinner {
    display: inline-block;
    width: 1rem;
    height: 1rem;
    border: 2px solid var(--sl-color-gray-4);
    border-top-color: var(--sl-color-accent);
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin-right: 0.5rem;
  }

  @keyframes spin { to { transform: rotate(360deg); } }
</style>

<script>
  const synth = window.speechSynthesis;

  function updateUI() {
    const voices = synth.getVoices();
    const summaryEl = document.getElementById('voice-summary');
    const rows = document.querySelectorAll('tr[data-lang-code]');

    if (!summaryEl) return;

    if (voices.length === 0) {
      summaryEl.innerHTML = `<div class="spinner"></div> Čekám na systémové hlasy (pokus č. ${Math.round(performance.now()/1000)}s)...`;
      return;
    }

    // 1. Vykreslení seznamu všech hlasů pro vizuální kontrolu
    let listHtml = `<p>Nalezeno celkem <strong>${voices.length}</strong> hlasů:</p>`;
    listHtml += `<div class="debug-voice-list">`;
    voices.forEach(v => {
      listHtml += `<span><code>${v.lang}</code> ${v.name}</span>`;
    });
    listHtml += `</div>`;
    summaryEl.innerHTML = listHtml;

    // 2. Propojení s tabulkou
    rows.forEach(row => {
      const code = row.getAttribute('data-lang-code');
      const infoCell = row.querySelector('.voice-info');
      const btn = row.querySelector('.test-btn') as HTMLButtonElement;
      
      if (!code) return;

      // Hledáme shodu (např. 'cs' odpovídá 'cs-CZ')
      const cleanCode = code.split('-')[0];
      const match = voices.find(v => {
        const vLang = v.lang.toLowerCase().replace('_', '-');
        return vLang === code || vLang.startsWith(cleanCode + '-');
      });

      if (match && infoCell && btn) {
        infoCell.innerHTML = `<span class="has-voice">ANO</span><br/><small>${match.name}</small>`;
        btn.disabled = false;
      } else if (infoCell && btn) {
        infoCell.innerHTML = `<span class="no-voice">NE</span>`;
        btn.disabled = true;
      }
    });
  }

  // Inicializace
  if (typeof speechSynthesis !== 'undefined') {
    // Pro Chrome/Android
    speechSynthesis.onvoiceschanged = updateUI;
    // Pro Safari/Firefox/Debian
    updateUI();
    
    // Pojistky pro asynchronní načítání
    setTimeout(updateUI, 500);
    setTimeout(updateUI, 2000);
    setTimeout(updateUI, 5000);
  }

  // Klikací logika
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.test-btn') as HTMLButtonElement;
    if (!btn || btn.disabled) return;

    const text = btn.getAttribute('data-text') || '';
    const code = btn.getAttribute('data-code')?.toLowerCase() || 'en';
    
    synth.cancel();

    const utterance = new SpeechSynthesisUtterance(text);
    utterance.lang = code;

    // Výběr nejlepšího hlasu pro konkrétní test
    const voices = synth.getVoices();
    const cleanCode = code.split('-')[0];
    const voice = voices.find(v => {
      const vLang = v.lang.toLowerCase().replace('_', '-');
      return vLang === code || vLang.startsWith(cleanCode + '-');
    });

    if (voice) utterance.voice = voice;

    // Logování pro ladění v konzoli (F12)
    console.log(`TTS Test: [${code}] "${text}" pomocí [${voice?.name || 'default'}]`);
    
    synth.speak(utterance);
  });
</script>

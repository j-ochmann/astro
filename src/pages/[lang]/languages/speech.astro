---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Icon } from 'astro-icon/components';
import { 
  getI18nPaths, 
  getUsedLanguagesData, 
  getUnusedLanguagesData 
} from '@/content/config/i18n';

export async function getStaticPaths() {
  return getI18nPaths();
}

const { lang } = Astro.params;

const usedLangs = getUsedLanguagesData();
const unusedLangs = getUnusedLanguagesData();
const allLangs = ([...usedLangs, ...unusedLangs] as any[]).map(l => ({
  code: l.code,
  nameEn: l.nameEn,
  nameNative: l.nameNative,
  usageCount: l.usageCount || 0,
  isoLength: l.code.length
})).sort((a, b) => b.usageCount - a.usageCount);

// Definice čistého SVG, aby se ikony neztrácely při JS manipulaci
const playIconHtml = `<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>`;
---

<StarlightPage frontmatter={{ title: 'TTS Diagnostics Pro', template: 'doc' }}>
  
  <section class="debug-section">
    <div class="section-header">
      <h2>1. Systémové hlasy (Engine)</h2>
      <button id="playAllVoices" class="action-btn">
        <Icon name="line-md:play-filled" /> Play All (Slow Loop)
      </button>
    </div>
    <div class="table-wrapper">
      <table id="systemVoicesTable">
        <thead>
          <tr>
            <th>#</th>
            <th>Kód</th>
            <th>Nativní jazyk</th>
            <th>Název (Systém)</th>
            <th>Místní</th>
            <th>Akce</th>
          </tr>
        </thead>
        <tbody id="systemVoicesBody">
          <tr><td colspan="6">Načítám hlasy ze systému...</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="debug-section">
    <h2>2. Testování vašich jazyků</h2>
    
    <div class="controls-grid">
      <div class="search-box">
        <input type="text" id="langSearch" placeholder="Hledat jazyk..." aria-label="Hledat jazyk" />
      </div>
      
      <div class="filters-container">
        <div class="filter-group">
          <span class="filter-label">ISO:</span>
          <label><input type="checkbox" id="filterISO2" checked /> 639-1</label>
          <label><input type="checkbox" id="filterISO3" checked /> 639-3</label>
        </div>
        
        <div class="filter-group">
          <span class="filter-label">Status:</span>
          <label><input type="checkbox" id="filterOK" checked /> <span class="status-ok">OK</span></label>
          <label><input type="checkbox" id="filterNE" checked /> <span class="status-err">NE</span></label>
        </div>
      </div>
    </div>

    <div class="table-wrapper">
      <table id="myLangsTable">
        <thead>
          <tr>
            <th>#</th>
            <th data-sort="code" class="sortable">ISO <Icon name="lucide:arrow-up-down" /></th>
            <th data-sort="nameEn" class="sortable">Název <Icon name="lucide:arrow-up-down" /></th>
            <th data-sort="usageCount" class="sortable">Země <Icon name="lucide:arrow-up-down" /></th>
            <th>Status</th>
            <th>Test</th>
          </tr>
        </thead>
        <tbody id="myLangsBody">
          {allLangs.map(l => (
            <tr data-item={JSON.stringify(l)} data-iso={l.isoLength}>
              <td class="row-index"></td>
              <td class="mono">{l.code}</td>
              <td>
                <strong>{l.nameEn}</strong><br/>
                <small>{l.nameNative}</small>
              </td>
              <td>{l.usageCount}</td>
              <td class="status-cell">---</td>
              <td>
                <button class="play-btn" data-code={l.code} data-text={l.nameNative} disabled>
                  <Fragment set:html={playIconHtml} />
                </button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</StarlightPage>

<style is:global>
  .debug-section { margin-bottom: 3rem; }
  .section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 1rem; }
  .action-btn { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.5rem 1rem; background: var(--sl-color-accent-low); color: var(--sl-color-text-accent); border: 1px solid var(--sl-color-accent); border-radius: 4px; cursor: pointer; font-weight: bold; }
  .controls-grid { display: flex; flex-wrap: wrap; gap: 1.5rem; background: var(--sl-color-gray-6); padding: 1rem; margin-bottom: 1rem; border-radius: 4px; align-items: center; border: 1px solid var(--sl-color-hairline); }
  .search-box input { background: var(--sl-color-bg); color: var(--sl-color-text); border: 1px solid var(--sl-color-gray-4); padding: 0.5rem 0.8rem; border-radius: 4px; width: 100%; min-width: 200px; }
  .filters-container { display: flex; flex-wrap: wrap; gap: 1.5rem; align-items: center; }
  .filter-group { display: flex; gap: 0.8rem; font-size: 0.9rem; align-items: center; white-space: nowrap; }
  @media (min-width: 50rem) { .filter-group + .filter-group { border-left: 1px solid var(--sl-color-gray-4); padding-left: 1.5rem; } }
  .filter-label { font-weight: bold; font-size: 0.75rem; text-transform: uppercase; color: var(--sl-color-gray-3); }
  .filter-group label { display: flex; align-items: center; gap: 0.4rem; cursor: pointer; color: var(--sl-color-text); }
  .table-wrapper { overflow-x: auto; border: 1px solid var(--sl-color-hairline); background: var(--sl-color-bg); }
  table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
  th, td { padding: 0.7rem 0.8rem; border-bottom: 1px solid var(--sl-color-hairline); text-align: left; color: var(--sl-color-text); }
  th { background: var(--sl-color-gray-6); white-space: nowrap; }
  th.sortable { cursor: pointer; }
  .row-index { font-size: 0.7rem; color: var(--sl-color-gray-3); font-family: var(--sl-font-mono); }
  .mono { font-family: var(--sl-font-mono); color: var(--sl-color-text-accent); font-weight: bold; }
  .status-ok { color: #22c55e; font-weight: bold; }
  :root[data-theme='dark'] .status-ok { color: #4ade80; }
  .status-err { color: #ef4444; font-weight: bold; }
  :root[data-theme='dark'] .status-err { color: #f87171; }
  .play-btn, .sys-play-btn { background: var(--sl-color-accent); color: white; border: none; border-radius: 50%; width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; cursor: pointer; opacity: 0.2; transition: 0.2s; }
  .play-btn:not(:disabled), .sys-play-btn { opacity: 1; }
  .play-btn:not(:disabled):hover, .sys-play-btn:hover { transform: scale(1.1); background: var(--sl-color-accent-high); color: white; }
</style>

<script is:inline define:vars={{ playIconHtml }}>
  const synth = window.speechSynthesis;
  let isLooping = false;
  let cachedVoices = [];

  // Funkce pro získání nativního názvu jazyka z kódu (např. "en-US" -> "English")
  function getNativeLangName(langCode) {
    try {
      const displayNames = new Intl.DisplayNames([langCode], { type: 'language' });
      return displayNames.of(langCode.split('-')[0]) || langCode;
    } catch (e) {
      return langCode;
    }
  }

  function updateAll() {
    const rawVoices = synth.getVoices();
    if (rawVoices.length === 0) return;

    // Debian Fix: Filtrace extrémního počtu hlasů
    cachedVoices = rawVoices.filter((v, index, self) =>
      index === self.findIndex((t) => t.lang === v.lang && t.name === v.name)
    ).slice(0, 300);

    const sysBody = document.getElementById('systemVoicesBody');
    if (sysBody) {
      sysBody.innerHTML = cachedVoices.map((v, index) => {
        const nativeName = getNativeLangName(v.lang);
        return `
          <tr>
            <td class="row-index">${index + 1}</td>
            <td><code class="mono">${v.lang}</code></td>
            <td style="text-transform: capitalize;"><strong>${nativeName}</strong></td>
            <td><small>${v.name}</small></td>
            <td>${v.localService ? '✅' : '🌐'}</td>
            <td>
              <button class="sys-play-btn" data-voice-index="${index}">${playIconHtml}</button>
            </td>
          </tr>
        `;
      }).join('');
    }

    const rows = document.querySelectorAll('#myLangsBody tr');
    rows.forEach(row => {
      const dataStr = row.getAttribute('data-item');
      if (!dataStr) return;
      const data = JSON.parse(dataStr);
      const statusCell = row.querySelector('.status-cell');
      const btn = row.querySelector('.play-btn');
      
      const cleanCode = data.code.toLowerCase().split('-')[0];
      const match = cachedVoices.find(v => {
        const vLang = v.lang.toLowerCase().replace('_', '-');
        return vLang === data.code.toLowerCase() || vLang.startsWith(cleanCode + '-');
      });

      if (match) {
        statusCell.innerHTML = `<span class="status-ok">OK</span>`;
        row.setAttribute('data-status', 'OK');
        btn.disabled = false;
        btn.style.opacity = "1";
      } else {
        statusCell.innerHTML = `<span class="status-err">NE</span>`;
        row.setAttribute('data-status', 'NE');
        btn.disabled = true;
        btn.style.opacity = "0.2";
      }
    });

    applyFilters();
  }

  function applyFilters() {
    const term = document.getElementById('langSearch')?.value.toLowerCase();
    const showISO2 = document.getElementById('filterISO2')?.checked;
    const showISO3 = document.getElementById('filterISO3')?.checked;
    const showOK = document.getElementById('filterOK')?.checked;
    const showNE = document.getElementById('filterNE')?.checked;
    
    const rows = Array.from(document.querySelectorAll('#myLangsBody tr'));
    let visibleIndex = 1;

    rows.forEach(row => {
      const isoLen = parseInt(row.getAttribute('data-iso') || '0');
      const status = row.getAttribute('data-status');
      const text = row.innerText.toLowerCase();
      
      const matchesSearch = text.includes(term);
      const matchesISO = (isoLen === 2 && showISO2) || (isoLen === 3 && showISO3);
      const matchesStatus = (status === 'OK' && showOK) || (status === 'NE' && showNE);
      
      if (matchesSearch && matchesISO && matchesStatus) {
        row.style.display = '';
        row.querySelector('.row-index').textContent = visibleIndex++;
      } else {
        row.style.display = 'none';
      }
    });
  }

  async function playVoice(voice, text) {
    return new Promise((resolve) => {
      synth.cancel();
      // Android potřebuje krátkou pauzu po cancel, aby se engine "resetoval"
      setTimeout(() => {
        const ut = new SpeechSynthesisUtterance(text);
        ut.voice = voice;
        ut.lang = voice.lang; // Force lang pro Android
        ut.rate = 1.0;
        ut.onend = () => {
          // Další pauza po skončení řeči pro stabilitu přepnutí
          setTimeout(resolve, 250);
        };
        ut.onerror = () => setTimeout(resolve, 250);
        synth.speak(ut);
      }, 100); 
    });
  }

  document.getElementById('playAllVoices')?.addEventListener('click', async () => {
    if (isLooping) { isLooping = false; synth.cancel(); return; }
    if (cachedVoices.length === 0) return;
    
    isLooping = true;
    const btn = document.getElementById('playAllVoices');
    btn.innerHTML = '⏹ Stop Loop';

    for (let i = 0; i < cachedVoices.length; i++) {
      if (!isLooping) break;
      const voice = cachedVoices[i];
      const rows = document.querySelectorAll('#systemVoicesBody tr');
      rows.forEach(r => r.style.background = '');
      rows[i].style.background = 'var(--sl-color-accent-low)';
      
      const nativeName = getNativeLangName(voice.lang);
      await playVoice(voice, `Testing ${nativeName} voice`);
    }

    isLooping = false;
    btn.innerHTML = 'Play All (Slow Loop)';
    document.querySelectorAll('#systemVoicesBody tr').forEach(r => r.style.background = '');
  });

  document.addEventListener('click', (e) => {
    const target = e.target;
    const sysBtn = target.closest('.sys-play-btn');
    if (sysBtn) {
      const idx = parseInt(sysBtn.getAttribute('data-voice-index'));
      const voice = cachedVoices[idx];
      const nativeName = getNativeLangName(voice.lang);
      playVoice(voice, `Test: ${nativeName}`);
      return;
    }
    const playBtn = target.closest('.play-btn');
    if (playBtn && !playBtn.disabled) {
      const text = playBtn.getAttribute('data-text');
      const code = playBtn.getAttribute('data-code');
      const v = cachedVoices.find(v => v.lang.toLowerCase().replace('_', '-').startsWith(code.toLowerCase().split('-')[0]));
      if (v) playVoice(v, text);
    }
  });

  // Init
  if (typeof speechSynthesis !== 'undefined') {
    speechSynthesis.onvoiceschanged = updateAll;
    updateAll();
    setTimeout(updateAll, 1000);
  }

  // Eventy pro filtry
  document.getElementById('langSearch')?.addEventListener('input', applyFilters);
  ['filterISO2', 'filterISO3', 'filterOK', 'filterNE'].forEach(id => {
    document.getElementById(id)?.addEventListener('change', applyFilters);
  });
</script>

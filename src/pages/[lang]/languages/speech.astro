---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Icon } from 'astro-icon/components';
import { 
  getI18nPaths, 
  getUsedLanguagesData, 
  getUnusedLanguagesData 
} from '@/content/config/i18n';

export async function getStaticPaths() {
  return getI18nPaths();
}

const { lang } = Astro.params;

const usedLangs = getUsedLanguagesData();
const unusedLangs = getUnusedLanguagesData();
const allLangs = ([...usedLangs, ...unusedLangs] as any[]).map(l => ({
  code: l.code,
  nameEn: l.nameEn,
  nameNative: l.nameNative,
  usageCount: l.usageCount || 0,
  isoLength: l.code.length
})).sort((a, b) => b.usageCount - a.usageCount);
---

<StarlightPage frontmatter={{ title: 'TTS Diagnostics Pro', template: 'doc' }}>
  
  <section class="debug-section">
    <div class="section-header">
      <h2>1. Systémové hlasy (Prohlížeč)</h2>
      <button id="playAllVoices" class="action-btn">
        <Icon name="line-md:play-filled" /> Přehrát všechny hlasy (Loop)
      </button>
    </div>
    <div class="table-wrapper">
      <table id="systemVoicesTable">
        <thead>
          <tr>
            <th>#</th>
            <th>Jazyk</th>
            <th>Název hlasu</th>
            <th>Místní</th>
            <th>Akce</th>
          </tr>
        </thead>
        <tbody id="systemVoicesBody">
          <tr><td colspan="5">Načítám hlasy ze systému...</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="debug-section">
    <h2>2. Testování vašich jazyků</h2>
    
    <div class="controls-grid">
      <div class="search-box">
        <input type="text" id="langSearch" placeholder="Hledat jazyk..." />
      </div>
      <div class="filter-group">
        <span class="filter-label">ISO:</span>
        <label><input type="checkbox" id="filterISO2" checked /> 639-1</label>
        <label><input type="checkbox" id="filterISO3" checked /> 639-3</label>
      </div>
      <div class="filter-group">
        <span class="filter-label">Status:</span>
        <label><input type="checkbox" id="filterOK" checked /> <span class="status-ok">OK</span></label>
        <label><input type="checkbox" id="filterNE" checked /> <span class="status-err">NE</span></label>
      </div>
    </div>

    <div class="table-wrapper">
      <table id="myLangsTable">
        <thead>
          <tr>
            <th>#</th>
            <th data-sort="code">ISO <Icon name="lucide:arrow-up-down" /></th>
            <th data-sort="nameEn">Název <Icon name="lucide:arrow-up-down" /></th>
            <th data-sort="usageCount">Země <Icon name="lucide:arrow-up-down" /></th>
            <th>Status</th>
            <th>Test</th>
          </tr>
        </thead>
        <tbody id="myLangsBody">
          {allLangs.map(l => (
            <tr data-item={JSON.stringify(l)} data-iso={l.isoLength}>
              <td class="row-index"></td>
              <td class="mono">{l.code}</td>
              <td>
                <strong>{l.nameEn}</strong><br/>
                <small>{l.nameNative}</small>
              </td>
              <td>{l.usageCount}</td>
              <td class="status-cell">---</td>
              <td>
                <button class="play-btn" data-code={l.code} data-text={l.nameNative} disabled>
                  <Icon name="line-md:play-filled" />
                </button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</StarlightPage>

<style is:global>
  .debug-section { margin-bottom: 3rem; }
  .section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 1rem; }
  .section-header h2 { margin: 0; }

  .action-btn {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.5rem 1rem; background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high); border: 1px solid var(--sl-color-accent);
    border-radius: 4px; cursor: pointer; font-weight: bold;
  }
  .action-btn:hover { background: var(--sl-color-accent); color: white; }

  .controls-grid {
    display: flex; flex-wrap: wrap; gap: 1.5rem; background: var(--sl-color-gray-6);
    padding: 1rem; margin-bottom: 1rem; border-radius: 4px; align-items: center;
  }

  .filter-label { font-weight: bold; font-size: 0.75rem; text-transform: uppercase; color: var(--sl-color-gray-3); }
  .search-box input { background: var(--sl-color-bg); color: white; border: 1px solid var(--sl-color-gray-4); padding: 0.4rem 0.8rem; border-radius: 4px; }

  .filter-group { display: flex; gap: 0.8rem; font-size: 0.9rem; align-items: center; border-left: 1px solid var(--sl-color-gray-4); padding-left: 1rem; }
  .filter-group label { display: flex; align-items: center; gap: 0.3rem; cursor: pointer; }

  .table-wrapper { overflow-x: auto; border: 1px solid var(--sl-color-hairline); background: var(--sl-color-bg); }
  table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
  th, td { padding: 0.6rem 0.8rem; border-bottom: 1px solid var(--sl-color-hairline); text-align: left; }
  th { background: var(--sl-color-gray-6); cursor: pointer; white-space: nowrap; }
  
  .row-index { font-size: 0.7rem; color: var(--sl-color-gray-3); font-family: var(--sl-font-mono); }
  .mono { font-family: var(--sl-font-mono); color: var(--sl-color-accent-high); font-weight: bold; }
  .status-ok { color: #4ade80; font-weight: bold; }
  .status-err { color: #f87171; font-weight: bold; }

  .play-btn, .sys-play-btn {
    background: var(--sl-color-accent); color: white; border: none; border-radius: 50%;
    width: 28px; height: 28px; display: flex; align-items: center; justify-content: center;
    cursor: pointer; opacity: 0.2; transition: 0.2s;
  }
  .play-btn:not(:disabled), .sys-play-btn { opacity: 1; }
  .play-btn:not(:disabled):hover, .sys-play-btn:hover { transform: scale(1.1); background: var(--sl-color-accent-high); }

  th svg { width: 12px; height: 12px; opacity: 0.5; vertical-align: middle; }
</style>

<script>
  const synth = window.speechSynthesis;
  let isLooping = false;
  
  function updateAll() {
    const voices = synth.getVoices();
    
    // 1. Aktualizace systémové tabulky s indexy a tlačítky
    const sysBody = document.getElementById('systemVoicesBody');
    if (sysBody && voices.length > 0) {
      sysBody.innerHTML = voices.map((v, index) => `
        <tr>
          <td class="row-index">${index + 1}</td>
          <td><code class="mono">${v.lang}</code></td>
          <td>${v.name}</td>
          <td>${v.localService ? '✅' : '🌐'}</td>
          <td>
            <button class="sys-play-btn" data-voice-index="${index}" title="Přehrát tímto hlasem">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            </button>
          </td>
        </tr>
      `).join('');
    }

    // 2. Propojení s vašimi jazyky a statusy
    const rows = Array.from(document.querySelectorAll('#myLangsBody tr'));
    rows.forEach(row => {
      const data = JSON.parse(row.getAttribute('data-item') || '{}');
      const statusCell = row.querySelector('.status-cell');
      const btn = row.querySelector('.play-btn') as HTMLButtonElement;
      
      const cleanCode = data.code.toLowerCase().split('-')[0];
      const match = voices.find(v => {
        const vLang = v.lang.toLowerCase().replace('_', '-');
        return vLang === data.code.toLowerCase() || vLang.startsWith(cleanCode + '-');
      });

      if (match) {
        if (statusCell) statusCell.innerHTML = `<span class="status-ok">OK</span>`;
        row.setAttribute('data-status', 'OK');
        if (btn) btn.disabled = false;
      } else {
        if (statusCell) statusCell.innerHTML = `<span class="status-err">NE</span>`;
        row.setAttribute('data-status', 'NE');
        if (btn) btn.disabled = true;
      }
    });

    applyFilters();
  }

  function applyFilters() {
    const term = (document.getElementById('langSearch') as HTMLInputElement)?.value.toLowerCase();
    const showISO2 = (document.getElementById('filterISO2') as HTMLInputElement)?.checked;
    const showISO3 = (document.getElementById('filterISO3') as HTMLInputElement)?.checked;
    const showOK = (document.getElementById('filterOK') as HTMLInputElement)?.checked;
    const showNE = (document.getElementById('filterNE') as HTMLInputElement)?.checked;
    
    const rows = Array.from(document.querySelectorAll('#myLangsBody tr')) as HTMLElement[];
    let visibleIndex = 1;

    rows.forEach(row => {
      const isoLen = parseInt(row.getAttribute('data-iso') || '0');
      const status = row.getAttribute('data-status');
      const text = row.innerText.toLowerCase();
      
      const matchesSearch = text.includes(term);
      const matchesISO = (isoLen === 2 && showISO2) || (isoLen === 3 && showISO3);
      const matchesStatus = (status === 'OK' && showOK) || (status === 'NE' && showNE);
      
      if (matchesSearch && matchesISO && matchesStatus) {
        row.style.display = '';
        const indexCell = row.querySelector('.row-index');
        if (indexCell) indexCell.textContent = (visibleIndex++).toString();
      } else {
        row.style.display = 'none';
      }
    });
  }

  // Funkce pro postupné přehrání všech hlasů (Loop)
  async function playAllVoices() {
    if (isLooping) { synth.cancel(); isLooping = false; return; }
    const voices = synth.getVoices();
    if (voices.length === 0) return;
    
    isLooping = true;
    const btn = document.getElementById('playAllVoices');
    if (btn) btn.innerHTML = '⏹ Zastavit smyčku';

    for (let i = 0; i < voices.length; i++) {
      if (!isLooping) break;
      
      // Zvýraznění aktuálního řádku v tabulce systémových hlasů
      const rows = document.querySelectorAll('#systemVoicesBody tr');
      rows.forEach(r => (r as HTMLElement).style.background = '');
      (rows[i] as HTMLElement).style.background = 'rgba(var(--accent-rgb, 59, 130, 246), 0.1)';

      await new Promise((resolve) => {
        const v = voices[i];
        const text = `Voice number ${i + 1}, ${v.name}, language code ${v.lang}`;
        const utterance = new SpeechSynthesisUtterance(text);
        utterance.voice = v;
        utterance.onend = resolve;
        utterance.onerror = resolve;
        synth.speak(utterance);
      });
    }

    isLooping = false;
    if (btn) btn.innerHTML = '<svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" style="margin-right:8px"><path d="M8 5v14l11-7z"/></svg> Přehrát všechny hlasy (Loop)';
    document.querySelectorAll('#systemVoicesBody tr').forEach(r => (r as HTMLElement).style.background = '');
  }

  // Event Listeners
  document.getElementById('langSearch')?.addEventListener('input', applyFilters);
  ['filterISO2', 'filterISO3', 'filterOK', 'filterNE'].forEach(id => {
    document.getElementById(id)?.addEventListener('change', applyFilters);
  });

  document.getElementById('playAllVoices')?.addEventListener('click', playAllVoices);

  // Klikání na tabulky
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    
    // Test systémového hlasu
    const sysBtn = target.closest('.sys-play-btn') as HTMLButtonElement;
    if (sysBtn) {
      const idx = parseInt(sysBtn.getAttribute('data-voice-index') || '0');
      const voice = synth.getVoices()[idx];
      synth.cancel();
      const ut = new SpeechSynthesisUtterance(`Testing ${voice.name}`);
      ut.voice = voice;
      synth.speak(ut);
      return;
    }

    // Test vašeho jazyka
    const playBtn = target.closest('.play-btn') as HTMLButtonElement;
    if (playBtn && !playBtn.disabled) {
      const text = playBtn.getAttribute('data-text') || '';
      const code = playBtn.getAttribute('data-code') || 'en';
      synth.cancel();
      const ut = new SpeechSynthesisUtterance(text);
      ut.lang = code;
      const v = synth.getVoices().find(v => v.lang.toLowerCase().replace('_', '-').startsWith(code.toLowerCase().split('-')[0]));
      if (v) ut.voice = v;
      synth.speak(ut);
    }
  });

  // Init
  if (typeof speechSynthesis !== 'undefined') {
    speechSynthesis.onvoiceschanged = updateAll;
    updateAll();
    setTimeout(updateAll, 1000);
  }
</script>

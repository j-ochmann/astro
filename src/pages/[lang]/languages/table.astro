---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Icon } from 'astro-icon/components';
import { 
  getI18nPaths, 
  useTranslations,
  getUsedLanguagesData,
  getUnusedLanguagesData
} from '@/content/config/i18n';

export async function getStaticPaths() {
  return getI18nPaths();
}

const { lang } = Astro.params;
const t = useTranslations(lang);

const usedLangs = getUsedLanguagesData();
const unusedLangs = getUnusedLanguagesData();

const labels = {
  code: 'ISO',
  en: lang === 'cs' ? 'Anglicky' : 'English',
  native: lang === 'cs' ? 'Nativně' : 'Native',
  type: lang === 'cs' ? 'Typ' : 'Type',
  usage: lang === 'cs' ? 'Počet zemí' : 'Countries'
};
---

<StarlightPage frontmatter={{ title: String(t('geo.nav.languages')), template: 'doc' }}>
  
  <div class="table-controls">
    <div class="search-box">
      <input type="text" id="tableSearch" placeholder={String(t('atlas.table.search'))} />
    </div>
    <div class="export-group">
      <span class="export-label">Export (Visible):</span>
      <div class="export-buttons">
        <button class="export-btn" data-type="json">JSON</button>
        <button class="export-btn" data-type="csv">CSV</button>
      </div>
    </div>
  </div>

  <h2 class="section-title">{lang === 'cs' ? 'Používané jazyky' : 'Used Languages'}</h2>
  <div class="table-wrapper">
    <table class="langTable">
      <thead>
        <tr>
          <th data-sort="code">{labels.code} <Icon name="lucide:arrow-up-down" /></th>
          <th data-sort="nameEn">{labels.en} <Icon name="lucide:arrow-up-down" /></th>
          <th data-sort="nameNative">{labels.native} <Icon name="lucide:arrow-up-down" /></th>
          <th data-sort="type">{labels.type} <Icon name="lucide:arrow-up-down" /></th>
          <th data-sort="usageCount">{labels.usage} <Icon name="lucide:arrow-up-down" /></th>
        </tr>
      </thead>
      <tbody class="tableBody">
        {usedLangs.map(l => (
          <tr data-item={JSON.stringify(l)}>
            <td class="mono">{l.code}</td>
            <td>
              <a href={`/${lang}/languages/${l.code.toLowerCase()}/`} class="lang-link">
                {l.nameEn}
              </a>
            </td>
            <td class="native">{l.nameNative}</td>
            <td class="type-cell"><span>{l.type}</span></td>
            <td><strong>{l.usageCount}</strong></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2 class="section-title">{lang === 'cs' ? 'Ostatní definované jazyky' : 'Other Defined Languages'}</h2>
  <div class="table-wrapper">
    <table class="langTable">
      <thead>
        <tr>
          <th data-sort="code">{labels.code} <Icon name="lucide:arrow-up-down" /></th>
          <th data-sort="nameEn">{labels.en} <Icon name="lucide:arrow-up-down" /></th>
          <th data-sort="nameNative">{labels.native} <Icon name="lucide:arrow-up-down" /></th>
          <th data-sort="type">{labels.type} <Icon name="lucide:arrow-up-down" /></th>
        </tr>
      </thead>
      <tbody class="tableBody">
        {unusedLangs.map(l => (
          <tr data-item={JSON.stringify(l)}>
            <td class="mono">{l.code}</td>
            <td>
              <a href={`/${lang}/languages/${l.code.toLowerCase()}/`} class="lang-link">
                {l.nameEn}
              </a>
            </td>
            <td class="native">{l.nameNative}</td>
            <td class="type-cell"><span>{l.type}</span></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

</StarlightPage>

<style>
  .section-title { margin-top: 3rem; margin-bottom: 1.5rem; font-size: 1.5rem; color: var(--sl-color-white); }
  
  .table-controls {
    display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; justify-content: space-between;
    background: var(--sl-color-gray-6); padding: 1rem; border: 1px solid var(--sl-color-hairline);
    position: sticky; top: 0; z-index: 10; margin-bottom: 2rem;
  }
  
  .search-box { flex: 1; min-width: 200px; }
  .search-box input {
    width: 100%; height: 2.2rem; padding: 0 1rem; background: var(--sl-color-bg);
    color: var(--sl-color-white); border: 1px solid var(--sl-color-gray-4); border-radius: 4px;
  }

  .export-group { display: flex; align-items: center; gap: 0.75rem; }
  .export-label { font-size: 0.75rem; color: var(--sl-color-gray-3); font-weight: bold; }
  .export-buttons { display: flex; gap: 1px; background: var(--sl-color-gray-4); border-radius: 4px; overflow: hidden; }
  .export-btn { 
    height: 2rem; border: none; padding: 0 0.75rem; background: var(--sl-color-gray-5); 
    color: white; cursor: pointer; font-size: 0.7rem; font-weight: bold;
  }
  .export-btn:hover { background: var(--sl-color-accent-low); }

  .table-wrapper { overflow-x: auto; margin-bottom: 3rem; border: 1px solid var(--sl-color-hairline); border-radius: 4px; }
  table { width: 100%; border-collapse: collapse; font-size: 0.85rem; background: var(--sl-color-bg); }
  th { background: var(--sl-color-gray-6); padding: 0.75rem; text-align: left; cursor: pointer; border-bottom: 2px solid var(--sl-color-hairline); white-space: nowrap; }
  td { padding: 0.75rem; border-bottom: 1px solid var(--sl-color-hairline); vertical-align: middle; }
  
  /* Styl prokliků na detail jazyka */
  .lang-link {
    color: var(--sl-color-accent-high) !important;
    text-decoration: none !important;
    font-weight: 600;
  }
  .lang-link:hover {
    color: var(--sl-color-white) !important;
    text-decoration: none !important;
  }

  .type-cell span {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    background: var(--sl-color-gray-5);
    border-radius: 3px;
    font-size: 0.7rem;
    font-weight: bold;
    color: var(--sl-color-gray-2);
  }

  .mono { font-family: var(--sl-font-mono); color: var(--sl-color-gray-3); font-size: 0.8rem; }
  .native { font-style: italic; opacity: 0.7; font-size: 0.8rem; }

  /* Sort šipky */
  th svg { transition: transform 0.2s ease, opacity 0.2s ease; width: 14px; margin-left: 4px; opacity: 0.3; vertical-align: middle; }
  th:hover svg { opacity: 0.7; }
  th.asc svg { transform: rotate(180deg); opacity: 1; color: var(--sl-color-accent); }
  th.desc svg { transform: rotate(0deg); opacity: 1; color: var(--sl-color-accent); }
</style>

<script>
  const searchInput = document.getElementById('tableSearch') as HTMLInputElement | null;
  const tables = document.querySelectorAll('.langTable');
  const exportBtns = document.querySelectorAll('.export-btn');

  // 1. FILTROVÁNÍ (pro všechny řádky ve všech tabulkách najednou)
  if (searchInput) {
    searchInput.addEventListener('input', () => {
      const term = searchInput.value.toLowerCase();
      document.querySelectorAll('.tableBody tr').forEach(row => {
        (row as HTMLElement).style.display = row.textContent?.toLowerCase().includes(term) ? '' : 'none';
      });
    });
  }

  // 2. ŘAZENÍ (aplikováno na každou tabulku zvlášť)
  tables.forEach(table => {
    const tableBody = table.querySelector('.tableBody');
    if (!tableBody) return;

    table.querySelectorAll('th[data-sort]').forEach(th => {
      th.addEventListener('click', () => {
        const col = th.getAttribute('data-sort');
        if (!col || !tableBody) return;

        const rows = Array.from(tableBody.querySelectorAll('tr'));
        const isAsc = th.classList.contains('asc');
        
        const sortedRows = rows.sort((a, b) => {
          const rawA = a.getAttribute('data-item');
          const rawB = b.getAttribute('data-item');
          if (!rawA || !rawB) return 0;

          const dataA = JSON.parse(rawA);
          const dataB = JSON.parse(rawB);
          
          const valA = dataA[col];
          const valB = dataB[col];

          // Číselné řazení pro usageCount
          if (typeof valA === 'number' && typeof valB === 'number') {
            return isAsc ? valB - valA : valA - valB;
          }

          // Textové řazení
          return isAsc 
            ? String(valB).localeCompare(String(valA)) 
            : String(valA).localeCompare(String(valB));
        });

        // Vizuální zpětná vazba (šipky)
        table.querySelectorAll('th').forEach(h => h.classList.remove('asc', 'desc'));
        th.classList.toggle('asc', !isAsc);
        th.classList.toggle('desc', isAsc);

        // Překreslení řádků
        tableBody.append(...sortedRows);
      });
    });
  });

  // 3. EXPORT
  exportBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const type = btn.getAttribute('data-type');
      const data = Array.from(document.querySelectorAll('.tableBody tr'))
        .filter(r => (r as HTMLElement).style.display !== 'none')
        .map(r => JSON.parse(r.getAttribute('data-item') || '{}'));

      if (data.length === 0) return;

      if (type === 'json') {
        const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
        saveAs(blob, `languages_export.${type}`);
      } else if (type === 'csv') {
        const keys = ['code', 'nameEn', 'nameNative', 'usageCount'];
        const csv = [
          keys.join(','), 
          ...data.map(row => keys.map(k => `"${String(row[k] || '').replace(/"/g, '""')}"`).join(','))
        ].join('\n');
        const blob = new Blob([csv], { type: 'text/csv' });
        saveAs(blob, `languages_export.${type}`);
      }
    });
  });

  function saveAs(blob: Blob, fileName: string) {
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = fileName;
    a.click();
    URL.revokeObjectURL(url);
  }
</script>

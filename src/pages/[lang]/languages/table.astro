---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Icon } from 'astro-icon/components';
import { 
  getI18nPaths, 
  useTranslations,
  getUsedLanguagesData,
  getUnusedLanguagesData
} from '@/content/config/i18n';

export async function getStaticPaths() {
  return getI18nPaths();
}

const { lang } = Astro.params;
const t = useTranslations(lang);

const usedLangs = getUsedLanguagesData();
const unusedLangs = getUnusedLanguagesData();
const allLangs = [...usedLangs, ...unusedLangs] as any[];

const labels = {
  code: 'ISO',
  en: lang === 'cs' ? 'Anglicky' : 'English',
  native: lang === 'cs' ? 'Nativně' : 'Native',
  type: lang === 'cs' ? 'Typ' : 'Type',
  usage: lang === 'cs' ? 'Počet zemí' : 'Countries'
};
---

<StarlightPage frontmatter={{ title: String(t('geo.nav.languages')), template: 'doc' }}>
  
  <div class="table-controls">
    <div class="search-box">
      <input 
        type="text" 
        id="tableSearch" 
        placeholder={String(t('atlas.table.search'))} 
        aria-label={String(t('atlas.table.search'))}
      />
    </div>
    
    <div class="export-group">
      <span class="export-label">Export:</span>
      <div class="export-buttons">
        <button class="export-btn" data-type="json">JSON</button>
        <button class="export-btn" data-type="csv">CSV</button>
        <button class="export-btn" data-type="xml">XML</button>
        <button class="export-btn" data-type="yaml">YAML</button>
      </div>
    </div>
  </div>

  <div class="table-wrapper">
    <table id="languagesTable">
      <thead>
        <tr>
          <th data-sort="code">{labels.code} <Icon name="lucide:arrow-up-down" /></th>
          <th data-sort="nameEn">{labels.en} <Icon name="lucide:arrow-up-down" /></th>
          <th data-sort="nameNative">{labels.native} <Icon name="lucide:arrow-up-down" /></th>
          <th data-sort="type">{labels.type} <Icon name="lucide:arrow-up-down" /></th>
          <th data-sort="usageCount">{labels.usage} <Icon name="lucide:arrow-up-down" /></th>
        </tr>
      </thead>
      <tbody id="tableBody">
        {allLangs.map(l => (
          <tr data-item={JSON.stringify(l)}>
            <td class="mono">{l.code}</td>
            <td>
              <a href={`/${lang}/languages/${l.code.toLowerCase()}/`} class="lang-link">
                {l.nameEn}
              </a>
            </td>
            <td class="native">{l.nameNative}</td>
            <td class="type-cell"><span>{l.type}</span></td>
            <td><strong>{l.usageCount || 0}</strong></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</StarlightPage>

<style>
  /* Reset Starlight marginů proti uskakování */
  .table-controls, .table-wrapper { margin-top: 0 !important; }

  .table-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2rem;
    padding: 1.25rem;
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-hairline);
  }

  .search-box { flex: 1; min-width: 250px; }
  .search-box input {
    width: 100%;
    height: 2.2rem;
    padding: 0 1rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-white);
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 4px;
  }

  .export-group { display: flex; align-items: center; gap: 1rem; }
  .export-label {
    font-size: 0.75rem;
    font-weight: bold;
    color: var(--sl-color-gray-3);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .export-buttons {
    display: flex;
    background: var(--sl-color-gray-4);
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 4px;
    overflow: hidden;
    gap: 1px;
  }

  .export-btn {
    appearance: none;
    margin: 0;
    border: none;
    height: 2rem;
    display: flex;
    align-items: center;
    padding: 0 0.85rem;
    background: var(--sl-color-gray-5);
    color: var(--sl-color-white);
    cursor: pointer;
    font-size: 0.75rem;
    font-weight: 600;
    transition: background 0.2s ease;
  }

  .export-btn:hover { background: var(--sl-color-accent-low); }

  .table-wrapper { overflow-x: auto; border: 1px solid var(--sl-color-hairline); }
  table { width: 100%; border-collapse: collapse; font-size: 0.875rem; margin: 0; }
  th {
    background: var(--sl-color-gray-6);
    padding: 1rem 0.75rem;
    text-align: left;
    cursor: pointer;
    white-space: nowrap;
    border-bottom: 2px solid var(--sl-color-hairline);
  }

  td { padding: 0.85rem 0.75rem; border-bottom: 1px solid var(--sl-color-hairline); }

  .lang-link {
    color: var(--sl-color-accent-high) !important;
    text-decoration: none !important;
    font-weight: 600;
  }
  .lang-link:hover { color: var(--sl-color-white) !important; }

  .type-cell span {
    display: inline-block;
    padding: 0.15rem 0.4rem;
    background: var(--sl-color-gray-5);
    border-radius: 3px;
    font-size: 0.7rem;
    font-weight: bold;
    color: var(--sl-color-gray-3);
  }

  .mono { font-family: var(--sl-font-mono); color: var(--sl-color-accent-high); font-weight: 600; }
  .native { font-style: italic; opacity: 0.7; }

  th svg { width: 14px; height: 14px; margin-left: 4px; opacity: 0.4; }
  
  @media (max-width: 45rem) {
    .table-controls { flex-direction: column; align-items: stretch; }
  }
</style>

<script>
  const searchInput = document.getElementById('tableSearch') as HTMLInputElement | null;
  const table = document.getElementById('languagesTable') as HTMLTableElement | null;
  const tableBody = document.getElementById('tableBody');
  const exportBtns = document.querySelectorAll('.export-btn');

  if (searchInput && table && tableBody) {
    const rows = Array.from(tableBody.querySelectorAll('tr'));

    // 1. Vyhledávání
    searchInput.addEventListener('input', () => {
      const term = searchInput.value.toLowerCase();
      rows.forEach(row => {
        row.style.display = row.innerText.toLowerCase().includes(term) ? '' : 'none';
      });
    });

    // 2. Řazení
    table.querySelectorAll('th[data-sort]').forEach(th => {
      th.addEventListener('click', () => {
        const col = th.getAttribute('data-sort');
        if (!col) return;
        const isAsc = th.classList.contains('asc');
        const sortedRows = rows.sort((a, b) => {
          const dataA = JSON.parse(a.getAttribute('data-item') || '{}');
          const dataB = JSON.parse(b.getAttribute('data-item') || '{}');
          const valA = dataA[col];
          const valB = dataB[col];
          if (typeof valA === 'number') return isAsc ? valB - valA : valA - valB;
          return isAsc ? String(valB).localeCompare(String(valA)) : String(valA).localeCompare(String(valB));
        });
        table.querySelectorAll('th').forEach(h => h.classList.remove('asc', 'desc'));
        th.classList.toggle('asc', !isAsc);
        th.classList.toggle('desc', isAsc);
        tableBody.append(...sortedRows);
      });
    });

    // 3. Export (JSON, CSV, XML, YAML)
    exportBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const type = btn.getAttribute('data-type');
        const visibleData = rows
          .filter(r => r.style.display !== 'none')
          .map(r => JSON.parse(r.getAttribute('data-item') || '{}'));

        if (visibleData.length === 0) return;

        let content = '';
        let mime = 'text/plain';

        if (type === 'json') {
          content = JSON.stringify(visibleData, null, 2);
          mime = 'application/json';
        } else if (type === 'csv') {
          const keys = Object.keys(visibleData[0]);
          content = [keys.join(','), ...visibleData.map(row => keys.map(k => `"${String(row[k] || '').replace(/"/g, '""')}"`).join(','))].join('\n');
          mime = 'text/csv';
        } else if (type === 'yaml') {
          content = visibleData.map(obj => Object.entries(obj).map(([k, v]) => `${k}: "${v}"`).join('\n')).join('\n---\n');
          mime = 'text/yaml';
        } else if (type === 'xml') {
          content = `<?xml version="1.0" encoding="UTF-8"?>\n<languages>\n` + 
            visibleData.map(obj => `  <language>\n${Object.entries(obj).map(([k, v]) => `    <${k}>${v}</${k}>`).join('\n')}\n  </language>`).join('\n') + 
            `\n</languages>`;
          mime = 'application/xml';
        }

        const blob = new Blob([content], { type: mime });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `languages_export.${type}`;
        a.click();
        URL.revokeObjectURL(url);
      });
    });
  }
</script>

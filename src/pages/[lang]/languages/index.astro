---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { 
  getI18nPaths, 
  countriesData, 
  useTranslations,
  getUsedLanguagesData, // Použijeme tvou novou funkci
  type Country 
} from '@/content/config/i18n';

export async function getStaticPaths() {
  return getI18nPaths();
}

const { lang } = Astro.params;
const t = useTranslations(lang);

// Získáme už zpracovaná data o jazycích (včetně iso_639_3 a názvů)
const usedLanguagesData = getUsedLanguagesData();
const allCountries = Object.values(countriesData) as Country[];

const languageGroups = usedLanguagesData.map(langInfo => {
  // langInfo už obsahuje nameEn nebo nameNative díky getLangInfo v i18n.ts
  const label = langInfo.nameEn !== 'Unknown' ? langInfo.nameEn : langInfo.code;
  
  // Najdeme země pro daný jazyk
  const speakers = allCountries.filter(c => c.language && c.language.includes(langInfo.code));
  
  // Seřadíme země podle přeloženého názvu
  speakers.sort((a, b) => {
    const nameA = t(a.code as any) || a.name;
    const nameB = t(b.code as any) || b.name;
    return nameA.localeCompare(nameB, lang);
  });

  return {
    code: langInfo.code,
    label: label,
    countries: speakers
  };
}).sort((a, b) => a.label.localeCompare(b.label, lang));
---

<StarlightPage 
  frontmatter={{ 
    title: String(t('geo.nav.languages') || 'Jazyky'), 
    template: 'doc'
  }}
>
  <div class="languages-list">
    {languageGroups.map(group => (
      <section class="lang-group">
        <h2 id={group.code}>
          {group.label} <span class="code">({group.code})</span>
        </h2>
        <div class="country-grid">
          {group.countries.map(country => {
            const countryKey = country.code as any;
            const displayName = t(countryKey) !== country.code ? t(countryKey) : country.name;
            return (
              <a href={`/${lang}/countries/${country.code.toLowerCase()}/`} class="country-card">
                <span class:list={['fi', `fi-${country.code.toLowerCase()}`]}></span>
                <span class="name">{displayName}</span>
              </a>
            );
          })}
        </div>
      </section>
    ))}
  </div>
</StarlightPage>

<style>
  /* Styl zůstává stejný, je v pořádku */
  .lang-group { margin-bottom: 3rem; }
  h2 { border-bottom: 1px solid var(--sl-color-hairline); padding-bottom: 0.5rem; margin-bottom: 1rem; }
  .code { font-size: 0.6em; color: var(--sl-color-gray-3); font-weight: normal; vertical-align: middle; }
  .country-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 0.75rem; }
  .country-card {
    display: flex; align-items: center; gap: 0.75rem; padding: 0.5rem 0.75rem;
    background: var(--sl-color-gray-6); border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem; text-decoration: none; color: var(--sl-color-white) !important;
    transition: all 0.2s ease; font-size: 0.9rem;
  }
  .country-card:hover { background: var(--sl-color-gray-5); border-color: var(--sl-color-accent); transform: translateY(-2px); }
  .fi { flex-shrink: 0; }
</style>

---
// src/pages/[lang]/languages/index.astro
import TabGridLayout from '@/components/root/TabGridLayout.astro';
import { 
  getI18nPaths, 
  useTranslations,
  getUsedLanguagesData,
  getUnusedLanguagesData
} from '@/content/config/i18n';

export async function getStaticPaths() { return getI18nPaths(); }

const { lang } = Astro.params;
const t = useTranslations(lang);

const usedLangs = getUsedLanguagesData();
const unusedLangs = getUnusedLanguagesData();

const data = ([...usedLangs, ...unusedLangs] as any[]).map(l => ({
  code: l.code,
  nameEn: l.nameEn,
  native: l.native,
  type: l.type,
  usageCount: Number(l.usageCount || 0)
}));

const columns = [
  { key: 'code', label: 'ISO', isMono: true },
  { key: 'nameEn', label: lang === 'cs' ? 'Anglicky' : 'English' },
  { key: 'native', label: lang === 'cs' ? 'Nativně' : 'Native', isNative: true },
  { key: 'type', label: lang === 'cs' ? 'Typ' : 'Type' },
  { key: 'usageCount', label: lang === 'cs' ? 'Počet zemí' : 'Countries', isNumeric: true }
];

const filterOptions = Array.from(new Set(data.map(l => l.type))).sort().map(f => ({
  label: f,
  value: f.toLowerCase(),
  count: data.filter(d => d.type === f).length
}));
---

<TabGridLayout 
  title={String(t('world.nav.languages'))}
  data={data}
  columns={columns}
  lang={lang}
  basePath={`/${lang}/languages`}
  accentColor="#3b82f6"
  filterLabel={lang === 'cs' ? 'Typy' : 'Types'}
  filterOptions={filterOptions}
  searchPlaceholder={String(t('atlas.table.search'))}
>
  <a 
    slot="title-after" 
    href={`/${lang}/languages/speech/`} 
    class="speech-btn"
  >
    <i class="fa-solid fa-microphone-lines"></i>
    <span>Speech</span>
  </a>
</TabGridLayout>

<style>
  .speech-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.8rem;
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--sl-color-white) !important;
    text-decoration: none !important;
    transition: all 0.2s ease;
    margin-left: 1rem;
    vertical-align: middle;
  }

  .speech-btn:hover {
    background: var(--sl-color-accent-low);
    border-color: var(--sl-color-accent);
  }

  .speech-btn i {
    color: var(--sl-color-accent);
  }
</style>

---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { 
  getI18nPaths, 
  countriesData, 
  useTranslations,
  getAllCurrencies 
} from '@/content/config/i18n';

export async function getStaticPaths() {
  const paths = getI18nPaths();
  const allCurrencies = getAllCurrencies();

  return paths.flatMap(p => 
    allCurrencies.map(code => ({
      params: { lang: p.params.lang, code: code.toLowerCase() }
    }))
  );
}

const { lang, code } = Astro.params;
const t = useTranslations(lang);
const upperCode = code.toUpperCase();

// 1. Navigační logika (pouze použité měny)
const allUsedCurrencies = getAllCurrencies().sort();
const currentIndex = allUsedCurrencies.indexOf(upperCode);
const prevCode = currentIndex > 0 ? allUsedCurrencies[currentIndex - 1] : null;
const nextCode = currentIndex < allUsedCurrencies.length - 1 ? allUsedCurrencies[currentIndex + 1] : null;

// 2. Najít země používající tuto měnu
const relatedCountries = Object.values(countriesData).filter(c => 
  c.currency?.map(curr => curr.toUpperCase()).includes(upperCode)
).sort((a, b) => {
  const nameA = t(a.code as any) !== a.code ? t(a.code as any) : a.name;
  const nameB = t(b.code as any) !== b.code ? t(b.code as any) : b.name;
  return nameA.localeCompare(nameB, lang);
});

// 3. Odkaz na Wikipedii
const wikiLang = lang === 'cs' ? 'cs' : 'en';
const wikiUrl = `https://${wikiLang}.wikipedia.org/wiki/ISO_4217`;
---

<StarlightPage frontmatter={{ title: `${upperCode}`, template: 'doc' }}>
  
  <div class="meta-grid">
    <div class="meta-card">
      <span class="label">ISO 4217</span>
      <span class="value mono">{upperCode}</span>
    </div>
    <div class="meta-card">
      <span class="label">{lang === 'cs' ? 'Externí odkaz' : 'External Link'}</span>
      <a href={wikiUrl} target="_blank" rel="noopener noreferrer" class="wiki-link">
        Wikipedia <span class="external-icon">↗</span>
      </a>
    </div>
  </div>

  <h2 class="section-title">{lang === 'cs' ? 'Země platící touto měnou' : 'Countries using this currency'}</h2>
  
  <div class="country-grid">
    {relatedCountries.map(country => {
      const displayName = t(country.code as any) !== country.code ? t(country.code as any) : country.name;
      return (
        <a href={`/${lang}/countries/${country.code.toLowerCase()}/`} class="country-card">
          <span class:list={['fi', `fi-${country.code.toLowerCase()}`]}></span>
          <span>{displayName}</span>
        </a>
      );
    })}
  </div>

  <div class="nav-grid">
    {prevCode ? (
      <a href={`/${lang}/currencies/${prevCode.toLowerCase()}/`} class="nav-item prev">
        <span class="nav-label">← {t('world.nav.prev') || 'Předchozí'}</span>
        <span class="nav-title">{prevCode}</span>
      </a>
    ) : <div class="nav-empty" />}

    <a href={`/${lang}/currencies/`} class="nav-item meta-nav">
      <span class="nav-label">Grid</span>
      <span class="nav-title">Index</span>
    </a>

    <a href={`/${lang}/currencies/table/`} class="nav-item meta-nav">
      <span class="nav-label">Data</span>
      <span class="nav-title">Tabulka</span>
    </a>

    {nextCode ? (
      <a href={`/${lang}/currencies/${nextCode.toLowerCase()}/`} class="nav-item next">
        <span class="nav-label">{t('world.nav.next') || 'Další'} →</span>
        <span class="nav-title">{nextCode}</span>
      </a>
    ) : <div class="nav-empty" />}
  </div>

</StarlightPage>

<style>
  /* Reset Starlight uskakování */
  .meta-grid, .section-title, .country-grid { margin-top: 0 !important; }

  .meta-grid { 
    display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); 
    gap: 1.5rem; margin-bottom: 2.5rem;
  }
  
  .meta-card { 
    margin-top: 0 !important; padding: 1.5rem; background: var(--sl-color-gray-6); 
    border: 1px solid var(--sl-color-hairline); border-radius: 4px; 
    display: flex; flex-direction: column; gap: 0.35rem;
  }

  .label { font-size: 0.7rem; color: var(--sl-color-accent-high); text-transform: uppercase; font-weight: bold; }
  .value { font-size: 1.25rem; font-weight: 500; color: var(--sl-color-white); }
  .mono { font-family: var(--sl-font-mono); }

  .wiki-link {
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--sl-color-accent-high) !important;
    text-decoration: none !important;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .wiki-link:hover { color: var(--sl-color-white) !important; }
  .external-icon { font-size: 0.8rem; opacity: 0.7; }

  .section-title { 
    margin-bottom: 1.5rem !important; font-size: 0.9rem; color: var(--sl-color-gray-2); 
    text-transform: uppercase; border-bottom: 1px solid var(--sl-color-gray-5); padding-bottom: 0.5rem; 
  }

  .country-grid { 
    display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 0.75rem; 
    margin-top: 0 !important;
  }

  .country-card { 
    display: flex; align-items: center; gap: 0.75rem; padding: 0.6rem 0.8rem; 
    background: var(--sl-color-gray-6); border: 1px solid var(--sl-color-hairline); border-radius: 4px;
    text-decoration: none !important; color: var(--sl-color-white) !important; font-size: 0.9rem;
    transition: background 0.2s, border-color 0.2s;
  }
  .country-card:hover { border-color: var(--sl-color-accent); background: var(--sl-color-gray-5); }

  /* Navigace */
  .nav-grid { 
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; 
    margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--sl-color-hairline);
  }
  .nav-item { 
    display: flex; flex-direction: column; padding: 1rem; 
    border: 1px solid var(--sl-color-hairline); border-radius: 0.5rem; 
    text-decoration: none !important; transition: border-color 0.2s, background 0.2s;
  }
  .nav-item:hover { border-color: var(--sl-color-accent); background: var(--sl-color-gray-6); }
  .nav-label { font-size: 0.7rem; color: var(--sl-color-gray-3); text-transform: uppercase; }
  .nav-title { font-weight: bold; color: var(--sl-color-accent-high); font-size: 0.9rem; }
  .next { text-align: right; }
  .meta-nav { text-align: center; }
  .nav-empty { visibility: hidden; }

  @media (max-width: 50rem) { 
    .nav-grid { grid-template-columns: 1fr 1fr; }
    .country-grid { grid-template-columns: 1fr; }
  }
</style>

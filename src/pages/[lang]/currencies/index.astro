---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getI18nPaths, countriesData, useTranslations } from '@/content/config/i18n';

export async function getStaticPaths() {
  return getI18nPaths();
}

const { lang } = Astro.params;
const t = useTranslations(lang);

// 1. Agregace měn
const allCountries = Object.values(countriesData);
const currencyMap = new Map<string, { code: string; countries: string[] }>();

allCountries.forEach((country: any) => {
  country.currency?.forEach((currCode: string) => {
    const code = currCode.toUpperCase();
    if (!currencyMap.has(code)) {
      currencyMap.set(code, { code, countries: [] });
    }
    const curr = currencyMap.get(code)!;
    if (!curr.countries.includes(country.code)) {
      curr.countries.push(country.code);
    }
  });
});

// 2. Seřazení a seskupení podle prvního písmene
const sortedCurrencies = Array.from(currencyMap.values()).sort((a, b) => 
  a.code.localeCompare(b.code)
);

const letters = [...new Set(sortedCurrencies.map(c => c.code[0]))].sort();

// 3. Kotvy pro pravý sidebar (headings)
const headings = letters.map(letter => ({
  depth: 2,
  slug: `letter-${letter.toLowerCase()}`,
  text: letter
}));

const title = lang === 'cs' ? 'Měny světa' : 'World Currencies';
---

<StarlightPage 
  frontmatter={{ 
    title: title, 
    template: 'doc',
    description: lang === 'cs' ? 'Seznam všech používaných měn' : 'List of all currencies'
  }}
  headings={headings}
>
  <div class="currency-grid-container">
    {letters.map(letter => (
      <section>
        <h2 id={`letter-${letter.toLowerCase()}`}>{letter}</h2>
        <div class="currency-grid">
          {sortedCurrencies
            .filter(c => c.code.startsWith(letter))
            .map(curr => (
              <a href={`/${lang}/currencies/${curr.code.toLowerCase()}/`} class="currency-card">
                <div class="code-box">
                  <span class="code">{curr.code}</span>
                </div>
                <div class="info">
                  <div class="flag-mini-list">
                    {curr.countries.slice(0, 5).map(cCode => (
                      <span class:list={['fi', `fi-${cCode.toLowerCase()}`]}></span>
                    ))}
                    {curr.countries.length > 5 && <span class="more">+{curr.countries.length - 5}</span>}
                  </div>
                </div>
              </a>
            ))}
        </div>
      </section>
    ))}
  </div>
</StarlightPage>

<style>
  .currency-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 0.75rem;
    margin-bottom: 2.5rem;
  }
  
  .currency-card {
    display: flex; 
    flex-direction: column;
    gap: 0.5rem; 
    padding: 1rem;
    background: var(--sl-color-gray-6); 
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem; 
    text-decoration: none; 
    color: var(--sl-color-white) !important;
    transition: all 0.2s ease;
  }
  
  .currency-card:hover {
    background: var(--sl-color-gray-5);
    border-color: var(--sl-color-accent);
    transform: translateY(-2px);
  }

  .code-box {
    font-family: var(--sl-font-mono);
    font-weight: bold;
    font-size: 1.2rem;
    color: var(--sl-color-accent-high);
  }

  .flag-mini-list {
    display: flex;
    gap: 0.25rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .fi { 
    font-size: 0.85rem; 
    border-radius: 2px;
  }

  .more {
    font-size: 0.7rem;
    color: var(--sl-color-gray-3);
    font-weight: bold;
  }

  h2 {
    scroll-margin-top: 5rem;
    margin-top: 2rem;
    border-bottom: 1px solid var(--sl-color-hairline);
    padding-bottom: 0.5rem;
    color: var(--sl-color-accent);
  }
</style>

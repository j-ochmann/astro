---
// src/pages/[lang]/currencies/index.astro
import TabGridLayout from '@/components/root/TabGridLayout.astro';
import { getI18nPaths, countriesData, useTranslations } from '@/content/config/i18n';

export async function getStaticPaths() { return getI18nPaths(); }

const { lang } = Astro.params;
const t = useTranslations(lang);

// Inicializace lokalizovaných názvů (např. 'cs' pro češtinu)
const currencyNames = new Intl.DisplayNames([lang || 'en'], { type: 'currency' });

const allCountries = Object.values(countriesData);
const currencyMap = new Map<string, { code: string, name: string, usageCount: number }>();

allCountries.forEach((country: any) => {
  if (country.currency) {
    country.currency.forEach((currCode: string) => {
      const code = currCode.toUpperCase();
      if (!currencyMap.has(code)) {
        let name = code;
        try {
          name = currencyNames.of(code) || code;
        } catch (e) {
          name = code;
        }
        currencyMap.set(code, { code, name, usageCount: 0 });
      }
      const curr = currencyMap.get(code)!;
      curr.usageCount++;
    });
  }
});

const data = Array.from(currencyMap.values()).sort((a, b) => a.code.localeCompare(b.code));

const columns = [
  { key: 'code', label: lang === 'cs' ? 'Kód' : 'Code', isMono: true },
  { key: 'name', label: lang === 'cs' ? 'Název měny' : 'Currency Name' },
  { key: 'usageCount', label: lang === 'cs' ? 'Počet zemí' : 'Countries', isNumeric: true }
];

// Filtr pro měny (např. Major podle popularity)
const filterOptions = [
  { label: 'Common', value: 'common', count: data.filter(d => d.usageCount > 2).length },
  { label: 'Rare', value: 'rare', count: data.filter(d => d.usageCount <= 2).length }
];
---

<TabGridLayout 
  title={lang === 'cs' ? 'Měny' : 'Currencies'}
  data={data}
  columns={columns}
  lang={lang}
  basePath={`/${lang}/currencies`}
  accentColor="#eab308"
  filterLabel={lang === 'cs' ? 'Výskyt' : 'Occurrence'}
  filterOptions={filterOptions}
  searchPlaceholder={lang === 'cs' ? 'Hledat měnu...' : 'Search currency...'}
  viewOptions={[
    { id: 'table', label: 'Table', icon: 'fa-solid fa-table' },
    { id: 'grid', label: 'Grid', icon: 'fa-solid fa-coins' },
    { id: 'net', label: 'Net', icon: 'lucide:network' }
  ]}
/>

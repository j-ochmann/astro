---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getI18nPaths, countriesData, getAllCurrencies, useTranslations } from '@/content/config/i18n';

export async function getStaticPaths() {
  return getI18nPaths();
}

const { lang } = Astro.params;
const t = useTranslations(lang);

const allCurrencies = getAllCurrencies();
const allCountries = Object.values(countriesData);

// Připravit data: Měna -> Seznam zemí
const currencyGroups = allCurrencies.map(currencyCode => {
  // Najít země, které platí touto měnou
  const users = allCountries.filter(c => c.currency && c.currency.includes(currencyCode));
  
  // Seřadit země podle lokalizovaného názvu
  users.sort((a, b) => {
    const nameA = t(a.code) !== a.code ? t(a.code) : a.name;
    const nameB = t(b.code) !== b.code ? t(b.code) : b.name;
    return nameA.localeCompare(nameB, lang);
  });

  return {
    code: currencyCode,
    countries: users
  };
}).sort((a, b) => a.code.localeCompare(b.code)); // Seřadit měny abecedně podle kódu

---

<StarlightPage 
  frontmatter={{ 
    title: String(t('geo.nav.currencies') || 'Měny'), 
    template: 'doc',
    description: 'Přehled světových měn a zemí, které je používají.'
  }}
>
  <div class="currencies-list">
    {currencyGroups.map(group => (
      <section class="currency-group">
        <h2 id={group.code}>{group.code}</h2>
        <div class="country-grid">
          {group.countries.map(country => {
            const displayName = t(country.code) !== country.code ? t(country.code) : country.name;
            return (
              <a href={`/${lang}/countries/${country.code.toLowerCase()}/`} class="country-card">
                <span class:list={['fi', `fi-${country.code.toLowerCase()}`]}></span>
                <span class="name">{displayName}</span>
              </a>
            );
          })}
        </div>
      </section>
    ))}
  </div>
</StarlightPage>

<style>
  .currency-group { margin-bottom: 3rem; }
  h2 { border-bottom: 1px solid var(--sl-color-hairline); padding-bottom: 0.5rem; margin-bottom: 1rem; }
  
  .country-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 0.75rem;
  }
  .country-card {
    display: flex; align-items: center; gap: 0.75rem; padding: 0.5rem 0.75rem;
    background: var(--sl-color-gray-6); border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem; text-decoration: none; color: var(--sl-color-white) !important;
    transition: all 0.2s ease; font-size: 0.9rem;
  }
  .country-card:hover { background: var(--sl-color-gray-5); border-color: var(--sl-color-accent); transform: translateY(-2px); }
  .fi { flex-shrink: 0; }
</style>

---
// src/pages/[lang]/countries/index.astro
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { countriesData, getAllContinents, locales } from '@/content/config/i18n';

export async function getStaticPaths() {
  return Object.keys(locales).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const continents = getAllContinents();
const allCountries = Object.values(countriesData).sort((a, b) => a.name.localeCompare(b.name));
---

<StarlightPage frontmatter={{ 
  title: lang === 'cs' ? 'Atlas zemí' : 'World Atlas', 
  template: 'doc' 
}}>
  <div class="country-grid-container">
    {continents.map(continent => (
      <section>
        <h2>{continent}</h2>
        <div class="country-grid">
          {allCountries
            .filter(c => c.continent === continent)
            .map(country => (
              <a href={`/${lang}/countries/${country.code.toLowerCase()}/`} class="country-card">
                <span class:list={['fi', `fi-${country.code.toLowerCase()}`]}></span>
                <span class="name">{country.name}</span>
              </a>
            ))}
        </div>
      </section>
    ))}
  </div>
</StarlightPage>

<style>
  .country-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 0.5rem;
    margin-bottom: 2rem;
  }
  .country-card {
    display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem;
    background: var(--sl-color-gray-6); border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem; text-decoration: none; color: inherit !important;
  }
</style>

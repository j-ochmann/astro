---
import WideLayout from '@/components/root/layout/Wide.astro';
import ViewFlags from '@/components/root/view/Flags.astro';
import ViewGlobe from '@/components/root/view/Globe.astro';
import ViewGrid from '@/components/root/view/Grid.astro';
import ViewMap from '@/components/root/view/Map.astro';
import ViewNet from '@/components/root/view/Net.astro';
import ViewOrbs from '@/components/root/view/Orbs.astro';
import ViewTable from '@/components/root/view/UniversalTable.astro';
import { 
  getI18nPaths, 
  countriesData, 
  useTranslations, 
  getMledozeData, 
  getCountryName 
} from '@/content/config/i18n';

const continentColors: Record<string, string> = {
  "Africa": "#FF6347",        // Tomato
  "Asia": "#DCDCDC",          // Gainsboro
  "Europe": "#8FBC8F",        // DarkSeaGreen
  "North America": "#BA55D3", // MediumOrchid
  "Oceania": "#1E90FF",       // DodgerBlue
  "South America": "#FFA500", // Orange
  "Antarctica": "#B0E0E6"     // PowderBlue
};
export async function getStaticPaths() { return getI18nPaths(); }
const { lang = 'en' } = Astro.params;
const t = useTranslations(lang);
const basePath = `/${lang}/countries`;
const countries = Object.values(countriesData);
const data = countries.map(c => {
  const mledoze = getMledozeData(c.code);
  return {
    code: c.code,
    name: getCountryName(c.code, lang),
    native: c.native,
    capital: c.capital || '—',
    continent: c.continent,
    population: c.population,
    id: c.code.toLowerCase(),
    displayName: getCountryName(c.code, lang),
    neighbor_count: mledoze?.borders?.length || 0,
    continents: [c.continent],
  };
});

const links: any[] = [];
const processedPairs = new Set();

countries.forEach(c => {
  const mledoze = getMledozeData(c.code);
  if (mledoze?.borders) {
    mledoze.borders.forEach(neighborCca3 => {
      const neighborMledoze = getMledozeData(neighborCca3);
      if (neighborMledoze) {
        const source = c.code.toLowerCase();
        const target = neighborMledoze.cca2.toLowerCase();
        const pairId = [source, target].sort().join('-');
        if (!processedPairs.has(pairId) && countriesData[neighborMledoze.cca2.toUpperCase()]) {
          links.push({ source, target });
          processedPairs.add(pairId);
        }
      }
    });
  }
});

const graphData = { nodes: data, links };
const enrichedData = data.map(item => ({
  ...item,
  continentColor: continentColors[item.continent] || "#ccc"
}));

const columns = [
  { key: 'code',      label: t('world.stats.code'),      type: 'code' },
  { key: 'name',      label: t('world.stats.name'),      type: 'country' },
  { key: 'native',    label: t('world.stats.native'),    type: 'text', isMono: true },
  { key: 'capital',   label: t('world.stats.capital'),   type: 'text' },
  { key: 'continent', label: t('world.stats.continent'), type: 'continent' },
  { key: 'population',label: t('world.stats.population'), isNumeric: true }
];

// Možnosti filtru (Kontinenty)
const filterOptions = Array.from(new Set(data.map(c => c.continent))).sort().map(f => ({
  label: f,
  value: f.toLowerCase(),
  count: data.filter(d => d.continent === f).length,
  color: continentColors[f] || "#ccc" // Předání barvy do WideLayoutu
}));

const viewOptions = [
    { id: 'table',   label: 'Table',   icon: 'fa-solid fa-table' },
    { id: 'grid',    label: 'Grid',    icon: 'fa-solid fa-grip'  },
    { id: 'net',     label: 'Net',     icon: 'lucide:network'    },
    { id: 'map',     label: 'Map',     icon: 'fa-solid fa-map'   },
    { id: 'globe',   label: 'Globe',   icon: 'fa-solid fa-globe' },
    { id: 'flags',   label: 'Flags',   icon: 'fa-solid fa-flag'  },
    { id: 'orbicon', label: 'Orbicon', icon: 'fa-solid fa-bomb'  }
];

const exportOptions = [
    { id: 'json', label: 'JSON Data',   extension: '.json', icon: 'fa-solid fa-file-code' },
    { id: 'xml',  label: 'XML  Feed',   extension: '.xml',  icon: 'fa-solid fa-file-export' },
    { id: 'yaml', label: 'YAML Config', extension: '.yaml', icon: 'fa-solid fa-file-lines' },
    { id: 'csv',  label: 'CSV  Config', extension: '.yaml', icon: 'fa-solid fa-file-csv' }
];
---

<WideLayout 
  title={lang === 'cs' ? "Státy" : "Countries"}
  searchPlaceholder={lang === 'cs' ? "Hledat..." : "Search..."}
  filterLabel={lang === 'cs' ? "Kontinenty" : "Continents"}
  allLabel={lang === 'cs' ? "Všechny Státy" : "All Countries"}
  mainIcon="fa-solid fa-globe"
  filterOptions={filterOptions}
  viewOptions={viewOptions}
  exportOptions={exportOptions}
  accentColor="#10b981"
>
<ViewGrid slot="grid" data={enrichedData} columns={columns} basePath={basePath} />
<ViewNet slot="net" graphData={{nodes: enrichedData, links}} basePath={basePath} />
<ViewTable 
  id="countriesTable"
  data={enrichedData}
  columns={columns}
  basePath={basePath}
  lang={lang} 
  slot="table"
/>

</WideLayout>

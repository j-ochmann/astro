---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getI18nPaths, countriesData, getAllContinents, useTranslations } from '@/content/config/i18n';

export async function getStaticPaths() {
  return getI18nPaths();
}

const { lang } = Astro.params;
const t = useTranslations(lang); // Inicializace překladače

const continents = getAllContinents();
const allCountries = Object.values(countriesData).sort((a, b) => a.name.localeCompare(b.name));

// Dynamické sestavení klíče pro kontinent
const getContinentLabel = (name: string) => {
  const key = `geo.continent.${name.toLowerCase().replace(/\s+/g, '-')}` as any;
  return t(key) || name;
};

const headings = continents.map(continent => ({
  depth: 2,
  slug: continent.toLowerCase().replace(/\s+/g, '-'),
  text: getContinentLabel(continent)
}));
---

<StarlightPage 
  frontmatter={{ title: t('atlas.title'), template: 'doc' }}
  headings={headings}
>
  <div class="country-grid-container">
    {continents.map(continent => (
      <section>
        <h2 id={continent.toLowerCase().replace(/\s+/g, '-')}>
          {getContinentLabel(continent)}
        </h2>
        <div class="country-grid">
          {/* ... zbytek mapování zemí ... */}
        </div>
      </section>
    ))}
  </div>
</StarlightPage>

---
import WideLayout from '@/components/root/layout/Wide.astro';
import ViewFlags from '@/components/root/view/Flags.astro';
import ViewGlobe from '@/components/root/view/Globe.astro';
import ViewGrid from '@/components/root/view/Grid.astro';
import ViewMap from '@/components/root/view/Map.astro';
import ViewNet from '@/components/root/view/Net.astro';
import ViewOrbs from '@/components/root/view/Orbs.astro';
import ViewTable from '@/components/root/view/Table.astro';
import { 
  getI18nPaths, 
  countriesData, 
  useTranslations, 
  getMledozeData, 
  getCountryName 
} from '@/content/config/i18n';

export async function getStaticPaths() { return getI18nPaths(); }
const { lang = 'en' } = Astro.params;
const t = useTranslations(lang);
const basePath = `/${lang}/countries`;

const countries = Object.values(countriesData);

// 1. Transformace dat pro Nodes (uzly) a základní seznam
const data = countries.map(c => {
  const mledoze = getMledozeData(c.code);
  return {
    code: c.code,
    name: getCountryName(c.code, lang),
    native: c.native,
    capital: c.capital || '—',
    continent: c.continent,
    population: c.population,
    // Data specifická pro graf
    id: c.code.toLowerCase(),
    displayName: getCountryName(c.code, lang),
    neighbor_count: mledoze?.borders?.length || 0,
    continents: [c.continent],
  };
});

// 2. Transformace dat pro Links (propojení v grafu)
const links: any[] = [];
const processedPairs = new Set();

countries.forEach(c => {
  const mledoze = getMledozeData(c.code);
  if (mledoze?.borders) {
    mledoze.borders.forEach(neighborCca3 => {
      const neighborMledoze = getMledozeData(neighborCca3);
      if (neighborMledoze) {
        const source = c.code.toLowerCase();
        const target = neighborMledoze.cca2.toLowerCase();
        const pairId = [source, target].sort().join('-');
        
        // Přidáme link pouze pokud cílová země existuje v našem seznamu a pár ještě nebyl zpracován
        if (!processedPairs.has(pairId) && countriesData[neighborMledoze.cca2.toUpperCase()]) {
          links.push({ source, target });
          processedPairs.add(pairId);
        }
      }
    });
  }
});

const graphData = { nodes: data, links };

// 3. Definice sloupců pro tabulku
const columns = [
  { key: 'code', label: 'Code', isMono: true },
  { key: 'name', label: 'Country' },
  { key: 'native', label: 'Native', isNative: true },
  { key: 'capital', label: 'Capital' },
  { key: 'continent', label: 'Continent' },
  { key: 'population', label: 'Population', isNumeric: true }
];

// 4. Možnosti filtru (Kontinenty)
const filterOptions = Array.from(new Set(data.map(c => c.continent))).sort().map(f => ({
  label: f,
  value: f.toLowerCase(),
  count: data.filter(d => d.continent === f).length
}));

const viewOptions = [
    { id: 'grid',  label: 'Grid',  icon: 'fa-solid fa-grip' },
    { id: 'net',   label: 'Net',   icon: 'fa-solid fa-circle-nodes' },
    { id: 'table', label: 'Table', icon: 'fa-solid fa-table' }
];

const exportOptions = [
    { id: 'json', label: 'JSON', extension: '.json', icon: 'fa-solid fa-file-code' },
    { id: 'csv', label: 'CSV', extension: '.csv', icon: 'fa-solid fa-file-csv' }
];
---

<WideLayout 
  title={lang === 'cs' ? "Země světa" : "Countries"}
  searchPlaceholder={lang === 'cs' ? "Hledat zemi..." : "Search country..."}
  filterLabel={lang === 'cs' ? "Kontinenty" : "Continents"}
  filterOptions={filterOptions}
  viewOptions={viewOptions}
  exportOptions={exportOptions}
  accentColor="#10b981"
>
  <ViewGrid slot="grid" data={data} columns={columns} basePath={basePath} />
  <ViewNet slot="net" graphData={graphData} basePath={basePath} />
  <ViewTable slot="table" data={data} columns={columns} basePath={basePath} lang={lang} />
</WideLayout>

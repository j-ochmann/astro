---
import TabGridLayout from '@/components/root/TabGridLayout.astro';
import { getI18nPaths, countriesData, useTranslations } from '@/content/config/i18n';

export async function getStaticPaths() { return getI18nPaths(); }
const { lang } = Astro.params;
const t = useTranslations(lang);

// Transformace dat
const data = Object.values(countriesData).map(c => ({
  code: c.code,
  name: lang === 'cs' ? (t(c.code as any) !== c.code ? t(c.code as any) : c.name) : c.name,
  native: c.native,
  capital: c.capital || '—',
  continent: c.continent,
  population: c.population,
}));

// Definice sloupců
const columns = [
  { key: 'code', label: 'Code', isMono: true },
  { key: 'name', label: 'Country' },
  { key: 'native', label: 'Native', isNative: true },
  { key: 'capital', label: 'Capital' },
  { key: 'continent', label: 'Continent' },
  { key: 'population', label: 'Population', isNumeric: true }
];

// Možnosti filtru
const filterOptions = Array.from(new Set(data.map(c => c.continent))).sort().map(f => ({
  label: f,
  value: f.toLowerCase(),
  count: data.filter(d => d.continent === f).length
}));
---

<TabGridLayout 
  title="Global Atlas"
  data={data}
  columns={columns}
  lang={lang}
  basePath={`/${lang}/countries`}
  accentColor="#10b981"
  filterLabel="Continents"
  filterOptions={filterOptions}
  searchPlaceholder="Find anything..."
  viewOptions={[
    { id: 'table', label: 'Classic Table', icon: 'fa-table' },
    { id: 'grid', label: 'Photo Grid', icon: 'fa-grip' },
    { id: 'map', label: 'Interactive Map', icon: 'fa-map-location-dot' }
  ]}
  exportOptions={[
    { id: 'json', label: 'JSON Data', extension: '.json', icon: 'fa-code' },
    { id: 'xml', label: 'XML Feed', extension: '.xml', icon: 'fa-file-export' },
    { id: 'yaml', label: 'YAML Config', extension: '.yaml', icon: 'fa-lines-leaning' }
  ]}
/>

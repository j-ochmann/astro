---
// src/pages/[lang]/countries/index.astro
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import SearchFilterBar from '@/components/root/SearchFilterBar.astro';
import { Icon } from 'astro-icon/components';
import { 
  getI18nPaths, 
  countriesData, 
  useTranslations, 
  getCurrencyLabel, 
  getLanguageLabel 
} from '@/content/config/i18n';

export async function getStaticPaths() {
  return getI18nPaths();
}

const { lang } = Astro.params;
const t = useTranslations(lang);

const allCountriesRaw = Object.values(countriesData).map(c => ({
  code: c.code,
  name: lang === 'cs' ? (t(c.code as any) !== c.code ? t(c.code as any) : c.name) : c.name,
  capital: c.capital || '—',
  continent: c.continent,
  population: c.population,
  phone: c.phone.map(p => `+${p}`).join(', '),
  native: c.native,
  currency: c.currency?.map(curr => getCurrencyLabel(curr, lang)).join(', ') || '—',
  languages: c.language?.map(l => getLanguageLabel(l, lang)).join(', ') || '—'
}));

const continentList = Array.from(new Set(allCountriesRaw.map(c => c.continent))).sort();
const filterOptions = continentList.map(cont => ({
  label: cont,
  value: cont.toLowerCase(),
  count: allCountriesRaw.filter(c => c.continent === cont).length
}));
---

<StarlightPage 
  frontmatter={{ 
    title: String(t('countries.title')),
    tableOfContents: false 
  }}
>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

  <div class="atlas-container">
    <header class="atlas-header">
       <h1>{t('countries.title')}</h1>
    </header>

    <SearchFilterBar 
      searchPlaceholder={String(t('countries.search'))}
      filterLabel="Continents"
      filterOptions={filterOptions}
      viewLabel="View"
      downloadLabel="Export Data"
    />

    <div id="view-table" class="view-section active">
      <div class="table-wrapper glass-panel">
        <table id="countriesTable">
          <thead>
            <tr>
              <th data-sort="code">Code <Icon name="lucide:arrow-up-down" /></th>
              <th data-sort="name">Country <Icon name="lucide:arrow-up-down" /></th>
              <th data-sort="capital">Capital <Icon name="lucide:arrow-up-down" /></th>
              <th data-sort="continent">Continent <Icon name="lucide:arrow-up-down" /></th>
              <th data-sort="population">Population <Icon name="lucide:arrow-up-down" /></th>
            </tr>
          </thead>
          <tbody id="tableBody">
            {allCountriesRaw.map(c => (
              <tr class="item-row table-row" data-country={JSON.stringify(c)} data-category={c.continent.toLowerCase()}>
                <td class="mono">{c.code}</td>
                <td>
                  <a href={`/${lang}/countries/${c.code.toLowerCase()}/`} class="country-link">
                    <span class:list={['fi', `fi-${c.code.toLowerCase()}`]}></span> {c.name}
                  </a>
                </td>
                <td>{c.capital}</td>
                <td>{c.continent}</td>
                <td class="mono">{c.population.toLocaleString(lang)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <div id="view-grid" class="view-section">
      <div class="grid-wrapper" id="gridContainer">
        {allCountriesRaw.map(c => (
          <div class="country-card glass-panel item-row grid-card" data-country={JSON.stringify(c)} data-category={c.continent.toLowerCase()}>
            <div class="card-header">
              <span class:list={['fi', `fi-${c.code.toLowerCase()}`, 'flag-large']}></span>
              <span class="card-code">{c.code}</span>
            </div>
            <h3>{c.name}</h3>
            <div class="card-meta">
              <div class="meta-item"><span>Capital:</span> <strong>{c.capital}</strong></div>
              <div class="meta-item"><span>Pop:</span> <strong>{c.population.toLocaleString(lang)}</strong></div>
            </div>
            <a href={`/${lang}/countries/${c.code.toLowerCase()}/`} class="card-link">View Detail</a>
          </div>
        ))}
      </div>
    </div>
  </div>
</StarlightPage>

<style is:global>
  /* Skrytí původního H1 a postranního ToC (vpravo), ale zachování levého sidebaru */
  [data-has-sidebar] header h1 { display: none !important; }
  .right-sidebar { display: none !important; }
  
  .dynamic-accent {
    --accent-color: #3b82f6 !important;
    --accent-bg: rgba(59, 130, 246, 0.15) !important;
    --accent-border: rgba(59, 130, 246, 0.4) !important;
  }
</style>

<style>
  .atlas-container { width: 100%; margin-top: -1.5rem; }
  .atlas-header { margin-bottom: 2rem; border-bottom: 1px solid var(--sl-color-gray-5); padding-bottom: 1.5rem; }
  .atlas-header h1 { display: block !important; font-size: 2.5rem !important; color: var(--sl-color-white) !important; margin: 0 !important; }
  .atlas-subtitle { color: var(--sl-color-gray-3); margin-top: 0.5rem; }

  /* Glass Panel & Theme Fixes */
  .glass-panel {
    background: rgba(20, 20, 25, 0.5);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
  }

  :global([data-theme="light"]) .glass-panel {
    background: rgba(255, 255, 255, 0.7);
    border-color: var(--sl-color-gray-4);
    color: var(--sl-color-gray-1);
  }

  /* Table View */
  .view-section { display: none; }
  .view-section.active { display: block; }
  .table-wrapper { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 0.9rem; margin: 0; }
  th { background: var(--sl-color-gray-6); padding: 1rem; text-align: left; cursor: pointer; border-bottom: 2px solid var(--sl-color-gray-5); transition: background 0.2s; }
  th:hover { background: var(--sl-color-gray-5); }
  td { padding: 0.85rem 1rem; border-bottom: 1px solid var(--sl-color-gray-6); }
  .country-link { display: inline-flex; align-items: center; gap: 0.6rem; color: var(--sl-color-text-accent) !important; text-decoration: none !important; font-weight: 500; }

  /* Grid View */
  .grid-wrapper {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.5rem;
  }
  .country-card { padding: 1.5rem; transition: all 0.2s; position: relative; }
  .country-card:hover { transform: translateY(-4px); border-color: #3b82f6; box-shadow: 0 10px 20px rgba(0,0,0,0.2); }
  .flag-large { font-size: 1.8rem; }
  .card-code { font-family: var(--sl-font-mono); font-size: 0.75rem; background: var(--sl-color-gray-5); padding: 0.2rem 0.5rem; border-radius: 4px; }
  .country-card h3 { margin: 1rem 0 !important; font-size: 1.2rem !important; color: var(--sl-color-white) !important; }
  :global([data-theme="light"]) .country-card h3 { color: var(--sl-color-black) !important; }
  .card-meta { font-size: 0.8rem; margin-bottom: 1.5rem; }
  .meta-item { display: flex; justify-content: space-between; border-bottom: 1px solid var(--sl-color-gray-6); padding: 0.4rem 0; }
  .card-link { display: block; text-align: center; background: #3b82f6; color: white !important; text-decoration: none !important; padding: 0.6rem; border-radius: 0.5rem; font-size: 0.8rem; font-weight: bold; }

  .mono { font-family: var(--sl-font-mono); color: #3b82f6; font-weight: 600; }
</style>

<script>
  function initAtlas() {
    const searchInput = document.getElementById('searchTab') as HTMLInputElement;
    const tableBody = document.getElementById('tableBody');
    const itemRows = Array.from(document.querySelectorAll('.item-row'));
    let activeCategory = "";

    const filterRows = () => {
      const term = searchInput?.value.toLowerCase() || "";
      itemRows.forEach(row => {
        const text = (row as HTMLElement).innerText.toLowerCase();
        const cat = row.getAttribute('data-category') || "";
        const matchesSearch = text.includes(term);
        const matchesCat = activeCategory === "" || cat === activeCategory;
        (row as HTMLElement).style.display = (matchesSearch && matchesCat) ? '' : 'none';
      });
    };

    searchInput?.addEventListener('input', filterRows);

    // Dropdown Toggles
    document.querySelectorAll('.dropdown').forEach(dropdown => {
      dropdown.querySelector('button')?.addEventListener('click', (e) => {
        e.stopPropagation();
        const menu = dropdown.querySelector('.dropdown-content');
        document.querySelectorAll('.dropdown-content').forEach(m => m !== menu && m.classList.remove('show'));
        menu?.classList.toggle('show');
      });
    });

    window.addEventListener('click', () => {
      document.querySelectorAll('.dropdown-content').forEach(m => m.classList.remove('show'));
    });

    // Continent Filter
    document.querySelectorAll('.cat-item').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.cat-item').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        activeCategory = btn.getAttribute('data-cat') || "";
        const btnText = document.querySelector('#catBtn .btn-text');
        if (btnText) btnText.textContent = (btn as HTMLElement).querySelector('.item-label')?.textContent || "Continent";
        filterRows();
      });
    });

    // View Switcher
    document.querySelectorAll('.view-item').forEach(btn => {
      btn.addEventListener('click', () => {
        const view = btn.getAttribute('data-view');
        document.querySelectorAll('.view-item').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        document.querySelectorAll('.view-section').forEach(sec => {
          sec.classList.toggle('active', sec.id === `view-${view}`);
        });
      });
    });

    // TABLE SORTING (Fixed Logic)
    const tableHeaders = document.querySelectorAll('#countriesTable th[data-sort]');
    tableHeaders.forEach(th => {
      th.addEventListener('click', () => {
        const col = th.getAttribute('data-sort');
        const isAsc = th.classList.contains('asc');
        const rows = Array.from(tableBody?.querySelectorAll('.table-row') || []);

        const sortedRows = rows.sort((a, b) => {
          const dataA = JSON.parse(a.getAttribute('data-country') || '{}');
          const dataB = JSON.parse(b.getAttribute('data-country') || '{}');
          const valA = dataA[col || ''];
          const valB = dataB[col || ''];
          
          if (typeof valA === 'number') return isAsc ? valB - valA : valA - valB;
          return isAsc ? String(valB).localeCompare(String(valA)) : String(valA).localeCompare(String(valB));
        });

        tableHeaders.forEach(h => h.classList.remove('asc', 'desc'));
        th.classList.toggle('asc', !isAsc);
        th.classList.toggle('desc', isAsc);
        tableBody?.append(...sortedRows);
      });
    });

    // Simple Export
    document.querySelectorAll('.export-item').forEach(btn => {
      btn.addEventListener('click', () => {
        const visibleData = itemRows
          .filter(r => (r as HTMLElement).style.display !== 'none' && r.classList.contains('table-row'))
          .map(r => JSON.parse(r.getAttribute('data-country') || '{}'));
        
        const blob = new Blob([JSON.stringify(visibleData, null, 2)], { type: 'application/json' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = `export.json`;
        a.click();
      });
    });
  }

  window.addEventListener('load', initAtlas);
  document.addEventListener('astro:after-swap', initAtlas);
</script>

---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getI18nPaths, countriesData, getAllLanguages, languages, useTranslations } from '@/content/config/i18n';

export async function getStaticPaths() {
  return getI18nPaths();
}

const { lang } = Astro.params;
const t = useTranslations(lang);

// Získat všechny unikátní jazyky používané v zemích
const allUsedLanguages = getAllLanguages();
const allCountries = Object.values(countriesData);

// Připravit data: Jazyk -> Seznam zemí
const languageGroups = allUsedLanguages.map(langCode => {
  // Najít metadata o jazyku (název, label)
  const langMeta = languages[langCode as keyof typeof languages];
  const label = langMeta ? (langMeta.label || langMeta.en) : langCode;
  
  // Najít země, které tímto jazykem mluví
  const speakers = allCountries.filter(c => c.language && c.language.includes(langCode));
  
  // Seřadit země podle lokalizovaného názvu
  speakers.sort((a, b) => {
    const nameA = t(a.code) !== a.code ? t(a.code) : a.name;
    const nameB = t(b.code) !== b.code ? t(b.code) : b.name;
    return nameA.localeCompare(nameB, lang);
  });

  return {
    code: langCode,
    label,
    countries: speakers
  };
}).sort((a, b) => a.label.localeCompare(b.label, lang)); // Seřadit jazyky abecedně

---

<StarlightPage 
  frontmatter={{ 
    title: String(t('geo.nav.languages') || 'Jazyky'), 
    template: 'doc',
    description: 'Přehled jazyků a zemí, kde se jimi hovoří.'
  }}
>
  <div class="languages-list">
    {languageGroups.map(group => (
      <section class="lang-group">
        <h2 id={group.code}>{group.label} <span class="code">({group.code})</span></h2>
        <div class="country-grid">
          {group.countries.map(country => {
            const displayName = t(country.code) !== country.code ? t(country.code) : country.name;
            return (
              <a href={`/${lang}/countries/${country.code.toLowerCase()}/`} class="country-card">
                <span class:list={['fi', `fi-${country.code.toLowerCase()}`]}></span>
                <span class="name">{displayName}</span>
              </a>
            );
          })}
        </div>
      </section>
    ))}
  </div>
</StarlightPage>

<style>
  .lang-group { margin-bottom: 3rem; }
  h2 { border-bottom: 1px solid var(--sl-color-hairline); padding-bottom: 0.5rem; margin-bottom: 1rem; }
  .code { font-size: 0.6em; color: var(--sl-color-gray-3); font-weight: normal; vertical-align: middle; }
  
  .country-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 0.75rem;
  }
  .country-card {
    display: flex; align-items: center; gap: 0.75rem; padding: 0.5rem 0.75rem;
    background: var(--sl-color-gray-6); border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem; text-decoration: none; color: var(--sl-color-white) !important;
    transition: all 0.2s ease; font-size: 0.9rem;
  }
  .country-card:hover { background: var(--sl-color-gray-5); border-color: var(--sl-color-accent); transform: translateY(-2px); }
  .fi { flex-shrink: 0; }
</style>

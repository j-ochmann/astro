---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { 
  getI18nPaths, 
  getCountryName, 
  countriesData, 
  getMledozeData 
} from '@/content/config/i18n';

export async function getStaticPaths() {
  return getI18nPaths();
}

const { lang = 'en' } = Astro.params;

const countries = Object.values(countriesData);

const nodes = countries.map(c => {
  const mledoze = getMledozeData(c.code);
  return {
    id: c.code.toLowerCase(),
    displayName: getCountryName(c.code, lang),
    neighbor_count: mledoze?.borders?.length || 0,
    continents: [c.continent],
    url: `/${lang}/countries/${c.code.toLowerCase()}`
  };
});

const links: any[] = [];
const processedPairs = new Set();

countries.forEach(c => {
  const mledoze = getMledozeData(c.code);
  if (mledoze?.borders) {
    mledoze.borders.forEach(neighborCca3 => {
      const neighborMledoze = getMledozeData(neighborCca3);
      if (neighborMledoze) {
        const source = c.code.toLowerCase();
        const target = neighborMledoze.cca2.toLowerCase();
        const pairId = [source, target].sort().join('-');
        
        if (!processedPairs.has(pairId) && countriesData[neighborMledoze.cca2.toUpperCase()]) {
          links.push({ source, target });
          processedPairs.add(pairId);
        }
      }
    });
  }
});

const localizedGraphData = { nodes, links };

const translations = {
  cs: { title: "Graf sousedství", africa: "Afrika", asia: "Asie", europe: "Evropa", na: "S. Amerika", oceania: "Austrálie", sa: "J. Amerika", multi: "Mezi" },
  en: { title: "Country Graph", africa: "Africa", asia: "Asia", europe: "Europe", na: "N. America", oceania: "Oceania", sa: "S. America", multi: "Multi" }
} as const;

const t = translations[lang as keyof typeof translations] || translations.en;
---

<StarlightPage frontmatter={{ title: t.title, template: 'doc' }}>
  <div class="graph-container">
    <svg class="legend" width="100%" height="50" viewBox="0 0 960 40" preserveAspectRatio="xMidYMid meet">
        <g transform="translate(10,20)"><circle fill="#FF6347" r="5"></circle><text dx="12" dy="4" class="legendlabel">Africa</text></g>
        <g transform="translate(120,20)"><circle fill="#DCDCDC" r="5"></circle><text dx="12" dy="4" class="legendlabel">Asia</text></g>
        <g transform="translate(230,20)"><circle fill="#8FBC8F" r="5"></circle><text dx="12" dy="4" class="legendlabel">Europe</text></g>
        <g transform="translate(350,20)"><circle fill="#BA55D3" r="5"></circle><text dx="12" dy="4" class="legendlabel">N. America</text></g>
        <g transform="translate(480,20)"><circle fill="#1E90FF" r="5"></circle><text dx="12" dy="4" class="legendlabel">Oceania</text></g>
        <g transform="translate(600,20)"><circle fill="#FFA500" r="5"></circle><text dx="12" dy="4" class="legendlabel">S. America</text></g>
    </svg>
    <div id="canvas-wrapper"><svg id="main-graph"></svg></div>
  </div>
</StarlightPage>

<style is:global>
  #canvas-wrapper { border: 1px solid var(--sl-color-gray-5); background: var(--sl-color-gray-6); border-radius: 8px; overflow: hidden; }
  #main-graph { display: block; width: 100%; height: 600px; cursor: move; }
  .links line { stroke: var(--sl-color-gray-4); stroke-opacity: 0.3; stroke-width: 1.5px; }
  .node circle { stroke: #000; stroke-width: 1px; cursor: pointer; }
  .node text { display: none; font: 11px sans-serif; fill: var(--sl-color-text); pointer-events: none; }
  .node:hover text { display: inline; }
  .legendlabel { font: 12px sans-serif; fill: var(--sl-color-text); }
</style>

<script is:inline src="https://d3js.org/d3.v4.min.js"></script>
<script is:inline define:vars={{ localizedGraphData }}>
  function initGraph() {
    var width = 960, height = 600;
    var graph = localizedGraphData;
    var svg = d3.select("#main-graph").attr("viewBox", `0 0 ${width} ${height}`);
    var g = svg.append("g");

    var simulation = d3.forceSimulation()
        .force("link", d3.forceLink().id(d => d.id).distance(40))
        .force("charge", d3.forceManyBody().strength(-60))
        .force("center", d3.forceCenter(width / 2, height / 2))
        .force("collide", d3.forceCollide(d => 10 + d.neighbor_count));

    svg.call(d3.zoom().on("zoom", () => g.attr("transform", d3.event.transform)));

    var colorMapping = { "Africa": "#FF6347", "Asia": "#DCDCDC", "Europe": "#8FBC8F", "North America": "#BA55D3", "Oceania": "#1E90FF", "South America": "#FFA500" };

    var link = g.append("g").attr("class", "links").selectAll("line").data(graph.links).enter().append("line");
    var node = g.append("g").attr("class", "nodes").selectAll(".node").data(graph.nodes).enter().append("g")
        .attr("class", "node")
        .on("click", d => { window.location.href = d.url; })
        .on("mouseover", highlightStart)
        .on("mouseout", highlightEnd)
        .call(d3.drag().on("start", dragstarted).on("drag", dragged).on("end", dragended));

    node.append("circle").attr("r", d => 5 + (d.neighbor_count/2)).attr("fill", d => colorMapping[d.continents[0]] || "#ccc");
    var label = node.append("text").attr("dy", ".35em").attr("x", 12).text(d => d.displayName);

    function highlightStart(d) {
        var adj = {};
        graph.links.forEach(l => {
            adj[l.source.id + "-" + l.target.id] = true;
            adj[l.target.id + "-" + l.source.id] = true;
        });
        node.style("stroke-opacity", n => (n.id === d.id || adj[d.id + "-" + n.id]) ? 1 : 0.1)
            .attr("fill-opacity", n => (n.id === d.id || adj[d.id + "-" + n.id]) ? 1 : 0.1);
        link.style("stroke-opacity", l => (l.source.id === d.id || l.target.id === d.id) ? 1 : 0.1);
        label.filter(n => n.id === d.id || adj[d.id + "-" + n.id]).style("display", "inline");
    }

    function highlightEnd() {
        node.style("stroke-opacity", 1).attr("fill-opacity", 1);
        link.style("stroke-opacity", 0.3);
        label.style("display", "none");
    }

    simulation.nodes(graph.nodes).on("tick", () => {
        link.attr("x1", d => d.source.x).attr("y1", d => d.source.y).attr("x2", d => d.target.x).attr("y2", d => d.target.y);
        node.attr("transform", d => `translate(${d.x},${d.y})`);
    });
    simulation.force("link").links(graph.links);

    function dragstarted(d) { if (!d3.event.active) simulation.alphaTarget(0.3).restart(); d.fx = d.x; d.fy = d.y; }
    function dragged(d) { d.fx = d3.event.x; d.fy = d3.event.y; }
    function dragended(d) { if (!d3.event.active) simulation.alphaTarget(0); d.fx = null; d.fy = null; }
  }
  initGraph();
</script>

---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { 
  countriesData, 
  locales, 
  useTranslations, 
  getCurrencyLabel, 
  getLanguageLabel 
} from '@/content/config/i18n';

export async function getStaticPaths() {
  const paths = [];
  const langs = Object.keys(locales);
  const countries = Object.values(countriesData);

  for (const lang of langs) {
    for (const country of countries) {
      paths.push({
        params: { lang, code: country.code.toLowerCase() },
        props: { country, lang }
      });
    }
  }
  return paths;
}

const { country, lang } = Astro.props;
const t = useTranslations(lang);

// Logika pro sousední země (příprava)
const neighbors = country.borders?.map(code => countriesData[code as keyof typeof countriesData]).filter(Boolean) || [];

// Logika pro navigaci
const allCountryCodes = Object.keys(countriesData).sort();
const currentIndex = allCountryCodes.indexOf(country.code);
const prevCode = allCountryCodes[currentIndex - 1];
const nextCode = allCountryCodes[currentIndex + 1];

const countryCodeUpper = country.code.toUpperCase();
const translation = t(countryCodeUpper as any);
const localizedName = (translation && translation !== countryCodeUpper) ? translation : country.name;
const continentKey = `geo.continent.${country.continent.toLowerCase().replace(/\s+/g, '-')}` as any;

// Odkaz na Wikipedii
const wikipediaUrl = `https://${lang}.wikipedia.org/wiki/${encodeURIComponent(localizedName)}`;
---

<StarlightPage frontmatter={{ 
  title: String(localizedName || 'Country'),
  template: 'doc'
}}>

  <div class="country-hero">
    <div class="names-stack">
      <p class="native-name">
        <strong>{t('geo.stats.native') || 'Native'}:</strong> 
        <span class="native-value">{country.native}</span>
      </p>
      {lang === 'cs' && (
        <p class="secondary-name">
          <strong>English Name:</strong> {country.name}
        </p>
      )}
      <p class="code-line">
        <strong>ISO Code:</strong> <span class="mono">{country.code}</span>
      </p>
      <a href={wikipediaUrl} target="_blank" rel="noopener noreferrer" class="wiki-link">
         Wikipedia ↗
      </a>
    </div>
    <div class="flag-container">
      <span class:list={['fi', `fi-${country.code.toLowerCase()}`, 'large-flag']}></span>
    </div>
  </div>

  <div class="stats-grid">
    <div class="stats-card">
      <h3>{t('geo.detail.basicInfo') || 'Základní informace'}</h3>
      <ul>
        <li><strong>{t('geo.stats.capital') || 'Capital'}:</strong> <span>{country.capital ?? '—'}</span></li>
        <li><strong>{t('geo.stats.population') || 'Population'}:</strong> <span>{country.population.toLocaleString(lang)}</span></li>
        <li><strong>{t('geo.stats.continent') || 'Continent'}:</strong> <span>{t(continentKey) || country.continent}</span></li>
        <li><strong>{t('geo.stats.phone') || 'Phone'}:</strong> <span>{country.phone.map(p => `+${p}`).join(', ')}</span></li>
      </ul>
    </div>

    <div class="stats-card">
      <h3>{t('geo.detail.local') || 'Měna a jazyky'}</h3>
      <ul>
        <li>
          <strong>{t('geo.stats.currency') || 'Currency'}:</strong> 
          <div class="list-tags">
            {country.currency?.map(c => (
              <a href={`/${lang}/currencies/${c.toLowerCase()}/`} class="tag">{getCurrencyLabel(c, lang)}</a>
            )) ?? '—'}
          </div>
        </li>
        <li>
          <strong>{t('geo.stats.languages') || 'Languages'}:</strong> 
          <div class="list-tags">
            {country.language?.map(l => (
              <a href={`/${lang}/languages/${l.toLowerCase()}/`} class="tag">{getLanguageLabel(l, lang)}</a>
            )) ?? '—'}
          </div>
        </li>
      </ul>
    </div>
  </div>

  {neighbors.length > 0 && (
    <div class="neighbors-section">
      <h3>{lang === 'cs' ? 'Sousední země' : 'Neighboring Countries'}</h3>
      <div class="neighbor-grid">
        {neighbors.map(n => (
          <a href={`/${lang}/countries/${n.code.toLowerCase()}/`} class="neighbor-link">
            <span class:list={['fi', `fi-${n.code.toLowerCase()}`]}></span>
            <span class="neighbor-name">{t(n.code as any) || n.name}</span>
          </a>
        ))}
      </div>
    </div>
  )}

  <div class="nav-grid">
    {prevCode ? (
      <a href={`/${lang}/countries/${prevCode.toLowerCase()}/`} class="nav-item prev">
        <span class="nav-label">← {t('geo.nav.prev') || 'Předchozí'}</span>
        <span class="nav-title">{t(prevCode as any) || prevCode}</span>
      </a>
    ) : <div class="nav-empty" />}

    <a href={`/${lang}/countries/`} class="nav-item meta">
      <span class="nav-label">Grid</span>
      <span class="nav-title">Atlas</span>
    </a>

    <a href={`/${lang}/countries/table/`} class="nav-item meta">
      <span class="nav-label">Data</span>
      <span class="nav-title">Tabulka</span>
    </a>

    {nextCode ? (
      <a href={`/${lang}/countries/${nextCode.toLowerCase()}/`} class="nav-item next">
        <span class="nav-label">{t('geo.nav.next') || 'Další'} →</span>
        <span class="nav-title">{t(nextCode as any) || nextCode}</span>
      </a>
    ) : <div class="nav-empty" />}
  </div>

</StarlightPage>

<style>
  /* Fix uskakování */
  .stats-grid, .country-hero { margin-top: 0 !important; }

  .country-hero {
    display: flex; flex-direction: row; justify-content: space-between; align-items: flex-start;
    gap: 2rem; margin-bottom: 2.5rem; padding-bottom: 2rem; border-bottom: 1px solid var(--sl-color-hairline);
  }
  .names-stack { display: flex; flex-direction: column; gap: 0.5rem; flex: 1; }
  .native-name { font-size: 1.25rem; color: var(--sl-color-gray-2); margin: 0 !important; }
  .native-value { color: var(--sl-color-white); font-weight: 500; }
  .secondary-name, .code-line { font-size: 1rem; color: var(--sl-color-gray-3); margin: 0 !important; }
  .mono { font-family: var(--sl-font-mono); color: var(--sl-color-accent); font-weight: bold; }
  
  .wiki-link { 
    font-size: 0.85rem; color: var(--sl-color-accent-high) !important; 
    text-decoration: none; margin-top: 0.5rem; width: fit-content;
  }
  .wiki-link:hover { text-decoration: underline; }

  .large-flag { 
    display: block; width: 240px; height: auto; aspect-ratio: 4/3; 
    border: 1px solid var(--sl-color-gray-5); background-size: cover;
  }

  .stats-grid { 
    display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); 
    gap: 1.5rem; align-items: stretch; 
  }
  .stats-card { 
    margin-top: 0 !important; display: flex; flex-direction: column; 
    background: var(--sl-color-gray-6); padding: 1.5rem; 
    border: 1px solid var(--sl-color-hairline); border-radius: 4px; 
  }
  .stats-card h3 { 
    margin: 0 0 1rem 0 !important; font-size: 0.9rem; color: var(--sl-color-gray-2); 
    text-transform: uppercase; border-bottom: 1px solid var(--sl-color-gray-5); padding-bottom: 0.5rem; 
  }
  .stats-card ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1.25rem; }
  .stats-card li { display: flex; flex-direction: column; gap: 0.35rem; margin: 0 !important; }
  .stats-card strong { color: var(--sl-color-accent-high); font-size: 0.7rem; text-transform: uppercase; }

  .list-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.25rem; }
  .tag { 
    display: inline-block; background: var(--sl-color-gray-5); padding: 0.25rem 0.75rem; 
    font-size: 0.85rem; border-radius: 3px; color: var(--sl-color-white) !important; 
    text-decoration: none !important; transition: background 0.2s; 
  }
  .tag:hover { background: var(--sl-color-gray-4); }

  .neighbors-section { margin-top: 3rem; }
  .neighbors-section h3 { font-size: 0.9rem; text-transform: uppercase; color: var(--sl-color-gray-2); margin-bottom: 1rem !important; }
  .neighbor-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 0.75rem; }
  .neighbor-link { 
    display: flex; align-items: center; gap: 0.75rem; padding: 0.5rem; 
    background: var(--sl-color-gray-6); border: 1px solid var(--sl-color-hairline); 
    border-radius: 4px; text-decoration: none; color: inherit !important; font-size: 0.85rem;
  }

  .nav-grid { 
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; 
    margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--sl-color-hairline);
  }
  .nav-item { 
    display: flex; flex-direction: column; padding: 1rem; 
    border: 1px solid var(--sl-color-hairline); border-radius: 0.5rem; 
    text-decoration: none !important; transition: border-color 0.2s;
  }
  .nav-item:hover { border-color: var(--sl-color-accent); background: var(--sl-color-gray-6); }
  .nav-label { font-size: 0.7rem; color: var(--sl-color-gray-3); text-transform: uppercase; }
  .nav-title { font-weight: bold; color: var(--sl-color-accent-high); }
  .next { text-align: right; }
  .meta { text-align: center; }

  @media (max-width: 50rem) { 
    .country-hero { flex-direction: column-reverse; gap: 1.5rem; }
    .flag-container { width: 100%; }
    .large-flag { width: 100%; height: auto; }
    .nav-grid { grid-template-columns: 1fr 1fr; }
    .neighbor-grid { grid-template-columns: 1fr; }
  }
</style>

---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getTimezonesForCountry } from 'countries-and-timezones';
import { locales } from '@/content/config/i18n/locales';
import { 
  countriesData, 
  useTranslations, 
  getCurrencyLabel, 
  getLanguageLabel,
  getMledozeData,
  getCountryName,
  getNeighbors
} from '@/content/config/i18n';

// Povinný export pro dynamické trasy v Astro
export async function getStaticPaths() {
  const paths = [];
  const langs = Object.keys(locales);
  const countries = Object.values(countriesData);

  for (const lang of langs) {
    for (const country of countries) {
      paths.push({
        params: { lang, code: country.code.toLowerCase() },
        props: { country, lang }
      });
    }
  }
  return paths;
}

const { country, lang } = Astro.props;
const t = useTranslations(lang);

// Data z mledoze (přetypováno na any pro TS stabilitu)
const mledoze = getMledozeData(country.code) as any;
const neighbors = getNeighbors(country.code, lang);

// Časová pásma seřazená podle offsetu (posunu)
const countryTimezones = (getTimezonesForCountry(country.code.toUpperCase()) || [])
  .sort((a, b) => a.utcOffset - b.utcOffset);

// Navigace (Předchozí / Další)
const allCountryCodes = Object.keys(countriesData).sort();
const currentIndex = allCountryCodes.indexOf(country.code);
const prevCode = allCountryCodes[currentIndex - 1];
const nextCode = allCountryCodes[currentIndex + 1];

const localizedName = getCountryName(country.code, lang);
const continentKey = `geo.continent.${country.continent.toLowerCase().replace(/\s+/g, '-')}` as any;

const wikipediaUrl = `https://${lang}.wikipedia.org/wiki/${encodeURIComponent(localizedName)}`;
const googleMapsUrl = mledoze?.maps?.googleMaps || `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(country.name)}`;
const latlng = mledoze?.latlng ? `${mledoze.latlng[0]}°, ${mledoze.latlng[1]}°` : '—';
---

<StarlightPage frontmatter={{ title: String(localizedName), template: 'doc' }}>

  <div class="country-hero">
    <div class="names-stack">
      <p class="native-name">
        <strong>{t('world.stats.native') || 'Native'}:</strong> 
        <span class="native-value">{country.native}</span>
      </p>
      <div class="code-badges">
        <span class="badge">ISO <strong>{country.code}</strong></span>
        {mledoze?.cca3 && <span class="badge">ISO3 <strong>{mledoze.cca3}</strong></span>}
        {mledoze?.tld?.[0] && <span class="badge tld">TLD <strong>{mledoze.tld[0]}</strong></span>}
      </div>
      <div class="hero-links">
        <a href={wikipediaUrl} target="_blank" rel="noopener noreferrer" class="link-btn">Wikipedia ↗</a>
        <a href={googleMapsUrl} target="_blank" rel="noopener noreferrer" class="link-btn">Google Maps 📍</a>
      </div>
    </div>
    <div class="flag-container">
      <span class:list={['fi', `fi-${country.code.toLowerCase()}`, 'large-flag']}></span>
    </div>
  </div>

  <div class="stats-grid">
    <div class="stats-card">
      <h3>{t('world.detail.basicInfo') || 'Základní informace'}</h3>
      <ul>
        <li><strong>{t('world.stats.capital') || 'Capital'}:</strong> <span>{country.capital ?? '—'}</span></li>
        <li><strong>{t('world.stats.population') || 'Population'}:</strong> <span>{country.population.toLocaleString(lang)}</span></li>
        <li><strong>{t('world.stats.area') || 'Area'}:</strong> <span>{mledoze?.area ? `${mledoze.area.toLocaleString(lang)} km²` : '—'}</span></li>
        <li><strong>GPS:</strong> <span class="mono">{latlng}</span></li>
        <li><strong>{t('world.stats.continent') || 'Continent'}:</strong> <span>{t(continentKey) || country.continent}</span></li>
      </ul>
    </div>

    <div class="stats-card">
      <h3>{lang === 'cs' ? 'Místní časy' : 'Local Times'}</h3>
      <div class="timezone-wrapper">
        {countryTimezones.length > 0 ? (
          countryTimezones.map((tz) => (
            <div class="tz-entry live-clock" data-tz={tz.name}>
              <div class="tz-meta">
                <span class="tz-offset">{tz.utcOffsetStr}</span>
                <span class="tz-id">{tz.name.split('/').pop()?.replace(/_/g, ' ')}</span>
              </div>
              <div class="tz-time-row">
                <span class="clock-value">--:--:--</span>
              </div>
            </div>
          ))
        ) : (
          <p>No timezone data found.</p>
        )}
      </div>
    </div>

    <div class="stats-card">
      <h3>{t('world.detail.local') || 'Měna a jazyky'}</h3>
      <ul>
        <li>
          <strong>{t('world.stats.currency') || 'Currency'}:</strong> 
          <div class="list-tags">
            {country.currency?.map(c => (
              <a href={`/${lang}/currencies/${c.toLowerCase()}/`} class="tag">{getCurrencyLabel(c, lang)}</a>
            )) ?? '—'}
          </div>
        </li>
        <li>
          <strong>{t('world.stats.languages') || 'Languages'}:</strong> 
          <div class="list-tags">
            {country.language?.map(l => (
              <a href={`/${lang}/languages/${l.toLowerCase()}/`} class="tag">{getLanguageLabel(l, lang)}</a>
            )) ?? '—'}
          </div>
        </li>
      </ul>
    </div>
  </div>

  {neighbors.length > 0 && (
    <div class="neighbors-section">
      <h3>{lang === 'cs' ? 'Sousední země' : 'Neighboring Countries'}</h3>
      <div class="neighbor-grid">
        {neighbors.map(n => (
          <a href={`/${lang}/countries/${n.cca2.toLowerCase()}/`} class="neighbor-link">
            <span class:list={['fi', `fi-${n.cca2.toLowerCase()}`]}></span>
            <span class="neighbor-name">{n.name}</span>
          </a>
        ))}
      </div>
    </div>
  )}

  <div class="nav-grid">
    {prevCode ? (
      <a href={`/${lang}/countries/${prevCode.toLowerCase()}/`} class="nav-item prev">
        <span class="nav-label">← {t('world.nav.prev') || 'Předchozí'}</span>
        <span class="nav-title">{getCountryName(prevCode, lang)}</span>
      </a>
    ) : <div class="nav-empty" />}
    
    <div class="nav-item meta-links">
        <a href={`/${lang}/countries/`}>Atlas</a>
        <a href={`/${lang}/countries/table/`}>Data</a>
    </div>

    {nextCode ? (
      <a href={`/${lang}/countries/${nextCode.toLowerCase()}/`} class="nav-item next">
        <span class="nav-label">{t('world.nav.next') || 'Další'} →</span>
        <span class="nav-title">{getCountryName(nextCode, lang)}</span>
      </a>
    ) : <div class="nav-empty" />}
  </div>
</StarlightPage>

<script>
  function tick() {
    const clocks = document.querySelectorAll('.live-clock');
    const now = new Date();
    clocks.forEach(el => {
      const tz = el.getAttribute('data-tz');
      const display = el.querySelector('.clock-value');
      if (tz && display) {
        try {
          display.textContent = new Intl.DateTimeFormat('cs-CZ', {
            timeZone: tz, hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false
          }).format(now);
        } catch (e) { display.textContent = "N/A"; }
      }
    });
  }
  setInterval(tick, 1000);
  tick();
</script>

<style>
  .country-hero { display: flex; flex-direction: row; justify-content: space-between; align-items: flex-start; gap: 2rem; margin-bottom: 2.5rem; padding-bottom: 2rem; border-bottom: 1px solid var(--sl-color-hairline); margin-top: 0 !important; }
  .names-stack { display: flex; flex-direction: column; gap: 0.75rem; flex: 1; }
  .native-name { font-size: 1.25rem; color: var(--sl-color-gray-2); margin: 0 !important; }
  .native-value { color: var(--sl-color-white); font-weight: 500; }
  .code-badges { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .badge { background: var(--sl-color-gray-5); padding: 0.2rem 0.6rem; border-radius: 4px; font-size: 0.75rem; color: var(--sl-color-gray-2); }
  .badge strong { color: var(--sl-color-accent-high); font-family: var(--sl-font-mono); }
  .hero-links { display: flex; gap: 1rem; margin-top: 0.5rem; }
  .link-btn { font-size: 0.85rem; color: var(--sl-color-accent-high) !important; text-decoration: none; padding: 0.4rem 0.8rem; border: 1px solid var(--sl-color-accent); border-radius: 4px; }
  .large-flag { display: block; width: 240px; height: auto; aspect-ratio: 4/3; border: 1px solid var(--sl-color-gray-5); background-size: cover; border-radius: 4px; }
  
  .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem; }
  .stats-card { background: var(--sl-color-gray-6); padding: 1.25rem; border: 1px solid var(--sl-color-hairline); border-radius: 8px; margin-top: 0 !important; }
  .stats-card h3 { margin: 0 0 1rem 0 !important; font-size: 0.8rem; color: var(--sl-color-gray-3); text-transform: uppercase; border-bottom: 1px solid var(--sl-color-gray-5); padding-bottom: 0.5rem; }
  .stats-card ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.8rem; }
  .stats-card li { display: flex; flex-direction: column; gap: 0.1rem; margin: 0 !important; }
  .stats-card strong { color: var(--sl-color-accent-high); font-size: 0.7rem; text-transform: uppercase; }

  /* Timezone list s posuvníkem pro státy jako Rusko/USA */
  .timezone-wrapper { display: flex; flex-direction: column; gap: 0.5rem; max-height: 300px; overflow-y: auto; padding-right: 5px; }
  .timezone-wrapper::-webkit-scrollbar { width: 4px; }
  .timezone-wrapper::-webkit-scrollbar-thumb { background: var(--sl-color-gray-5); border-radius: 4px; }

  .tz-entry { background: var(--sl-color-gray-5); padding: 0.5rem 0.75rem; border-radius: 6px; border-left: 3px solid var(--sl-color-accent-high); }
  .tz-meta { display: flex; justify-content: space-between; font-size: 0.65rem; color: var(--sl-color-gray-3); font-weight: bold; }
  .tz-offset { color: var(--sl-color-accent-high); }
  .clock-value { font-size: 1.3rem; font-weight: bold; font-family: var(--sl-font-mono); color: var(--sl-color-white); }

  .list-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .tag { background: var(--sl-color-gray-5); padding: 0.2rem 0.6rem; font-size: 0.8rem; border-radius: 4px; color: var(--sl-color-white) !important; text-decoration: none !important; }
  
  .neighbors-section { margin-top: 3rem; }
  .neighbor-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 0.75rem; }
  .neighbor-link { display: flex; align-items: center; gap: 0.75rem; padding: 0.6rem; background: var(--sl-color-gray-6); border: 1px solid var(--sl-color-hairline); border-radius: 6px; text-decoration: none; color: inherit !important; font-size: 0.85rem; }

  .nav-grid { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--sl-color-hairline); }
  .nav-item { display: flex; flex-direction: column; padding: 0.75rem; border: 1px solid var(--sl-color-hairline); border-radius: 8px; text-decoration: none !important; }
  .meta-links { border: none; flex-direction: row; gap: 1rem; align-items: center; justify-content: center; }
  .meta-links a { color: var(--sl-color-accent-high); font-weight: bold; text-decoration: none; font-size: 0.9rem; }
  .nav-label { font-size: 0.65rem; color: var(--sl-color-gray-3); text-transform: uppercase; }
  .nav-title { font-size: 0.9rem; font-weight: bold; color: var(--sl-color-accent-high); }
  .next { text-align: right; }

  @media (max-width: 50rem) { 
    .country-hero { flex-direction: column-reverse; } 
    .large-flag { width: 100%; } 
    .nav-grid { grid-template-columns: 1fr; } 
    .meta-links { order: 3; margin-top: 1rem; }
    .next { text-align: left; } 
  }
</style>

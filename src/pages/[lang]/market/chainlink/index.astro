---
// src/pages/[lang]/market/chainlink/index.astro
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import SearchFilterBar from '@/components/root/SearchFilterBar.astro';
import fs from 'node:fs';
import path from 'node:path';
import { PATHS } from '../../../../scripts/fetch/fetch.config.ts'; 
import { getI18nPaths } from '@/content/config/i18n';
import '@fortawesome/fontawesome-free/css/all.min.css';

export async function getStaticPaths() {
  return getI18nPaths();
}

const { lang } = Astro.params;
const PUBLIC_DATA_PATH = `/raw/chainlink/chainlink_all/`; 
const RAW_DIR = path.join(process.cwd(), PATHS.RAW, PATHS.CHAINLINK_ALL);

let rawData: any[] = [];
let latestFile = "";
let humanTimestamp = "Initializing...";

if (fs.existsSync(RAW_DIR)) {
  try {
    const files = fs.readdirSync(RAW_DIR).filter(f => f.startsWith('chainlink_full_'));
    latestFile = files.sort().reverse()[0];
    if (latestFile) {
      rawData = JSON.parse(fs.readFileSync(path.join(RAW_DIR, latestFile), 'utf-8'));
      const parts = latestFile.replace('chainlink_full_', '').replace('.json', '').split('T');
      if (parts.length === 2) {
        const dateObj = new Date(`${parts[0]}T${parts[1].replace(/-/g, ':')}`);
        humanTimestamp = !isNaN(dateObj.getTime()) ? dateObj.toLocaleString(lang === 'cs' ? 'cs-CZ' : 'en-US') : "N/A";
      }
    }
  } catch (e) { console.error("Build load error:", e); }
}

const feeds = rawData
  .filter((f: any) => f.name && f.name !== 'Unknown')
  .map((f: any) => {
    const address = f.proxyAddress || f.contractAddress || 'N/A';
    const categoryName = f.feedCategory && f.feedCategory !== 'medium' ? f.feedCategory : 'Asset';
    
    return {
      id: address,
      name: f.name.trim(),
      searchName: f.name.toLowerCase().replace(/\s+/g, ''),
      price: f.liveData?.realPrice || 0,
      decimals: f.liveData?.decimals || 8,
      updatedAt: f.liveData?.updatedAt ? new Date(f.liveData.updatedAt) : null,
      category: categoryName,
      // Nově mapovaná data z JSONu
      threshold: f.threshold || 0,
      heartbeat: f.heartbeat || 0,
      assetClass: f.docs?.assetClass || f.feedType || 'N/A',
      auditor: f.docs?.porAuditor || null,
      detailUrl: `/${lang}/market/chainlink/asset/?id=${address}&symbol=${encodeURIComponent(f.name)}&decimals=${f.liveData?.decimals || 8}`
    };
  }).sort((a: any, b: any) => a.name.localeCompare(b.name));

const categories = Array.from(new Set(feeds.map(f => f.category))).map(cat => ({
  label: String(cat),
  value: String(cat).toLowerCase(),
  count: feeds.filter(f => f.category === cat).length
}));

const RAY_COUNT = 65;
const timeOptions: Intl.DateTimeFormatOptions = { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false };
---

<StarlightPage frontmatter={{ title: "Chainlink Oracle Explorer", tableOfContents: false }}>
  <div class="explorer-visual-context">
    <div class="wormhole-background" aria-hidden="true">
      <svg viewBox="0 0 1000 1000" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="ray-gradient-cl" x1="0%" x2="0%" y1="0%" y2="100%">
            <stop offset="10%" stop-color="#375bd2" stop-opacity="0" />
            <stop offset="40%" stop-color="#375bd2" stop-opacity="0.3" />
            <stop offset="90%" stop-color="#2a4ad0" stop-opacity="0" />
          </linearGradient>
        </defs>
        <g transform="translate(850, 250)">
          <g>
            <animateTransform attributeName="transform" type="rotate" from="0" to="360" dur="240s" repeatCount="indefinite" />
            {Array.from({ length: RAY_COUNT }).map((_, i) => (
              <rect x="-1" y="100" width="1" height="1000" fill="url(#ray-gradient-cl)" transform={`rotate(${(360 / RAY_COUNT) * i})`} />
            ))}
          </g>
          <circle r="180" fill="var(--sl-color-bg)" filter="blur(50px)" />
        </g>
      </svg>
    </div>

    <div class="explorer-content">
      <div class="stats-grid">
        <div class="stat-card glass-panel">
          <span class="label">Total Feeds</span>
          <span class="value" id="stat-total">{feeds.length}</span>
        </div>
        <div class="stat-card glass-panel">
          <span class="label">Last Sync</span>
          <span class="value" id="stat-sync">{humanTimestamp}</span>
        </div>
      </div>

      <SearchFilterBar 
        searchPlaceholder="Search Chainlink pair..." 
        filterLabel="Category"
        filterOptions={categories}
      />

      <div class="table-container glass-panel" id="mainViewContainer">
        <table id="oracleTable">
          <thead>
            <tr>
              <th class="th-pair">Pair</th>
              <th class="th-price">Latest Price</th>
              <th class="th-status">Live</th>
              <th class="th-update">Last Update</th>
              <th class="th-params">Dev / Heartbeat</th>
              <th class="th-class">Asset Class</th>
              <th class="th-cat">Type</th>
            </tr>
          </thead>
          <tbody>
            {feeds.map((f: any) => (
              <tr data-id={f.id} data-category={f.category.toLowerCase()} data-search={f.searchName} data-raw={JSON.stringify(f)}>
                <td class="td-pair">
                  <a href={f.detailUrl} class="pair-link">{f.name}</a>
                </td>
                <td class="cell-price js-price">
                  {f.price.toLocaleString(undefined, { maximumFractionDigits: 10 })}
                </td>
                <td class="td-status">
                  <div class={`status-dot js-status ${f.price > 0 ? 'active' : 'inactive'}`}></div>
                </td>
                <td class="js-update cell-update">
                  {f.updatedAt ? f.updatedAt.toLocaleTimeString(lang, timeOptions) : 'N/A'}
                </td>
                <td class="cell-mono td-params">
                  <span class="dev-val">{f.threshold}%</span> / <span class="hb-val">{f.heartbeat}s</span>
                </td>
                <td class="td-class">
                    <div class="class-wrapper">
                        <span class="class-label">{f.assetClass}</span>
                        {f.auditor && <span class="auditor-badge"><i class="fas fa-shield-check"></i> {f.auditor}</span>}
                    </div>
                </td>
                <td class="td-cat"><span class="badge-row">{f.category}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</StarlightPage>

<script is:inline define:vars={{ lang, latestFile, PUBLIC_DATA_PATH }}>
  const syncLabel = document.getElementById('stat-sync');
  const searchInput = document.getElementById('searchTab');
  const tableRows = document.querySelectorAll('#oracleTable tbody tr');
  const viewContainer = document.getElementById('mainViewContainer');
  
  let activeCategory = null;
  const timeOptions = { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false };

  function closeAllDropdowns() {
    document.querySelectorAll('.dropdown-content').forEach(d => d.classList.remove('show'));
  }

  async function refreshData() {
    try {
      const response = await fetch(`${PUBLIC_DATA_PATH}${latestFile}?t=${Date.now()}`);
      if (!response.ok) return;
      const data = await response.json();

      data.forEach(item => {
        const address = item.proxyAddress || item.contractAddress;
        const row = document.querySelector(`tr[data-id="${address}"]`);
        if (row) {
          const priceCell = row.querySelector('.js-price');
          const statusDot = row.querySelector('.js-status');
          const updateCell = row.querySelector('.js-update');
          
          const newPrice = item.liveData?.realPrice || 0;
          const formatted = newPrice.toLocaleString(undefined, { maximumFractionDigits: 10 });
          
          if (priceCell.innerText !== formatted) {
            priceCell.innerText = formatted;
            priceCell.classList.add('price-flash');
            setTimeout(() => priceCell.classList.remove('price-flash'), 2000);
          }
          if (item.liveData?.updatedAt) {
            updateCell.innerText = new Date(item.liveData.updatedAt).toLocaleTimeString(lang, timeOptions);
          }
          statusDot.className = `status-dot js-status ${newPrice > 0 ? 'active' : 'inactive'}`;
        }
      });
      if (syncLabel) syncLabel.innerText = "Live / " + new Date().toLocaleTimeString(lang, timeOptions);
    } catch (err) {}
  }
  setInterval(refreshData, 5000);

  function filterAll() {
    const term = searchInput ? searchInput.value.toLowerCase().trim() : '';
    tableRows.forEach(row => {
      const matchesSearch = row.getAttribute('data-search').includes(term);
      const matchesCategory = !activeCategory || row.getAttribute('data-category') === activeCategory;
      row.style.setProperty('display', (matchesSearch && matchesCategory) ? '' : 'none', 'important');
    });
  }

  document.addEventListener('click', (e) => {
    const dropdownBtn = e.target.closest('.glass-btn');
    const catItem = e.target.closest('.cat-item');
    const viewItem = e.target.closest('.view-item');

    if (dropdownBtn) {
      const menu = dropdownBtn.nextElementSibling;
      if (menu) {
        const isVisible = menu.classList.contains('show');
        closeAllDropdowns();
        if (!isVisible) menu.classList.add('show');
      }
      return;
    }

    if (catItem) {
      document.querySelectorAll('.cat-item').forEach(i => i.classList.remove('active'));
      catItem.classList.add('active');
      activeCategory = catItem.getAttribute('data-cat') || null;
      filterAll();
      closeAllDropdowns();
      return;
    }

    if (viewItem) {
      document.querySelectorAll('.view-item').forEach(i => i.classList.remove('active'));
      viewItem.classList.add('active');
      if (viewItem.getAttribute('data-view') === 'grid') viewContainer.classList.add('view-grid');
      else viewContainer.classList.remove('view-grid');
      closeAllDropdowns();
      return;
    }

    if (!e.target.closest('.dropdown')) {
      closeAllDropdowns();
    }
  });

  if (searchInput) searchInput.addEventListener('input', filterAll);
</script>

<style is:global>
  .main-frame, .content-panel, .sl-container { max-width: 100% !important; width: 100% !important; margin: 0 !important; background: transparent !important; }
  
  /* GRID VIEW REPAIR */
  .view-grid { background: transparent !important; border: none !important; backdrop-filter: none !important; box-shadow: none !important; }
  .view-grid table, .view-grid thead, .view-grid tbody, .view-grid tr, .view-grid td { display: block !important; border: none !important; margin: 0 !important; }
  .view-grid thead { display: none !important; }
  .view-grid tbody { display: grid !important; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)) !important; gap: 1.25rem !important; }
  
  .view-grid tr { 
    display: flex !important; 
    flex-direction: column !important; 
    background: rgba(var(--sl-color-bg-nav-rgb), 0.6) !important; 
    backdrop-filter: blur(20px) !important; 
    border: 1px solid var(--sl-color-gray-5) !important; 
    border-radius: 1rem !important; 
    padding: 1.5rem !important; 
    height: 100% !important; 
    position: relative !important; 
  }
  
  .view-grid td { width: 100% !important; padding: 0.3rem 0 !important; background: transparent !important; border: none !important; }
  .view-grid .td-status { position: absolute !important; top: 1.2rem !important; right: 1.2rem !important; width: auto !important; padding: 0 !important; }
  .view-grid .pair-link { font-size: 1.3rem; color: #375bd2 !important; }
  .view-grid .cell-price { font-size: 1.6rem; border-top: 1px solid var(--sl-color-gray-6) !important; padding-top: 0.8rem !important; margin-top: auto; }
  .view-grid .td-class { order: -1; margin-bottom: 0.5rem; }
  .view-grid .td-params { font-size: 0.8rem; opacity: 0.7; }

  @keyframes flash-price-cl {
    0% { color: #375bd2; text-shadow: 0 0 10px rgba(55, 91, 210, 0.5); }
    100% { color: inherit; text-shadow: none; }
  }
  .price-flash { animation: flash-price-cl 2s ease-out; }
</style>

<style>
  .explorer-content {
    --filter-accent-color: #375bd2;
    --filter-accent-bg: rgba(55, 91, 210, 0.15);
    --filter-accent-border: rgba(55, 91, 210, 0.4);
  }
  .explorer-visual-context { position: relative; margin: -2rem -3rem; padding: 2rem 3rem; }
  .wormhole-background { position: fixed; inset: 0; z-index: -1; pointer-events: none; background: var(--sl-color-bg); }
  
  .glass-panel {
    background: rgba(var(--sl-color-bg-nav-rgb), 0.85) !important;
    backdrop-filter: blur(30px) !important;
    border: 1px solid var(--sl-color-gray-5) !important;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }

  .stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 2rem; }
  .stat-card { padding: 1.5rem; border-radius: 0.75rem; display: flex; flex-direction: column; justify-content: center; min-height: 100px; margin-top: 0 !important; }
  .label { font-size: 0.75rem; color: var(--sl-color-gray-3); text-transform: uppercase; margin-bottom: 0.25rem; }
  .value { font-size: 1.2rem; font-weight: bold; color: var(--sl-color-white); }
  
  .table-container { border-radius: 0.75rem; overflow-x: auto; width: 100%; }
  table { width: 100%; border-collapse: separate; border-spacing: 0; table-layout: fixed; }
  th, td { padding: 1rem; border-bottom: 1px solid var(--sl-color-gray-6); vertical-align: middle; }
  
  /* Šířky sloupců */
  .th-pair, .td-pair { width: 180px; }
  .th-price, .cell-price { width: 160px; }
  .th-status, .td-status { width: 60px; text-align: center; }
  .th-update, .cell-update { width: 120px; }
  .th-params, .td-params { width: 140px; }
  .th-class, .td-class { width: auto; }
  .th-cat, .td-cat { width: 120px; text-align: right; }

  th { background: rgba(55, 91, 210, 0.1); color: #375bd2; border-bottom: 2px solid var(--sl-color-gray-5); font-size: 0.8rem; text-align: left; }
  
  .pair-link { color: #375bd2 !important; font-weight: bold; text-decoration: none; }
  .cell-price { font-family: 'JetBrains Mono', monospace; font-weight: bold; }
  .cell-mono { font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; color: var(--sl-color-gray-3); }
  
  .dev-val { color: #375bd2; font-weight: 600; }
  .hb-val { opacity: 0.8; }

  .class-wrapper { display: flex; flex-direction: column; gap: 0.2rem; }
  .class-label { font-size: 0.85rem; color: var(--sl-color-white); }
  .auditor-badge { font-size: 0.65rem; color: #10b981; display: flex; align-items: center; gap: 0.3rem; }

  .status-dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
  .status-dot.active { background: #10b981; box-shadow: 0 0 10px #10b981; }
  .status-dot.inactive { background: #ef4444; }
  
  .badge-row { font-size: 0.65rem; background: rgba(55, 91, 210, 0.1); padding: 0.2rem 0.5rem; border-radius: 4px; color: #375bd2; font-weight: 600; }

  @media (max-width: 1200px) {
    .th-params, .td-params, .th-class, .td-class { display: none; }
    .stats-grid { grid-template-columns: 1fr; }
  }
</style>

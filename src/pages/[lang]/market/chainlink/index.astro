---
// src/pages/[lang]/market/chainlink/index.astro
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import SearchFilterBar from '@/components/root/SearchFilterBar.astro';
import fs from 'node:fs';
import path from 'node:path';
import { PATHS } from '../../../../scripts/fetch/fetch.config.ts'; 
import { getI18nPaths } from '@/content/config/i18n';
import '@fortawesome/fontawesome-free/css/all.min.css';

export async function getStaticPaths() {
  return getI18nPaths();
}

const { lang } = Astro.params;
const RAW_DIR = path.join(process.cwd(), PATHS.RAW, PATHS.CHAINLINK_ALL);

let rawData: any[] = [];
let humanTimestamp = "Connecting to Oracle...";

if (fs.existsSync(RAW_DIR)) {
  try {
    const files = fs.readdirSync(RAW_DIR).filter(f => f.startsWith('chainlink_full_'));
    const latestFile = files.sort().reverse()[0];
    if (latestFile) {
      rawData = JSON.parse(fs.readFileSync(path.join(RAW_DIR, latestFile), 'utf-8'));
    }
  } catch (e) { console.error("Build load error:", e); }
}

const feeds = rawData
  .filter((f: any) => f.name && f.name !== 'Unknown')
  .map((f: any) => {
    const address = f.proxyAddress || f.contractAddress || 'N/A';
    return {
      id: address,
      name: f.name.trim(),
      searchName: f.name.toLowerCase().replace(/\s+/g, ''),
      price: f.liveData?.realPrice || 0,
      decimals: f.liveData?.decimals || 8,
      updatedAt: f.liveData?.updatedAt ? new Date(f.liveData.updatedAt) : null,
      category: f.feedCategory && f.feedCategory !== 'medium' ? f.feedCategory : 'Asset',
      threshold: f.threshold || 0,
      heartbeat: f.heartbeat || 3600,
      detailUrl: `/${lang}/market/chainlink/asset/?id=${address}&symbol=${encodeURIComponent(f.name)}&decimals=${f.liveData?.decimals || 8}`
    };
  }).sort((a: any, b: any) => a.name.localeCompare(b.name));

const categories = Array.from(new Set(feeds.map(f => f.category))).map(cat => ({
  label: String(cat),
  value: String(cat).toLowerCase(),
  count: feeds.filter(f => f.category === cat).length
}));

const RAY_COUNT = 65;
// Definice pro SSR
const timeOptions: Intl.DateTimeFormatOptions = { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false };
---

<StarlightPage frontmatter={{ title: "Chainlink Oracle Explorer", tableOfContents: false }}>
  <div class="explorer-visual-context">
    <div class="wormhole-background" aria-hidden="true">
        <svg viewBox="0 0 1000 1000" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="ray-gradient-cl" x1="0%" x2="0%" y1="0%" y2="100%">
                <stop offset="10%" stop-color="#375bd2" stop-opacity="0" />
                <stop offset="40%" stop-color="#375bd2" stop-opacity="0.3" />
                <stop offset="90%" stop-color="#2a4ad0" stop-opacity="0" />
              </linearGradient>
            </defs>
            <g transform="translate(850, 250)">
              <g>
                <animateTransform attributeName="transform" type="rotate" from="0" to="360" dur="240s" repeatCount="indefinite" />
                {Array.from({ length: RAY_COUNT }).map((_, i) => (
                  <rect x="-1" y="100" width="1" height="1000" fill="url(#ray-gradient-cl)" transform={`rotate(${(360 / RAY_COUNT) * i})`} />
                ))}
              </g>
              <circle r="180" fill="var(--sl-color-bg)" filter="blur(50px)" />
            </g>
          </svg>
    </div>

    <div class="explorer-content">
      <div class="stats-grid">
        <div class="stat-card glass-panel">
          <span class="label">Chainlink Feeds</span>
          <span class="value" id="stat-total">{feeds.length}</span>
        </div>
        <div class="stat-card glass-panel">
          <span class="label">Network Status</span>
          <span class="value" id="stat-sync">{humanTimestamp}</span>
        </div>
      </div>

      <SearchFilterBar 
        searchPlaceholder="Search Chainlink pair..." 
        filterLabel="Category"
        filterOptions={categories}
      />

      <div class="table-container glass-panel" id="mainViewContainer">
        <table id="oracleTable">
          <thead>
            <tr>
              <th class="th-pair">Pair</th>
              <th class="th-price">Latest Price</th>
              <th class="th-status">Live</th>
              <th class="th-update">Last Update</th>
              <th class="th-params">Threshold / HB</th>
              <th class="th-cat">Type</th>
            </tr>
          </thead>
          <tbody id="chainlink-body">
            {feeds.map((f: any) => (
              <tr data-id={f.id} data-decimals={f.decimals} data-heartbeat={f.heartbeat} data-category={f.category.toLowerCase()} data-search={f.searchName} class="oracle-row">
                <td class="td-pair">
                  <a href={f.detailUrl} class="pair-link">{f.name}</a>
                </td>
                <td class="cell-price js-price">
                  {f.price.toLocaleString(undefined, { maximumFractionDigits: 10 })}
                </td>
                <td class="td-status">
                  <div class="status-dot js-status" style="background: #ef4444;"></div>
                </td>
                <td class="js-update cell-update">
                    {f.updatedAt ? f.updatedAt.toLocaleTimeString(lang, timeOptions) : 'Waiting...'}
                </td>
                <td class="cell-mono td-params">
                    <span class="dev-val">{f.threshold}%</span> / <span class="hb-val">{f.heartbeat}s</span>
                </td>
                <td class="td-cat"><span class="badge-row">{f.category}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</StarlightPage>

<script is:inline define:vars={{ lang }}>
document.addEventListener('DOMContentLoaded', () => {
  // Lokální definice options pro klientský JS
  const timeOpts = { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false };
  const syncLabel = document.getElementById('stat-sync');
  const searchInput = document.getElementById('searchTab');
  const tableRows = document.querySelectorAll('#chainlink-body tr');
  const mainViewContainer = document.getElementById('mainViewContainer');
  
  let activeCategory = 'all';
  const visibleIds = new Set();
  const RPC_URLS = ["https://ethereum.publicnode.com", "https://rpc.ankr.com/eth", "https://eth.llamarpc.com"];
  let currentRpcIndex = 0;

  const rowMap = new Map();
  tableRows.forEach(row => rowMap.set(row.getAttribute('data-id'), row));

  function decodeLatestRoundData(hex) {
    if (!hex || hex.length < 322) return null;
    const clean = hex.startsWith('0x') ? hex.slice(2) : hex;
    const words = [];
    for (let i = 0; i < clean.length; i += 64) words.push(clean.slice(i, i + 64));
    const answerRaw = BigInt('0x' + words[1]);
    const updatedAt = parseInt(words[3], 16);
    const signed = answerRaw > (1n << 255n) ? answerRaw - (1n << 256n) : answerRaw;
    return { answer: signed, updatedAt };
  }

  function filterAll() {
    const searchTerm = searchInput ? searchInput.value.toLowerCase().trim() : '';
    tableRows.forEach(row => {
      const rowSearch = row.getAttribute('data-search') || '';
      const category = row.getAttribute('data-category');
      const matchesSearch = rowSearch.includes(searchTerm.replace(/\s+/g, ''));
      const matchesCategory = activeCategory === 'all' || category === activeCategory;
      row.style.setProperty('display', (matchesSearch && matchesCategory) ? '' : 'none', 'important');
    });
  }

  if (searchInput) searchInput.addEventListener('input', filterAll);

  const downloadSnapshot = (format) => {
    const data = Array.from(tableRows)
      .filter(row => row.style.display !== 'none')
      .map(row => ({
        pair: row.querySelector('.pair-link').innerText,
        price: row.querySelector('.js-price').innerText,
        updatedAt: row.querySelector('.js-update').innerText,
        id: row.getAttribute('data-id'),
        category: row.getAttribute('data-category')
      }));

    if (data.length === 0) return;
    let content = '';
    let mime = 'text/plain';

    if (format === 'json') { content = JSON.stringify(data, null, 2); mime = 'application/json'; } 
    else if (format === 'csv') { content = 'Pair,Price,Update,Address,Category\n' + data.map(d => `"${d.pair}","${d.price}","${d.updatedAt}","${d.id}","${d.category}"`).join('\n'); mime = 'text/csv'; } 
    else if (format === 'yaml') { content = data.map(d => `- pair: ${d.pair}\n  price: "${d.price}"\n  update: ${d.updatedAt}\n  id: ${d.id}\n  category: ${d.category}`).join('\n'); mime = 'text/yaml'; } 
    else if (format === 'xml') { content = '<?xml version="1.0" encoding="UTF-8"?><feeds>' + data.map(d => `<feed><pair>${d.pair}</pair><price>${d.price}</price></feed>`).join('') + '</feeds>'; mime = 'application/xml'; }

    const blob = new Blob([content], { type: mime });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `chainlink_snapshot_${Date.now()}.${format}`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
  };

  document.addEventListener('click', (e) => {
    const target = e.target;
    const btn = target.closest('.glass-btn');
    if (btn) {
      e.stopPropagation();
      const dropdown = btn.nextElementSibling;
      const isVisible = dropdown.classList.contains('show');
      document.querySelectorAll('.dropdown-content').forEach(d => d.classList.remove('show'));
      if (!isVisible) dropdown.classList.add('show');
      return;
    }
    const dlItem = target.closest('[data-export]');
    if (dlItem) {
      downloadSnapshot(dlItem.getAttribute('data-export'));
      document.querySelectorAll('.dropdown-content').forEach(d => d.classList.remove('show'));
      return;
    }
    const catItem = target.closest('.cat-item');
    if (catItem) {
      activeCategory = catItem.getAttribute('data-cat') || 'all';
      document.querySelectorAll('.cat-item').forEach(i => i.classList.remove('active'));
      catItem.classList.add('active');
      filterAll();
      document.querySelectorAll('.dropdown-content').forEach(d => d.classList.remove('show'));
      return;
    }
    const viewItem = target.closest('.view-item');
    if (viewItem) {
      const view = viewItem.getAttribute('data-view');
      document.querySelectorAll('.view-item').forEach(i => i.classList.remove('active'));
      viewItem.classList.add('active');
      if (view === 'grid') mainViewContainer.classList.add('view-grid'); else mainViewContainer.classList.remove('view-grid');
      document.querySelectorAll('.dropdown-content').forEach(d => d.classList.remove('show'));
      return;
    }
    if (!target.closest('.dropdown')) {
      document.querySelectorAll('.dropdown-content').forEach(d => d.classList.remove('show'));
    }
  });

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      const id = entry.target.getAttribute('data-id');
      if (entry.isIntersecting) visibleIds.add(id); else visibleIds.delete(id);
    });
  }, { threshold: 0.01 });

  tableRows.forEach(row => observer.observe(row));

  async function fetchChainlinkData() {
    if (visibleIds.size === 0) return;
    const ids = Array.from(visibleIds);
    const nowTs = Math.floor(Date.now() / 1000);
    try {
      const results = await Promise.all(ids.map(async (id) => {
        try {
          const res = await fetch(RPC_URLS[currentRpcIndex], {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              jsonrpc: "2.0", id: Date.now(),
              method: "eth_call",
              params: [{ to: id, data: "0xfeaf968c" }, "latest"]
            })
          });
          const json = await res.json();
          if (json.error) return null;
          return { id, decoded: decodeLatestRoundData(json.result) };
        } catch { return null; }
      }));

      results.forEach(res => {
        if (!res || !res.decoded) return;
        const row = rowMap.get(res.id);
        if (!row) return;
        
        const decimals = parseInt(row.getAttribute('data-decimals') || "8");
        const heartbeat = parseInt(row.getAttribute('data-heartbeat') || "3600");
        const price = Number(res.decoded.answer) / Math.pow(10, decimals);
        
        const priceCell = row.querySelector('.js-price');
        const updateCell = row.querySelector('.js-update');
        const statusDot = row.querySelector('.js-status');
        
        // Dynamické formátování podle velikosti ceny (stejné jako v detailu)
        const formatted = price.toLocaleString(undefined, { 
          minimumFractionDigits: price < 0.01 ? 8 : 2,
          maximumFractionDigits: price < 0.0001 ? 12 : 8 
        });

        if (priceCell.innerText !== formatted) {
          priceCell.innerText = formatted;
          priceCell.classList.add('price-flash');
          setTimeout(() => priceCell.classList.remove('price-flash'), 2000);
        }

        // OPRAVA: Použití lokálně definované proměnné timeOpts
        updateCell.innerText = new Date(res.decoded.updatedAt * 1000).toLocaleTimeString(lang, timeOpts);
        
        const age = nowTs - res.decoded.updatedAt;
        const color = age <= heartbeat ? '#10b981' : (age <= heartbeat * 2 ? '#f59e0b' : '#ef4444');
        statusDot.style.background = color;
        statusDot.style.boxShadow = age <= heartbeat ? `0 0 10px ${color}` : 'none';
      });
      if (syncLabel) syncLabel.innerText = "Live / " + new Date().toLocaleTimeString(lang, timeOpts);
    } catch (err) {
      currentRpcIndex = (currentRpcIndex + 1) % RPC_URLS.length;
    }
  }

  fetchChainlinkData();
  const interval = setInterval(fetchChainlinkData, 5000); // Mírně zvýšený interval pro šetření RPC
  window.addEventListener('beforeunload', () => clearInterval(interval));
});
</script>

<style is:global>
  .main-frame, .content-panel, .sl-container { max-width: 100% !important; width: 100% !important; margin: 0 !important; background: transparent !important; }
  
  .view-grid { background: transparent !important; border: none !important; box-shadow: none !important; }
  .view-grid table { border: none !important; display: block !important; width: 100% !important; }
  .view-grid thead { display: none !important; }
  .view-grid tbody { 
    display: grid !important; 
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)) !important; 
    gap: 0.5rem !important; 
    border: none !important;
    padding: 0 !important;
  }
  .view-grid tr { 
    display: flex !important; 
    flex-direction: column !important; 
    background: rgba(var(--sl-color-bg-nav-rgb), 0.6) !important; 
    backdrop-filter: blur(20px) !important;
    border: 1px solid var(--sl-color-gray-5) !important; 
    border-radius: 0.5rem !important; 
    padding: 0.75rem !important; 
    position: relative !important; 
    min-height: 120px !important;
    margin: 0 !important;
  }
  .view-grid td { width: 100% !important; border: none !important; padding: 0.1rem 0 !important; background: transparent !important; }
  .view-grid .td-status { position: absolute !important; top: 0.75rem; right: 0.75rem; width: auto !important; }
  .view-grid .pair-link { font-size: 0.9rem; color: #375bd2 !important; font-weight: 800; }
  .view-grid .badge-row { font-size: 0.6rem; padding: 0.1rem 0.3rem; }
  .view-grid .cell-price { order: 3; font-size: 1.1rem; border-top: 1px solid var(--sl-color-gray-6) !important; padding-top: 0.4rem !important; margin-top: auto; }
  .view-grid .js-update { font-size: 0.65rem; color: var(--sl-color-gray-4); }
  .view-grid .td-params { display: block !important; font-size: 0.6rem; border-top: 1px solid var(--sl-color-gray-6) !important; margin-top: 0.3rem; padding-top: 0.3rem; }

  .glass-btn i, .glass-btn span, .menu-btn i, .menu-btn span { pointer-events: none; }

  @keyframes flash-price-cl { 0% { color: #375bd2; text-shadow: 0 0 10px #375bd2; } 100% { color: inherit; text-shadow: none; } }
  .price-flash { animation: flash-price-cl 2s ease-out; }
</style>

<style>
  .explorer-content { 
    --filter-accent-color: #375bd2; 
    --filter-accent-bg: rgba(55, 91, 210, 0.15);
  }
  
  .explorer-visual-context { position: relative; margin: -2rem -3rem; padding: 2rem 3rem; }
  .wormhole-background { position: fixed; inset: 0; z-index: -1; pointer-events: none; background: var(--sl-color-bg); }
  
  .glass-panel { 
    background: rgba(var(--sl-color-bg-nav-rgb), 0.85) !important; 
    backdrop-filter: blur(30px) !important; 
    border: 1px solid var(--sl-color-gray-5) !important;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }

  .stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 2rem; }
  .stat-card { padding: 1.5rem; border-radius: 0.75rem; min-height: 100px; display: flex; flex-direction: column; justify-content: center; margin-top: 0 !important; }
  .label { font-size: 0.75rem; color: var(--sl-color-gray-3); text-transform: uppercase; margin-bottom: 0.25rem; }
  .value { font-size: 1.2rem; font-weight: bold; color: var(--sl-color-white); }
  
  .table-container { border-radius: 0.75rem; overflow-x: auto; width: 100%; }
  table { width: 100%; border-collapse: separate; border-spacing: 0; table-layout: fixed; }
  th, td { padding: 0.75rem 1rem; border-bottom: 1px solid var(--sl-color-gray-6); vertical-align: middle; }
  th { background: rgba(55, 91, 210, 0.1); color: #375bd2; border-bottom: 2px solid var(--sl-color-gray-5); font-size: 0.8rem; }
  
  .th-pair, .td-pair { width: 25%; }
  .th-price, .cell-price { width: 20%; font-family: 'JetBrains Mono', monospace; font-weight: bold; }
  .th-status, .td-status { width: 8%; text-align: center; }
  .th-update, .cell-update { width: 15%; }
  .th-params, .td-params { width: 17%; font-size: 0.75rem; color: var(--sl-color-gray-3); }
  .th-cat, .td-cat { width: 15%; text-align: right; }

  .pair-link { color: #375bd2 !important; font-weight: 800; text-decoration: none; }
  .status-dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; transition: all 0.3s ease; }
  
  .badge-row { 
    font-size: 0.65rem; 
    background: rgba(55, 91, 210, 0.15) !important; 
    padding: 0.2rem 0.5rem; 
    border-radius: 4px; 
    color: #375bd2 !important; 
    font-weight: 600;
    border: 1px solid rgba(55, 91, 210, 0.3);
  }
  
  .dev-val { color: #375bd2; font-weight: 600; }

  @media (max-width: 1000px) {
    .stats-grid { grid-template-columns: 1fr; }
    .th-params, .td-params { display: none; }
  }
</style>

---
// src/pages/[lang]/market/chainlink/asset.astro
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getI18nPaths } from '@/content/config/i18n';

export async function getStaticPaths() {
  return getI18nPaths();
}

const { lang } = Astro.params;
---

<StarlightPage frontmatter={{ title: `Chainlink Feed Detail`, tableOfContents: false }}>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
  
  <div class="detail-wrapper">
    <div class="wormhole-bg-fixed" aria-hidden="true">
      <svg viewBox="0 0 1000 1000" xmlns="http://www.w3.org/2000/svg">
        <g transform="translate(850, 250)">
          <g>
            <animateTransform attributeName="transform" type="rotate" from="0" to="360" dur="240s" repeatCount="indefinite" />
            <rect x="-1" y="100" width="1" height="1000" fill="#375bd2" fill-opacity="0.1" />
          </g>
        </g>
      </svg>
    </div>

    <div class="header-nav">
      <a href={`/${lang}/market/chainlink/`} class="back-btn"><i class="fas fa-arrow-left"></i> Chainlink Explorer</a>
    </div>

    <div id="loader" class="glass-panel text-center loading-state">
      <i class="fas fa-circle-notch fa-spin"></i> 
      <span>Synchronizing with Ethereum Mainnet...</span>
    </div>

    <div id="content" class="main-grid" style="display: none;">
      <div class="primary-column">
        <div class="glass-panel info-hero">
          <div class="top-row">
            <span id="asset-type" class="type-tag">Chainlink Price Feed</span>
            <div class="live-indicator">
              <div id="status-dot" class="dot"></div>
              <span id="last-update" class="mono">Connecting...</span>
            </div>
          </div>
          <h1 id="asset-symbol" class="asset-title">---</h1>
          <p id="asset-desc" class="sub-text">Decentralized Oracle Network Data</p>
          
          <div class="price-stack">
            <div class="price-item">
              <label>Latest Answer</label>
              <div id="live-price" class="val-large mono">---</div>
            </div>
            <div class="price-item">
              <label>Technical Status</label>
              <div id="live-heartbeat" class="val-medium mono">Active</div>
            </div>
          </div>
        </div>

        <div class="glass-panel chart-box">
          <div class="box-label"><i class="fas fa-chart-line"></i> Price History (Binance)</div>
          <div class="chart-container-inner" id="tradingview-container"></div>
        </div>
      </div>

      <div class="secondary-column">
        <div class="glass-panel side-info">
          <h3>Contract Details</h3>
          <div class="spec-row">
            <label>Proxy Address</label>
            <div class="copy-field" id="copy-btn" title="Click to copy">
              <span id="display-id" class="mono truncate-id">---</span>
              <i class="fas fa-copy" id="copy-icon"></i>
            </div>
          </div>
          <div class="spec-row">
            <label>Decimals</label>
            <span id="display-decimals" class="val mono">---</span>
          </div>
          <div class="spec-row">
            <label>Round ID</label>
            <span id="live-round" class="val mono truncate-id">---</span>
          </div>
        </div>

        <div class="glass-panel side-info">
          <h3>Network Info</h3>
          <div class="spec-row">
            <label>Blockchain</label>
            <span id="display-network" class="val">Ethereum Mainnet</span>
          </div>
          <div class="spec-row">
            <label>Data Source</label>
            <span class="val">Chainlink Nodes</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</StarlightPage>

<script is:inline src="https://s3.tradingview.com/tv.js"></script>
<script is:inline>
  const RPC_URLS = ["https://ethereum.publicnode.com", "https://rpc.ankr.com/eth"];
  let currentRpcIndex = 0;

  function decodeLatestRoundData(hex) {
    if (!hex || hex.length < 322) return null;
    const clean = hex.startsWith('0x') ? hex.slice(2) : hex;
    const words = [];
    for (let i = 0; i < clean.length; i += 64) words.push(clean.slice(i, i + 64));
    
    // roundId (word 0), answer (word 1), startedAt (word 2), updatedAt (word 3), answeredInRound (word 4)
    const roundId = BigInt('0x' + words[0]).toString();
    const answerRaw = BigInt('0x' + words[1]);
    const updatedAt = parseInt(words[3], 16);
    
    // Handle signed integers (price can be negative in theory, though rare for assets)
    const signedAnswer = answerRaw > (1n << 255n) ? answerRaw - (1n << 256n) : answerRaw;
    
    return { roundId, answer: signedAnswer, updatedAt };
  }

  async function updateChainlinkData(address, decimals) {
    try {
      const response = await fetch(RPC_URLS[currentRpcIndex], {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          jsonrpc: "2.0",
          id: Date.now(),
          method: "eth_call",
          params: [{
            to: address,
            data: "0xfeaf968c" // latestRoundData()
          }, "latest"]
        })
      });

      const json = await response.json();
      if (json.error) throw new Error(json.error.message);

      const data = decodeLatestRoundData(json.result);
      if (!data) return;

      const price = Number(data.answer) / Math.pow(10, decimals);
      const priceEl = document.getElementById('live-price');
      
      // Formátování podle počtu desetinných míst
      const formattedPrice = price.toLocaleString(undefined, { 
        maximumFractionDigits: decimals > 8 ? 4 : 8,
        minimumFractionDigits: 2
      });

      // Efekt probliknutí při změně ceny
      if (priceEl.innerText !== formattedPrice && priceEl.innerText !== "---") {
        priceEl.style.transition = 'none';
        priceEl.style.color = '#375bd2';
        setTimeout(() => {
          priceEl.style.transition = 'color 1s';
          priceEl.style.color = '';
        }, 50);
      }

      priceEl.innerText = formattedPrice;
      document.getElementById('live-round').innerText = data.roundId;
      
      const updateDate = new Date(data.updatedAt * 1000);
      document.getElementById('last-update').innerText = 'Live / ' + updateDate.toLocaleTimeString();
      document.getElementById('status-dot').style.background = '#10b981';

    } catch (e) {
      console.warn("RPC Error, switching provider...", e);
      currentRpcIndex = (currentRpcIndex + 1) % RPC_URLS.length;
    }
  }

  function renderChart(symbol) {
    const isDark = document.documentElement.dataset.theme === 'dark';
    const container = document.getElementById('tradingview-container');
    if (!container) return;
    
    container.innerHTML = '';
    // Vyčištění symbolu pro TradingView (např. "BTC / USD" -> "BTCUSD")
    const cleanSymbol = symbol.replace(/[^a-zA-Z0-9]/g, '');

    new TradingView.widget({
      "autosize": true,
      "symbol": `BINANCE:${cleanSymbol || "BTCUSD"}`,
      "interval": "D",
      "theme": isDark ? "dark" : "light",
      "style": "1",
      "container_id": "tradingview-container",
      "backgroundColor": isDark ? "rgba(10, 12, 16, 1)" : "#ffffff",
      "gridColor": isDark ? "rgba(55, 91, 210, 0.1)" : "rgba(0, 0, 0, 0.05)",
      "hide_side_toolbar": true,
      "allow_symbol_change": false
    });
  }

  async function initDetail() {
    const params = new URLSearchParams(window.location.search);
    const id = params.get('id');
    const symbol = params.get('symbol') || "BTC / USD";
    const decimals = parseInt(params.get('decimals') || "8");
    
    if (!id) {
      window.location.href = './';
      return;
    }

    document.getElementById('asset-symbol').innerText = symbol;
    document.getElementById('display-decimals').innerText = decimals;
    document.getElementById('display-id').innerText = id;

    document.getElementById('loader').style.display = 'none';
    document.getElementById('content').style.display = 'grid';

    renderChart(symbol);
    
    // Okamžitý update a poté interval
    updateChainlinkData(id, decimals);
    setInterval(() => updateChainlinkData(id, decimals), 10000);
  }

  document.getElementById('copy-btn').onclick = function() {
    const id = new URLSearchParams(window.location.search).get('id');
    navigator.clipboard.writeText(id);
    const icon = document.getElementById('copy-icon');
    icon.className = 'fas fa-check';
    icon.style.color = "#10b981";
    setTimeout(() => { icon.className = 'fas fa-copy'; icon.style.color = ""; }, 2000);
  };

  window.addEventListener('load', initDetail);
</script>

<style is:global>
  .main-frame { width: 100% !important; display: flex !important; flex-direction: column !important; }
  .content-panel { padding: 1.5rem !important; width: 100% !important; max-width: 100% !important; }
  .sl-container { max-width: 100% !important; margin: 0 !important; width: 100% !important; }
  .main-frame > .sl-container > .sl-flex { width: 100% !important; max-width: 100% !important; }
</style>

<style>
  .detail-wrapper { position: relative; width: 100%; color: var(--sl-color-text); padding: 1rem 0 3rem 0; }
  .wormhole-bg-fixed { position: fixed; inset: 0; z-index: -1; pointer-events: none; background: var(--sl-color-bg); }
  
  .header-nav { margin-bottom: 2rem; }
  .back-btn { color: var(--sl-color-gray-3); text-decoration: none; font-size: 0.9rem; font-weight: bold; display: flex; align-items: center; gap: 0.5rem; transition: color 0.2s; }
  .back-btn:hover { color: #375bd2; }

  .loading-state { padding: 5rem; display: flex; flex-direction: column; align-items: center; gap: 1rem; color: var(--sl-color-gray-3); }

  .main-grid { display: grid; grid-template-columns: 1fr 320px; gap: 2rem; width: 100%; align-items: start; }
  .primary-column { display: flex; flex-direction: column; gap: 1.5rem; min-width: 0; }
  .secondary-column { display: flex; flex-direction: column; gap: 1.5rem; min-width: 0; }
  
  .glass-panel { 
    background: rgba(var(--sl-color-bg-nav-rgb), 0.7) !important; 
    backdrop-filter: blur(20px); 
    border: 1px solid var(--sl-color-gray-5) !important; 
    border-radius: 1rem; 
    padding: 2rem; 
  }
  
  .top-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
  .type-tag { font-size: 0.7rem; text-transform: uppercase; background: rgba(55, 91, 210, 0.15); color: #375bd2; padding: 0.2rem 0.6rem; border-radius: 4px; font-weight: bold; border: 1px solid rgba(55, 91, 210, 0.3); }
  
  .live-indicator { display: flex; align-items: center; gap: 0.5rem; font-size: 0.8rem; }
  .dot { width: 10px; height: 10px; border-radius: 50%; background: #444; box-shadow: 0 0 8px rgba(0,0,0,0.3); }
  
  .asset-title { font-size: 2.8rem !important; margin: 0 !important; color: var(--sl-color-white) !important; letter-spacing: -0.5px; }
  .sub-text { color: var(--sl-color-gray-3); margin: 0.5rem 0 1.5rem 0; font-size: 1.1rem; }
  
  .price-stack { padding-top: 2rem; border-top: 1px solid var(--sl-color-gray-6); display: flex; flex-direction: column; gap: 1.5rem; }
  .price-item label { display: block; font-size: 0.75rem; color: var(--sl-color-gray-4); text-transform: uppercase; margin-bottom: 0.5rem; }
  .val-large { font-size: 3.5rem; font-weight: 800; line-height: 1; color: var(--sl-color-white); }
  .val-medium { font-size: 1.4rem; color: #375bd2; font-weight: bold; }
  
  .chart-box { padding: 0; overflow: hidden; }
  .box-label { padding: 1rem 2rem; font-size: 0.75rem; color: #375bd2; border-bottom: 1px solid var(--sl-color-gray-6); font-weight: bold; text-transform: uppercase; }
  .chart-container-inner { height: 500px; width: 100%; }
  
  h3 { font-size: 0.75rem !important; color: #375bd2 !important; text-transform: uppercase; margin-bottom: 1.5rem !important; font-weight: 800 !important; border-bottom: 1px solid var(--sl-color-gray-6); padding-bottom: 0.5rem; }
  .spec-row { margin-bottom: 1.25rem; }
  .spec-row label { display: block; font-size: 0.7rem; color: var(--sl-color-gray-4); text-transform: uppercase; margin-bottom: 0.3rem; }
  .val { color: var(--sl-color-white); font-weight: 500; font-size: 0.95rem; }
  
  .copy-field { 
    background: rgba(0,0,0,0.2); 
    padding: 0.75rem; 
    border-radius: 0.5rem; 
    display: flex; 
    justify-content: space-between; 
    align-items: center; 
    cursor: pointer;
    font-size: 0.8rem;
    border: 1px solid var(--sl-color-gray-5);
    gap: 10px;
  }
  .copy-field:hover { border-color: #375bd2; background: rgba(55, 91, 210, 0.05); }
  .truncate-id { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; }
  
  .mono { font-family: var(--sl-font-mono); }
  
  @media (max-width: 1100px) { 
    .main-grid { grid-template-columns: 1fr; } 
    .secondary-column { width: 100%; } 
    .val-large { font-size: 2.8rem; }
  }
</style>

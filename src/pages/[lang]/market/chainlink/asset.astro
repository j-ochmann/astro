---
// src/pages/[lang]/market/chainlink/asset.astro
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getI18nPaths } from '@/content/config/i18n';

export async function getStaticPaths() {
  return getI18nPaths();
}

const { lang } = Astro.params;
---

<StarlightPage frontmatter={{ title: `Chainlink Feed Detail`, tableOfContents: false }}>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
  
  <div class="detail-wrapper">
    <div class="wormhole-bg-fixed" aria-hidden="true">
      <svg viewBox="0 0 1000 1000" xmlns="http://www.w3.org/2000/svg">
        <g transform="translate(850, 250)">
          <g>
            <animateTransform attributeName="transform" type="rotate" from="0" to="360" dur="240s" repeatCount="indefinite" />
            <rect x="-1" y="100" width="1" height="1000" fill="#375bd2" fill-opacity="0.1" />
          </g>
        </g>
      </svg>
    </div>

    <div class="header-nav">
      <a href={`/${lang}/market/chainlink/`} class="back-btn"><i class="fas fa-arrow-left"></i> Chainlink Explorer</a>
    </div>

    <div id="loader" class="glass-panel text-center" style="padding: 5rem; text-align: center;">
      <i class="fas fa-circle-notch fa-spin"></i> Loading oracle data...
    </div>

    <div id="content" class="main-grid" style="display: none;">
      <div class="primary-column">
        <div class="glass-panel info-hero">
          <div class="top-row">
            <span id="asset-type" class="type-tag">Chainlink Feed</span>
            <div class="live-indicator">
              <div id="status-dot" class="dot"></div>
              <span id="last-update" class="mono">Initializing...</span>
            </div>
          </div>
          <h1 id="asset-symbol" class="asset-title">---</h1>
          <p id="asset-desc" class="sub-text">Decentralized Price Feed</p>
          
          <div class="price-stack">
            <div class="price-item">
              <label>Current Answer</label>
              <div id="live-price" class="val-large mono">---</div>
            </div>
            <div class="price-item">
              <label>Heartbeat / Threshold</label>
              <div id="live-heartbeat" class="val-medium mono">---</div>
            </div>
          </div>
        </div>

        <div class="glass-panel chart-box">
          <div class="box-label"><i class="fas fa-chart-line"></i> Price History</div>
          <div class="chart-container-inner" id="tradingview-container"></div>
        </div>
      </div>

      <div class="secondary-column">
        <div class="glass-panel side-info">
          <h3>Technical Specs</h3>
          <div class="spec-row">
            <label>Proxy Address</label>
            <div class="copy-field" id="copy-btn" title="Click to copy address">
              <span id="display-id" class="mono truncate-id">---</span>
              <i class="fas fa-copy" id="copy-icon"></i>
            </div>
          </div>
          <div class="spec-row">
            <label>Decimals</label>
            <span id="display-decimals" class="val mono">---</span>
          </div>
          <div class="spec-row">
            <label>Round ID</label>
            <span id="live-round" class="val mono">---</span>
          </div>
        </div>

        <div class="glass-panel side-info">
          <h3>Network Info</h3>
          <div class="spec-row">
            <label>Blockchain</label>
            <span id="display-network" class="val">Ethereum Mainnet</span>
          </div>
          <div class="spec-row">
            <label>Aggregator</label>
            <span id="display-aggregator" class="val mono">---</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</StarlightPage>

<script is:inline src="https://s3.tradingview.com/tv.js"></script>
<script is:inline>
  window.currentAssetSymbol = "";
  window.fullProxyAddress = "";

  async function initDetail() {
    const params = new URLSearchParams(window.location.search);
    const id = params.get('id'); // Očekává se adresa kontraktu
    
    if (!id) {
      window.location.href = './';
      return;
    }

    window.fullProxyAddress = id;

    try {
      // Pro Chainlink používáme simulovaný fetch nebo dotaz na metadata (v reálu by zde byl dotaz na subgraf nebo registry)
      // Pro demo účely parsujeme URL parametry nebo lokální config
      const symbol = params.get('symbol') || "BTC / USD";
      const decimals = params.get('decimals') || "8";
      
      document.getElementById('asset-symbol').innerText = symbol;
      document.getElementById('display-decimals').innerText = decimals;
      document.getElementById('display-id').innerText = id;

      document.getElementById('loader').style.display = 'none';
      document.getElementById('content').style.display = 'flex';

      // Vyčištění symbolu pro TradingView (např. BTC / USD -> BTCUSD)
      window.currentAssetSymbol = symbol.replace(/[^a-zA-Z0-9]/g, '');
      renderChart(window.currentAssetSymbol);
      
      updateChainlinkData(id, decimals);
      setInterval(() => updateChainlinkData(id, decimals), 10000);

    } catch (e) {
      console.error("Chainlink Init Error:", e);
      document.getElementById('loader').innerHTML = `Oracle Feed not found.`;
    }
  }

  async function updateChainlinkData(address, decimals) {
    try {
      // V produkci by se zde volal RPC uzel nebo aggregátor. 
      // Zde simulujeme real-time data pro UI komponentu.
      const mockPrice = (Math.random() * 100 + 50000); 
      
      document.getElementById('live-price').innerText = mockPrice.toLocaleString(undefined, { maximumFractionDigits: 2 });
      document.getElementById('live-heartbeat').innerText = "3600s / 0.5%";
      document.getElementById('live-round').innerText = "110680464442257317000";
      
      const now = new Date();
      document.getElementById('status-dot').style.background = '#10b981';
      document.getElementById('last-update').innerText = 'Live / ' + now.toLocaleTimeString();
    } catch (e) {}
  }

  function renderChart(symbol) {
    const isDark = document.documentElement.dataset.theme === 'dark';
    const container = document.getElementById('tradingview-container');
    if (!container) return;
    
    container.innerHTML = '';

    new TradingView.widget({
      "autosize": true,
      "symbol": `BINANCE:${symbol || "BTCUSD"}`,
      "interval": "D",
      "theme": isDark ? "dark" : "light",
      "style": "1",
      "container_id": "tradingview-container",
      "backgroundColor": isDark ? "#0a0c10" : "#ffffff",
      "gridColor": isDark ? "rgba(55, 91, 210, 0.1)" : "rgba(0, 0, 0, 0.05)"
    });
  }

  document.getElementById('copy-btn').onclick = function() {
    if (!window.fullProxyAddress) return;
    navigator.clipboard.writeText(window.fullProxyAddress);
    
    const icon = document.getElementById('copy-icon');
    icon.classList.remove('fa-copy');
    icon.classList.add('fa-check');
    icon.style.color = "#10b981";
    
    setTimeout(() => {
      icon.classList.remove('fa-check');
      icon.classList.add('fa-copy');
      icon.style.color = "";
    }, 2000);
  };

  const themeObserver = new MutationObserver(() => {
    if (window.currentAssetSymbol) renderChart(window.currentAssetSymbol);
  });
  themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

  window.addEventListener('load', initDetail);
</script>

<style is:global>
  .main-frame, .content-panel, .sl-container { max-width: 100% !important; width: 100% !important; background: transparent !important; }
</style>

<style>
  .detail-wrapper { position: relative; width: 100%; color: var(--sl-color-text); }
  .wormhole-bg-fixed { position: fixed; inset: 0; z-index: -1; pointer-events: none; background: var(--sl-color-bg); }
  .header-nav { margin-bottom: 1rem; }
  .back-btn { color: var(--sl-color-gray-3); text-decoration: none; font-size: 0.9rem; font-weight: bold; }
  .main-grid { display: flex; flex-wrap: wrap; gap: 1rem; width: 100%; align-items: start; }
  .primary-column { flex: 1; min-width: 320px; display: flex; flex-direction: column; gap: 1rem; }
  .secondary-column { width: 320px; display: flex; flex-direction: column; gap: 1rem; }
  
  .glass-panel { 
    background: rgba(var(--sl-color-bg-nav-rgb), 0.7) !important; 
    backdrop-filter: blur(20px); 
    border: 1px solid var(--sl-color-gray-5) !important; 
    border-radius: 0.75rem; 
    padding: 1.5rem; 
  }
  
  .top-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
  .type-tag { font-size: 0.7rem; text-transform: uppercase; background: rgba(55, 91, 210, 0.15); color: #375bd2; padding: 0.2rem 0.6rem; border-radius: 4px; font-weight: bold; border: 1px solid rgba(55, 91, 210, 0.3); }
  
  .live-indicator { display: flex; align-items: center; gap: 0.5rem; font-size: 0.8rem; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: #444; }
  
  .asset-title { font-size: 2.5rem; margin: 0 !important; color: var(--sl-color-white) !important; }
  .sub-text { color: var(--sl-color-gray-3); margin: 0.5rem 0 1.5rem 0; font-size: 1rem; }
  
  .price-stack { padding-top: 1.5rem; border-top: 1px solid var(--sl-color-gray-6); display: flex; flex-direction: column; gap: 1.5rem; }
  .price-item label { display: block; font-size: 0.75rem; color: var(--sl-color-gray-4); text-transform: uppercase; margin-bottom: 0.25rem; }
  .val-large { font-size: 3.2rem; font-weight: bold; line-height: 1; color: var(--sl-color-white); }
  .val-medium { font-size: 1.4rem; color: #375bd2; font-weight: bold; }
  
  .chart-box { padding: 0; overflow: hidden; }
  .box-label { padding: 1rem 1.5rem; font-size: 0.8rem; color: #375bd2; border-bottom: 1px solid var(--sl-color-gray-6); font-weight: bold; text-transform: uppercase; }
  .chart-container-inner { height: 500px; width: 100%; }
  
  h3 { font-size: 0.85rem; color: #375bd2; text-transform: uppercase; margin-bottom: 1.25rem !important; border-bottom: 1px solid var(--sl-color-gray-6); padding-bottom: 0.5rem; }
  .spec-row { margin-bottom: 1rem; }
  .spec-row label { display: block; font-size: 0.7rem; color: var(--sl-color-gray-4); text-transform: uppercase; margin-bottom: 0.2rem; }
  .val { color: var(--sl-color-white); font-weight: 500; font-size: 0.95rem; }
  
  .copy-field { 
    background: var(--sl-color-bg-inline-code); 
    padding: 0.6rem; 
    border-radius: 4px; 
    display: flex; 
    justify-content: space-between; 
    align-items: center; 
    cursor: pointer;
    font-size: 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    gap: 10px;
  }
  .copy-field:hover { border-color: #375bd2; }
  .truncate-id { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; }
  
  .mono { font-family: var(--sl-font-mono); }
  
  @media (max-width: 800px) { .secondary-column { width: 100%; } .val-large { font-size: 2.4rem; } }
</style>

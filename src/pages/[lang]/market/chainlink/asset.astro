---
// src/pages/[lang]/market/chainlink/asset.astro
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getI18nPaths } from '@/content/config/i18n';
import fs from 'node:fs';
import path from 'node:path';
import { PATHS } from '../../../../scripts/fetch/fetch.config.ts'; 

export async function getStaticPaths() {
  return getI18nPaths();
}

const { lang } = Astro.params;

// 1. Načtení parametrů z URL
const assetId = Astro.url.searchParams.get('id');
const urlSymbol = Astro.url.searchParams.get('symbol') || "Asset";

// 2. Načtení dat z JSONu (shodně s index.astro)
const RAW_DIR = path.join(process.cwd(), PATHS.RAW, PATHS.CHAINLINK_ALL);
let feedMeta: any = null;

if (assetId && fs.existsSync(RAW_DIR)) {
  try {
    const files = fs.readdirSync(RAW_DIR).filter(f => f.startsWith('chainlink_full_'));
    const latestFile = files.sort().reverse()[0];
    if (latestFile) {
      const allFeeds = JSON.parse(fs.readFileSync(path.join(RAW_DIR, latestFile), 'utf-8'));
      // Hledání shody v adrese
      feedMeta = allFeeds.find((f: any) => 
        (f.proxyAddress?.toLowerCase() === assetId.toLowerCase()) || 
        (f.contractAddress?.toLowerCase() === assetId.toLowerCase())
      );
    }
  } catch (e) {
    console.error("Detail build load error:", e);
  }
}

// 3. Extrakce parametrů z JSONu (stejná hloubka jako v index.astro)
const decimals = feedMeta?.liveData?.decimals || Astro.url.searchParams.get('decimals') || "8";
const heartbeat = feedMeta?.heartbeat || 3600;
const threshold = feedMeta?.threshold || "---";
const category = feedMeta?.feedCategory || "Asset";
---

<StarlightPage frontmatter={{ title: `${feedMeta?.name || urlSymbol} - Detail`, tableOfContents: false }}>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
  
  <div class="detail-wrapper">
    <div class="header-nav">
      <a href={`/${lang}/market/chainlink/`} class="back-btn"><i class="fas fa-arrow-left"></i> Explorer</a>
    </div>

    <div id="cl-content" class="main-grid">
      <div class="primary-column">
        <div class="glass-panel info-hero">
          <div class="top-row">
            <span class="type-tag">{category}</span>
            <div class="live-indicator">
              <div id="dot-status" class="dot"></div>
              <span id="ts-sync" class="mono" style="color: #10b981;">Connecting...</span>
              <span class="mono" style="color: var(--sl-color-gray-5);">|</span>
              <span id="ts-data" class="mono">Waiting for block...</span>
            </div>
          </div>
          <h1 class="asset-title">{feedMeta?.name || urlSymbol}</h1>
          <p class="sub-text">{feedMeta?.assetName || 'Chainlink Decentralized Oracle Network'}</p>
          
          <div class="price-stack">
            <div class="price-item">
              <label>Latest Answer</label>
              <div id="val-price" class="val-large mono">---</div>
            </div>
            <div class="price-item">
              <label>Network Status</label>
              <div id="val-status" class="val-medium mono">Initializing</div>
            </div>
          </div>
        </div>

        <div class="glass-panel chart-box">
          <div class="box-label">Market Reference</div>
          <div id="tv-container" style="height: 500px;"></div>
        </div>
      </div>

      <div class="secondary-column">
        <div class="glass-panel side-info">
          <h3>Parameters</h3>
          <div class="spec-row">
            <label>Decimals</label>
            <span id="ui-decimals" class="val mono">{decimals}</span>
          </div>
          <div class="spec-row">
            <label>Heartbeat</label>
            <span id="ui-heartbeat" class="val mono">{heartbeat}s</span>
          </div>
          <div class="spec-row">
            <label>Deviation Threshold</label>
            <span class="val mono">{threshold}%</span>
          </div>
        </div>

        <div class="glass-panel side-info">
          <h3>Contract Details</h3>
          <div class="spec-row">
            <label>Proxy Address</label>
            <div class="copy-field" id="copy-trigger">
              <span class="mono truncate-id">{assetId}</span>
              <i class="fas fa-copy"></i>
            </div>
          </div>
          <div class="spec-row">
            <label>Round ID</label>
            <span id="val-round" class="val mono truncate-id">---</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</StarlightPage>

<script is:inline src="https://s3.tradingview.com/tv.js"></script>
<script is:inline>
  (function() {
    let interval = null;
    const nodes = ["https://ethereum.publicnode.com", "https://rpc.ankr.com/eth"];
    let nIdx = 0;

    function parse(hex) {
      if (!hex || hex.length < 66) return null;
      const h = hex.replace('0x', '');
      return {
        r: BigInt('0x' + h.substring(0, 64)).toString(),
        a: BigInt('0x' + h.substring(64, 128)),
        t: parseInt(h.substring(192, 256), 16)
      };
    }

    async function run() {
      const p = new URLSearchParams(window.location.search);
      const id = p.get('id');
      // Priorita pro klientský výpočet: HTML z JSONu -> URL -> Default 8
      const dec = parseInt(document.getElementById('ui-decimals').innerText || p.get('decimals') || "8");
      const hbt = parseInt(document.getElementById('ui-heartbeat').innerText) || 3600;

      if (!id) return;

      try {
        const r = await fetch(nodes[nIdx], {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            jsonrpc: "2.0", id: 1,
            method: "eth_call",
            params: [{ to: id, data: "0xfeaf968c" }, "latest"]
          })
        });

        const j = await r.json();
        const now = new Date();
        document.getElementById('ts-sync').innerText = 'Sync: ' + now.toLocaleTimeString();

        const d = parse(j.result);
        if (!d) return;

        const rawAns = d.a > (1n << 255n) ? d.a - (1n << 256n) : d.a;
        const price = Number(rawAns) / Math.pow(10, dec);
        const age = Math.floor(now.getTime() / 1000) - d.t;

        // UI Update
        document.getElementById('val-price').innerText = price.toLocaleString(undefined, {
            minimumFractionDigits: price < 0.0001 ? 10 : 2,
            maximumFractionDigits: price < 0.0001 ? 14 : 8
        });
        document.getElementById('ts-data').innerText = 'Data: ' + new Date(d.t * 1000).toLocaleTimeString();
        document.getElementById('val-round').innerText = d.r;

        // STATUS LOGIKA založená na reálném Heartbeatu z JSONu
        const dot = document.getElementById('dot-status');
        const stt = document.getElementById('val-status');
        
        // Pokud jsou data starší než heartbeat + malá rezerva (CORS/RPC delay), je to Stale
        const isStale = age > (hbt + 300); 
        const color = isStale ? '#ef4444' : '#10b981';
        
        if (dot) {
          dot.style.background = color;
          dot.style.boxShadow = `0 0 10px ${color}`;
        }
        if (stt) {
          stt.innerText = isStale ? 'Stale' : 'Active';
          stt.style.color = color;
        }

      } catch (e) {
        nIdx = (nIdx + 1) % nodes.length;
      }
    }

    function init() {
      if (interval) clearInterval(interval);
      run();
      interval = setInterval(run, 5000);

      const p = new URLSearchParams(window.location.search);
      const sym = (p.get('symbol') || "BTC").split('/')[0].trim();
      
      if (window.TradingView && document.getElementById('tv-container')) {
        new TradingView.widget({
          "autosize": true,
          "symbol": `BINANCE:${sym.replace(/[^a-zA-Z0-9]/g, '')}USDT`,
          "interval": "D",
          "theme": "dark",
          "container_id": "tv-container",
          "style": "1",
          "hide_side_toolbar": true,
          "backgroundColor": "#0a0c10"
        });
      }
    }

    window.addEventListener('load', init);
    document.addEventListener('astro:after-swap', init);
    
    document.addEventListener('click', (e) => {
      const btn = e.target.closest('#copy-trigger');
      if (btn) {
        navigator.clipboard.writeText(btn.querySelector('span').innerText);
        const i = btn.querySelector('i');
        i.className = 'fas fa-check';
        setTimeout(() => i.className = 'fas fa-copy', 2000);
      }
    });
  })();
</script>

<style is:global>
  .main-frame, .content-panel, .sl-container { max-width: 100% !important; width: 100% !important; margin: 0 !important; }
</style>

<style>
  .detail-wrapper { width: 100%; color: var(--sl-color-text); padding: 1rem 0; }
  .header-nav { margin-bottom: 2rem; }
  .back-btn { color: var(--sl-color-gray-3); text-decoration: none; font-size: 0.9rem; display: flex; align-items: center; gap: 0.5rem; }
  .main-grid { display: grid; grid-template-columns: 1fr 320px; gap: 2rem; }
  .glass-panel { background: rgba(20, 22, 27, 0.8); border: 1px solid var(--sl-color-gray-5); border-radius: 1rem; padding: 2rem; margin-bottom: 1.5rem; }
  .top-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
  .type-tag { font-size: 0.7rem; background: rgba(55, 91, 210, 0.2); color: #375bd2; padding: 0.2rem 0.6rem; border-radius: 4px; font-weight: bold; }
  .live-indicator { display: flex; align-items: center; gap: 0.6rem; font-size: 0.8rem; }
  .dot { width: 10px; height: 10px; border-radius: 50%; transition: all 0.3s ease; }
  .asset-title { font-size: 3rem !important; margin: 0 !important; color: white !important; }
  .sub-text { color: var(--sl-color-gray-3); margin-bottom: 2rem; }
  .price-stack { border-top: 1px solid var(--sl-color-gray-6); padding-top: 2rem; display: flex; flex-direction: column; gap: 1.5rem; }
  .val-large { font-size: 3.5rem; font-weight: 800; color: white; }
  .val-medium { font-size: 1.5rem; font-weight: bold; }
  .spec-row { margin-bottom: 1.25rem; }
  .spec-row label { display: block; font-size: 0.7rem; color: var(--sl-color-gray-4); text-transform: uppercase; }
  .val { color: white; font-size: 1rem; }
  .copy-field { background: rgba(0,0,0,0.3); padding: 0.75rem; border-radius: 0.5rem; display: flex; justify-content: space-between; cursor: pointer; margin-top: 0.3rem; }
  .mono { font-family: var(--sl-font-mono); }
  .truncate-id { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  h3 { font-size: 0.8rem !important; color: #375bd2 !important; text-transform: uppercase; margin-bottom: 1.5rem !important; }
  @media (max-width: 1000px) { .main-grid { grid-template-columns: 1fr; } }
</style>

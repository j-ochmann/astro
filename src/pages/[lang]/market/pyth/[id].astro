---
// src/pages/[lang]/market/pyth/[id].astro
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import fs from 'node:fs';
import path from 'node:path';
import { PATHS } from '../../../../scripts/fetch/fetch.config.ts';
import { getI18nPaths } from '@/content/config/i18n';

export async function getStaticPaths() {
  const i18nPaths = getI18nPaths();
  const RAW_DIR = path.join(process.cwd(), PATHS.RAW, PATHS.PYTH_ALL);
  
  let allIds: string[] = [];
  try {
    if (fs.existsSync(RAW_DIR)) {
      const files = fs.readdirSync(RAW_DIR).filter(f => f.startsWith('pyth_full_'));
      const latestFile = files.sort().reverse()[0];
      if (latestFile) {
        const rawData = JSON.parse(fs.readFileSync(path.join(RAW_DIR, latestFile), 'utf-8'));
        allIds = rawData.map((f: any) => f.id.startsWith('0x') ? f.id : `0x${f.id}`);
      }
    }
  } catch (e) { console.error("Error generating paths:", e); }

  return i18nPaths.flatMap(langPath => 
    allIds.map(id => ({ params: { lang: langPath.params.lang, id: id } }))
  );
}

const { lang, id } = Astro.params;
const RAW_DIR = path.join(process.cwd(), PATHS.RAW, PATHS.PYTH_ALL);

let asset: any = null;
if (fs.existsSync(RAW_DIR)) {
  const files = fs.readdirSync(RAW_DIR).filter(f => f.startsWith('pyth_full_'));
  const latestFile = files.sort().reverse()[0];
  if (latestFile) {
    const rawData = JSON.parse(fs.readFileSync(path.join(RAW_DIR, latestFile), 'utf-8'));
    asset = rawData.find((f: any) => (f.id.startsWith('0x') ? f.id : `0x${f.id}`) === id);
  }
}

if (!asset) return Astro.redirect(`/${lang}/404`);

const attr = asset.attributes || {};
const symbol = attr.display_symbol || attr.symbol || 'Unknown';
const description = attr.description || '';
---

<StarlightPage frontmatter={{ title: `${symbol} | Pyth Oracle Detail`, tableOfContents: false }}>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
  
  <div class="explorer-visual-context">
    <div class="wormhole-background" aria-hidden="true">
      <div class="bg-glow"></div>
    </div>

    <div class="detail-container">
      <div class="header-nav">
        <a href={`/${lang}/market/pyth/`} class="back-link">
          <i class="fas fa-arrow-left"></i> Back to Pyth Explorer
        </a>
      </div>

      <div class="main-layout">
        <div class="content-column">
          <div class="detail-card glass-panel main-info">
            <div class="badge-row">
              <span class="badge asset-type">{attr.asset_type}</span>
              {attr.country && <span class="badge country">{attr.country}</span>}
            </div>
            <h1>{symbol}</h1>
            <p class="description">{description}</p>
            
            <div class="live-price-container">
              <div class="price-block">
                <span class="label">Live Price (USD)</span>
                <div class="price-wrap">
                  <span id="live-price" class="price-value">---</span>
                  <span id="price-diff" class="diff-value"></span>
                </div>
              </div>
              <div class="confidence-block">
                <span class="label">Confidence Interval (±)</span>
                <div id="live-conf" class="conf-value">---</div>
              </div>
            </div>

            <div class="status-footer">
              <div class="status-indicator">
                <div id="status-dot" class="status-dot"></div>
                <span id="last-update">Syncing with Hermes...</span>
              </div>
              <div class="slot-info">
                Slot: <span id="live-slot" class="mono">---</span>
              </div>
            </div>
          </div>

          <div class="detail-card glass-panel chart-card">
            <div class="card-header">
              <h3>Price History</h3>
            </div>
            <div class="chart-wrapper">
              <div id="pyth-chart"></div>
            </div>
          </div>
        </div>

        <div class="sidebar-column">
          <div class="detail-card glass-panel">
            <h3>Feed Metadata</h3>
            <div class="meta-list">
              <div class="meta-item">
                <span class="meta-label">Feed ID</span>
                <div class="copy-box" id="copy-id">
                  <span class="mono truncate">{id}</span>
                  <i class="fas fa-copy"></i>
                </div>
              </div>
              <div class="meta-item">
                <span class="meta-label">Base Asset</span>
                <span class="meta-value">{attr.base}</span>
              </div>
              <div class="meta-item">
                <span class="meta-label">Quote Currency</span>
                <span class="meta-value">{attr.quote_currency}</span>
              </div>
              <div class="meta-item">
                <span class="meta-label">Publish Interval</span>
                <span class="meta-value">{attr.publish_interval}s</span>
              </div>
              {attr.tenor && (
                <div class="meta-item">
                  <span class="meta-label">Tenor</span>
                  <span class="meta-value">{attr.tenor}</span>
                </div>
              )}
            </div>
          </div>

          <div class="detail-card glass-panel">
            <h3>Market Schedule</h3>
            <div class="schedule-box">
              <p class="schedule-text mono">{attr.schedule}</p>
              <div class="schedule-info">
                <i class="fas fa-clock"></i>
                <span>Times are in New York (EST/EDT)</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</StarlightPage>

<script is:inline src="https://pyth.network/js/pyth-charts.js"></script>
<script is:inline define:vars={{ id, symbol }}>
  const priceEl = document.getElementById('live-price');
  const confEl = document.getElementById('live-conf');
  const dotEl = document.getElementById('status-dot');
  const updateEl = document.getElementById('last-update');
  const slotEl = document.getElementById('live-slot');

  let lastPrice = 0;

  async function updateHermes() {
    try {
      const res = await fetch(`https://hermes.pyth.network/v2/updates/price/latest?ids[]=${id}&parsed=true`);
      const data = await res.json();
      const p = data.parsed?.[0]?.price;
      const meta = data.parsed?.[0]?.metadata;

      if (p) {
        const val = parseFloat(p.price) * Math.pow(10, p.expo);
        const confVal = parseFloat(p.conf) * Math.pow(10, p.expo);
        const formatted = val.toLocaleString(undefined, { maximumFractionDigits: 8 });
        
        // Price animation
        if (priceEl.innerText !== formatted) {
          priceEl.classList.remove('up', 'down');
          priceEl.classList.add(val > lastPrice ? 'up' : 'down');
          priceEl.innerText = formatted;
          lastPrice = val;
        }

        confEl.innerText = confVal.toLocaleString(undefined, { maximumFractionDigits: 8 });
        slotEl.innerText = meta?.slot || '---';

        const now = Math.floor(Date.now() / 1000);
        const age = now - parseInt(p.publish_time);
        dotEl.style.background = age < 15 ? '#10b981' : (age < 60 ? '#f59e0b' : '#ef4444');
        updateEl.innerText = `Update age: ${age}s`;
      }
    } catch (e) { console.error("Hermes error:", e); }
  }

  // Init Chart
  if (window.PythCharts) {
    new window.PythCharts.PriceChart({
      container: document.getElementById('pyth-chart'),
      pair: symbol,
      feed: id,
      theme: 'dark',
    });
  }

  // Copy Logic
  document.getElementById('copy-id').addEventListener('click', function() {
    navigator.clipboard.writeText(id);
    const span = this.querySelector('span');
    const original = span.innerText;
    span.innerText = "COPIED!";
    setTimeout(() => span.innerText = original, 1000);
  });

  setInterval(updateHermes, 3000);
  updateHermes();
</script>

<style>
  .explorer-visual-context { position: relative; margin: -2rem -3rem; padding: 2rem 3rem; min-height: 100vh; color: var(--sl-color-white); }
  .bg-glow { position: fixed; top: 0; right: 0; width: 60vw; height: 60vh; background: radial-gradient(circle, rgba(157, 124, 253, 0.1) 0%, transparent 70%); z-index: -1; }
  
  .detail-container { max-width: 1400px; margin: 0 auto; }
  .header-nav { margin-bottom: 2rem; }
  .back-link { color: var(--sl-color-gray-3); text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem; transition: color 0.2s; }
  .back-link:hover { color: #9d7cfd; }

  .main-layout { display: grid; grid-template-columns: 1fr 380px; gap: 2rem; align-items: start; }
  
  .glass-panel {
    background: rgba(var(--sl-color-bg-nav-rgb), 0.7) !important;
    backdrop-filter: blur(20px);
    border: 1px solid var(--sl-color-gray-5) !important;
    border-radius: 1rem;
    padding: 2rem;
  }

  .detail-card { margin-bottom: 2rem; }
  
  .badge-row { display: flex; gap: 0.5rem; margin-bottom: 1rem; }
  .badge { padding: 0.25rem 0.75rem; border-radius: 2rem; font-size: 0.7rem; font-weight: bold; text-transform: uppercase; }
  .asset-type { background: rgba(157, 124, 253, 0.2); color: #9d7cfd; }
  .country { background: rgba(255, 255, 255, 0.1); color: var(--sl-color-gray-2); }

  h1 { font-size: 3rem; margin: 0; }
  .description { color: var(--sl-color-gray-3); font-size: 1.1rem; margin-top: 0.5rem; }

  .live-price-container { display: flex; gap: 4rem; margin: 2.5rem 0; padding: 2rem; background: rgba(255,255,255,0.03); border-radius: 1rem; }
  .label { display: block; font-size: 0.75rem; color: var(--sl-color-gray-4); text-transform: uppercase; letter-spacing: 0.05rem; margin-bottom: 0.5rem; }
  .price-value { font-size: 3.5rem; font-weight: bold; font-family: 'JetBrains Mono', monospace; transition: color 0.3s; }
  .price-value.up { color: #10b981; }
  .price-value.down { color: #ef4444; }
  .conf-value { font-size: 1.8rem; font-family: 'JetBrains Mono', monospace; opacity: 0.9; }

  .status-footer { display: flex; justify-content: space-between; align-items: center; padding-top: 1rem; border-top: 1px solid var(--sl-color-gray-6); color: var(--sl-color-gray-4); font-size: 0.85rem; }
  .status-indicator { display: flex; align-items: center; gap: 0.5rem; }
  .status-dot { width: 10px; height: 10px; border-radius: 50%; background: #444; transition: all 0.3s; }

  /* Chart Area */
  .chart-wrapper { height: 450px; width: 100%; border-radius: 0.5rem; overflow: hidden; margin-top: 1rem; background: #131722; }

  /* Sidebar */
  h3 { font-size: 1rem; color: #9d7cfd; text-transform: uppercase; margin-bottom: 1.5rem; border-left: 3px solid #9d7cfd; padding-left: 0.75rem; }
  .meta-list { display: flex; flex-direction: column; gap: 1.25rem; }
  .meta-item { display: flex; flex-direction: column; gap: 0.25rem; }
  .meta-label { font-size: 0.7rem; color: var(--sl-color-gray-4); text-transform: uppercase; }
  .meta-value { color: var(--sl-color-white); font-weight: 500; }
  
  .copy-box { display: flex; justify-content: space-between; align-items: center; background: rgba(0,0,0,0.2); padding: 0.5rem 0.75rem; border-radius: 0.5rem; cursor: pointer; border: 1px solid transparent; transition: all 0.2s; }
  .copy-box:hover { border-color: #9d7cfd; background: rgba(157, 124, 253, 0.05); }
  .truncate { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 250px; }

  .schedule-box { background: rgba(0,0,0,0.2); padding: 1rem; border-radius: 0.5rem; border: 1px solid var(--sl-color-gray-6); }
  .schedule-text { font-size: 0.75rem; line-height: 1.5; color: #9d7cfd; word-break: break-all; }
  .schedule-info { display: flex; align-items: center; gap: 0.5rem; margin-top: 1rem; font-size: 0.7rem; color: var(--sl-color-gray-4); }

  .mono { font-family: 'JetBrains Mono', monospace; }

  @media (max-width: 1100px) {
    .main-layout { grid-template-columns: 1fr; }
    .live-price-container { flex-direction: column; gap: 2rem; }
  }
</style>

---
// src/pages/[lang]/market/pyth/[id].astro
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import fs from 'node:fs';
import path from 'node:path';
import { PATHS } from '../../../../scripts/fetch/fetch.config.ts';
import { getI18nPaths } from '@/content/config/i18n';

export async function getStaticPaths() {
  const i18nPaths = getI18nPaths();
  const RAW_DIR = path.join(process.cwd(), PATHS.RAW, PATHS.PYTH_ALL);
  let allIds: string[] = [];
  try {
    if (fs.existsSync(RAW_DIR)) {
      const files = fs.readdirSync(RAW_DIR).filter(f => f.startsWith('pyth_full_'));
      const latestFile = files.sort().reverse()[0];
      if (latestFile) {
        const rawData = JSON.parse(fs.readFileSync(path.join(RAW_DIR, latestFile), 'utf-8'));
        allIds = rawData.map((f: any) => f.id.startsWith('0x') ? f.id : `0x${f.id}`);
      }
    }
  } catch (e) { console.error(e); }
  return i18nPaths.flatMap(langPath => allIds.map(id => ({ params: { lang: langPath.params.lang, id: id } })));
}

const { lang, id } = Astro.params;
const RAW_DIR = path.join(process.cwd(), PATHS.RAW, PATHS.PYTH_ALL);
let asset: any = null;

if (fs.existsSync(RAW_DIR)) {
  const files = fs.readdirSync(RAW_DIR).filter(f => f.startsWith('pyth_full_'));
  const latestFile = files.sort().reverse()[0];
  if (latestFile) {
    const rawData = JSON.parse(fs.readFileSync(path.join(RAW_DIR, latestFile), 'utf-8'));
    asset = rawData.find((f: any) => (f.id.startsWith('0x') ? f.id : `0x${f.id}`) === id);
  }
}

if (!asset) return Astro.redirect(`/${lang}/404`);
const attr = asset.attributes || {};
const symbol = attr.display_symbol || attr.symbol || 'Unknown';
// TradingView potřebuje formát PYTH:BTCUSD
const tvSymbol = `PYTH:${symbol.replace(/[^a-zA-Z0-9]/g, '')}`;

const RAY_COUNT = 65;
---

<StarlightPage frontmatter={{ title: `${symbol} Detail`, tableOfContents: false }}>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
  
  <div class="detail-wrapper">
    <div class="wormhole-bg-fixed" aria-hidden="true">
      <svg viewBox="0 0 1000 1000" xmlns="http://www.w3.org/2000/svg">
        <g transform="translate(850, 250)">
          <g>
            <animateTransform attributeName="transform" type="rotate" from="0" to="360" dur="240s" repeatCount="indefinite" />
            {Array.from({ length: RAY_COUNT }).map((_, i) => (
              <rect x="-1" y="100" width="1" height="1000" fill="#9d7cfd" fill-opacity="0.1" transform={`rotate(${(360 / RAY_COUNT) * i})`} />
            ))}
          </g>
        </g>
      </svg>
    </div>

    <div class="header-nav">
      <a href={`/${lang}/market/pyth/`} class="back-btn"><i class="fas fa-arrow-left"></i> Explorer</a>
    </div>

    <div class="main-grid">
      <div class="primary-column">
        <div class="glass-panel info-hero">
          <div class="top-row">
            <span class="type-tag">{attr.asset_type} {attr.country || ''}</span>
            <div class="live-indicator">
              <div id="status-dot" class="dot"></div>
              <span id="last-update" class="mono">Syncing...</span>
            </div>
          </div>
          <h1 class="asset-title">{symbol}</h1>
          <p class="sub-text">{attr.description}</p>
          
          <div class="price-stack">
            <div class="price-item">
              <label>Current Price (USD)</label>
              <div id="live-price" class="val-large mono">---</div>
            </div>
            <div class="price-item">
              <label>Confidence (±)</label>
              <div id="live-conf" class="val-medium mono">---</div>
            </div>
          </div>
        </div>

        <div class="glass-panel chart-box">
          <div class="box-label"><i class="fas fa-chart-line"></i> Market Chart</div>
          <div class="chart-container-inner" id="tradingview-container">
            </div>
        </div>
      </div>

      <div class="secondary-column">
        <div class="glass-panel side-info">
          <h3>Specifications</h3>
          <div class="spec-row">
            <label>Price Feed ID</label>
            <div class="copy-field" id="copy-id">
              <span class="mono">{id}</span>
              <i class="fas fa-copy"></i>
            </div>
          </div>
          <div class="spec-row">
            <label>Pair</label>
            <span class="val">{attr.base} / {attr.quote_currency}</span>
          </div>
          <div class="spec-row">
            <label>Network Slot</label>
            <span id="live-slot" class="val mono">---</span>
          </div>
        </div>

        <div class="glass-panel side-info">
          <h3>Market Schedule</h3>
          <div class="schedule-wrap">
            <code class="mono">{attr.schedule}</code>
          </div>
        </div>
      </div>
    </div>
  </div>
</StarlightPage>

<script is:inline src="https://s3.tradingview.com/tv.js"></script>
<script is:inline define:vars={{ id, tvSymbol }}>
  function renderChart() {
    const isDark = document.documentElement.dataset.theme === 'dark';
    new TradingView.widget({
      "autosize": true,
      "symbol": tvSymbol,
      "interval": "D",
      "timezone": "Etc/UTC",
      "theme": isDark ? "dark" : "light",
      "style": "1",
      "locale": "en",
      "toolbar_bg": "#f1f3f6",
      "enable_publishing": false,
      "hide_top_toolbar": false,
      "hide_legend": false,
      "save_image": false,
      "container_id": "tradingview-container",
      "backgroundColor": isDark ? "rgba(20, 20, 25, 1)" : "rgba(255, 255, 255, 1)",
      "gridColor": "rgba(157, 124, 253, 0.05)"
    });
  }

  async function updatePrice() {
    try {
      const res = await fetch(`https://hermes.pyth.network/v2/updates/price/latest?ids[]=${id}&parsed=true`);
      const d = await res.json();
      const p = d.parsed?.[0]?.price;
      if (p) {
        const v = parseFloat(p.price) * Math.pow(10, p.expo);
        const c = parseFloat(p.conf) * Math.pow(10, p.expo);
        document.getElementById('live-price').innerText = v.toLocaleString(undefined, { maximumFractionDigits: 8 });
        document.getElementById('live-conf').innerText = c.toLocaleString(undefined, { maximumFractionDigits: 8 });
        document.getElementById('live-slot').innerText = d.parsed?.[0]?.metadata?.slot || '---';
        const age = Math.floor(Date.now() / 1000) - parseInt(p.publish_time);
        document.getElementById('status-dot').style.background = age < 30 ? '#10b981' : '#ef4444';
        document.getElementById('last-update').innerText = age + 's ago';
      }
    } catch (e) {}
  }

  // Sledování změny theme
  const observer = new MutationObserver(() => renderChart());
  observer.observe(document.documentElement, { attributes: true });

  window.addEventListener('load', () => {
    renderChart();
    updatePrice();
    setInterval(updatePrice, 3000);
  });

  document.getElementById('copy-id').onclick = function() {
    navigator.clipboard.writeText(id);
    this.style.borderColor = "#9d7cfd";
    setTimeout(() => this.style.borderColor = "var(--sl-color-gray-5)", 1000);
  };
</script>

<style is:global>
  .main-frame, .content-panel, .sl-container { max-width: 100% !important; width: 100% !important; background: transparent !important; }
  #tradingview-container iframe { border-radius: 0 0 0.5rem 0.5rem !important; }
</style>

<style>
  .detail-wrapper { position: relative; width: 100%; color: var(--sl-color-text); }
  .wormhole-bg-fixed { position: fixed; inset: 0; z-index: -1; pointer-events: none; background: var(--sl-color-bg); }
  .header-nav { margin-bottom: 1rem; }
  .back-btn { color: var(--sl-color-gray-3); text-decoration: none; font-size: 0.9rem; font-weight: bold; }
  .back-btn:hover { color: #9d7cfd; }

  .main-grid { display: flex; flex-wrap: wrap; gap: 1rem; width: 100%; align-items: start; }
  .primary-column { flex: 1; min-width: 320px; display: flex; flex-direction: column; gap: 1rem; }
  .secondary-column { width: 320px; display: flex; flex-direction: column; gap: 1rem; }

  .glass-panel {
    background: var(--sl-color-bg-nav) !important;
    backdrop-filter: blur(20px);
    border: 1px solid var(--sl-color-gray-5) !important;
    border-radius: 0.5rem;
    padding: 1.5rem;
  }

  .top-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
  .type-tag { font-size: 0.7rem; text-transform: uppercase; background: rgba(157, 124, 253, 0.15); color: #9d7cfd; padding: 0.2rem 0.6rem; border-radius: 4px; font-weight: bold; border: 1px solid rgba(157, 124, 253, 0.3); }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: #444; }
  
  .asset-title { font-size: 2.5rem; margin: 0 !important; color: var(--sl-color-white) !important; }
  .sub-text { color: var(--sl-color-gray-3); margin: 0.5rem 0 1.5rem 0; font-size: 1rem; }

  .price-stack { padding-top: 1.5rem; border-top: 1px solid var(--sl-color-gray-6); display: flex; flex-direction: column; gap: 1.5rem; }
  .price-item label { display: block; font-size: 0.75rem; color: var(--sl-color-gray-4); text-transform: uppercase; margin-bottom: 0.25rem; letter-spacing: 0.05rem; }
  .val-large { font-size: 3.2rem; font-weight: bold; line-height: 1; color: var(--sl-color-white); }
  .val-medium { font-size: 1.6rem; color: #9d7cfd; font-weight: bold; }

  .chart-box { padding: 0; overflow: hidden; }
  .box-label { padding: 1rem 1.5rem; font-size: 0.8rem; color: #9d7cfd; border-bottom: 1px solid var(--sl-color-gray-6); font-weight: bold; text-transform: uppercase; }
  .chart-container-inner { height: 500px; width: 100%; }

  h3 { font-size: 0.85rem; color: #9d7cfd; text-transform: uppercase; margin-bottom: 1.25rem !important; border-bottom: 1px solid var(--sl-color-gray-6); padding-bottom: 0.5rem; letter-spacing: 0.05rem; }
  .spec-row { margin-bottom: 1rem; }
  .spec-row label { display: block; font-size: 0.7rem; color: var(--sl-color-gray-4); text-transform: uppercase; margin-bottom: 0.2rem; }
  .val { color: var(--sl-color-white); font-weight: 500; font-size: 0.95rem; }
  
  .copy-field { 
    background: var(--sl-color-bg-inline-code); 
    padding: 0.6rem; 
    border-radius: 4px; 
    display: flex; 
    justify-content: space-between; 
    align-items: center; 
    cursor: pointer;
    font-size: 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
  }
  .copy-field span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 200px; }

  .schedule-wrap { background: var(--sl-color-bg-inline-code); padding: 0.75rem; border-radius: 4px; border: 1px solid var(--sl-color-gray-5); }
  .schedule-wrap code { font-size: 0.7rem; color: #9d7cfd; word-break: break-all; background: transparent !important; }

  .mono { font-family: var(--sl-font-mono); }

  @media (max-width: 800px) {
    .secondary-column { width: 100%; }
    .val-large { font-size: 2.4rem; }
  }
</style>

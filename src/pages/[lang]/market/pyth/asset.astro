---
// src/pages/[lang]/market/pyth/asset.astro
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getI18nPaths } from '@/content/config/i18n';

export async function getStaticPaths() {
  return getI18nPaths();
}

const { lang } = Astro.params;
---

<StarlightPage frontmatter={{ title: `Asset Detail`, tableOfContents: false }}>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
  
  <div class="detail-wrapper">
    <div class="wormhole-bg-fixed" aria-hidden="true">
      <svg viewBox="0 0 1000 1000" xmlns="http://www.w3.org/2000/svg">
        <g transform="translate(850, 250)">
          <g>
            <animateTransform attributeName="transform" type="rotate" from="0" to="360" dur="240s" repeatCount="indefinite" />
            <rect x="-1" y="100" width="1" height="1000" fill="#9d7cfd" fill-opacity="0.1" />
          </g>
        </g>
      </svg>
    </div>

    <div class="header-nav">
      <a href={`/${lang}/market/pyth/`} class="back-btn"><i class="fas fa-arrow-left"></i> Explorer</a>
    </div>

    <div id="loader" class="glass-panel text-center" style="padding: 5rem; text-align: center;">
      <i class="fas fa-circle-notch fa-spin"></i> Loading asset data...
    </div>

    <div id="content" class="main-grid" style="display: none;">
      <div class="primary-column">
        <div class="glass-panel info-hero">
          <div class="top-row">
            <span id="asset-type" class="type-tag">---</span>
            <div class="live-indicator">
              <div id="status-dot" class="dot"></div>
              <span id="last-update" class="mono">Syncing...</span>
            </div>
          </div>
          <h1 id="asset-symbol" class="asset-title">---</h1>
          <p id="asset-desc" class="sub-text">---</p>
          
          <div class="price-stack">
            <div class="price-item">
              <label>Current Price (USD)</label>
              <div id="live-price" class="val-large mono">---</div>
            </div>
            <div class="price-item">
              <label>Confidence (±)</label>
              <div id="live-conf" class="val-medium mono">---</div>
            </div>
          </div>
        </div>

        <div class="glass-panel chart-box">
          <div class="box-label"><i class="fas fa-chart-line"></i> Market Chart</div>
          <div class="chart-container-inner" id="tradingview-container"></div>
        </div>
      </div>

      <div class="secondary-column">
        <div class="glass-panel side-info">
          <h3>Specifications</h3>
          <div class="spec-row">
            <label>Price Feed ID</label>
            <div class="copy-field" id="copy-btn" title="Click to copy ID">
              <span id="display-id" class="mono truncate-id">---</span>
              <i class="fas fa-copy" id="copy-icon"></i>
            </div>
          </div>
          <div class="spec-row">
            <label>Pair</label>
            <span id="display-pair" class="val">---</span>
          </div>
          <div class="spec-row">
            <label>Network Slot</label>
            <span id="live-slot" class="val mono">---</span>
          </div>
        </div>

        <div class="glass-panel side-info">
          <h3>Market Schedule</h3>
          <div class="schedule-wrap">
            <code id="display-schedule" class="mono">---</code>
          </div>
        </div>
      </div>
    </div>
  </div>
</StarlightPage>

<script is:inline src="https://s3.tradingview.com/tv.js"></script>
<script is:inline>
  window.currentAssetSymbol = "";
  window.fullPriceFeedId = ""; // Uložíme si celé ID pro kopírování

  async function initDetail() {
    const params = new URLSearchParams(window.location.search);
    const id = params.get('id');
    
    if (!id) {
      window.location.href = './';
      return;
    }

    window.fullPriceFeedId = id;

    try {
      const metaRes = await fetch(`https://benchmarks.pyth.network/v1/price_feeds/${id}`);
      if (!metaRes.ok) throw new Error("Metadata not found");
      
      const meta = await metaRes.json();
      const attr = meta.attributes || {};

      document.getElementById('asset-symbol').innerText = attr.display_symbol || attr.symbol || 'Unknown';
      document.getElementById('asset-desc').innerText = attr.description || '';
      document.getElementById('asset-type').innerText = `${attr.asset_type || ''} ${attr.country || ''}`;
      document.getElementById('display-pair').innerText = `${attr.base || ''} / ${attr.quote_currency || ''}`;
      document.getElementById('display-schedule').innerText = attr.schedule || 'N/A';
      
      // Zobrazení ID (CSS se postará o oříznutí)
      document.getElementById('display-id').innerText = id;

      document.getElementById('loader').style.display = 'none';
      document.getElementById('content').style.display = 'flex';

      window.currentAssetSymbol = (attr.display_symbol || attr.symbol || "").replace(/[^a-zA-Z0-9]/g, '');
      renderChart(window.currentAssetSymbol);
      
      updatePrice(id);
      setInterval(() => updatePrice(id), 3000);

    } catch (e) {
      console.error("Initialization error:", e);
      document.getElementById('loader').innerHTML = `Asset not found.`;
    }
  }

  async function updatePrice(id) {
    try {
      const res = await fetch(`https://hermes.pyth.network/v2/updates/price/latest?ids[]=${id}&parsed=true`);
      const d = await res.json();
      const p = d.parsed?.[0]?.price;
      if (p) {
        const v = parseFloat(p.price) * Math.pow(10, p.expo);
        const c = parseFloat(p.conf) * Math.pow(10, p.expo);
        document.getElementById('live-price').innerText = v.toLocaleString(undefined, { maximumFractionDigits: 8 });
        document.getElementById('live-conf').innerText = c.toLocaleString(undefined, { maximumFractionDigits: 8 });
        document.getElementById('live-slot').innerText = d.parsed?.[0]?.metadata?.slot || '---';
        
        const age = Math.floor(Date.now() / 1000) - parseInt(p.publish_time);
        document.getElementById('status-dot').style.background = age < 30 ? '#10b981' : '#ef4444';
        document.getElementById('last-update').innerText = age + 's ago';
      }
    } catch (e) {}
  }

  function renderChart(symbol) {
    const isDark = document.documentElement.dataset.theme === 'dark';
    const container = document.getElementById('tradingview-container');
    if (!container) return;
    
    container.innerHTML = '';

    new TradingView.widget({
      "autosize": true,
      "symbol": `PYTH:${symbol || "BTCUSD"}`,
      "interval": "D",
      "theme": isDark ? "dark" : "light",
      "style": "1",
      "container_id": "tradingview-container",
      "backgroundColor": isDark ? "#131722" : "#ffffff",
      "gridColor": isDark ? "rgba(157, 124, 253, 0.05)" : "rgba(0, 0, 0, 0.05)"
    });
  }

  // Funkce pro kopírování
  document.getElementById('copy-btn').onclick = function() {
    if (!window.fullPriceFeedId) return;
    navigator.clipboard.writeText(window.fullPriceFeedId);
    
    const icon = document.getElementById('copy-icon');
    icon.classList.remove('fa-copy');
    icon.classList.add('fa-check');
    icon.style.color = "#10b981";
    
    setTimeout(() => {
      icon.classList.remove('fa-check');
      icon.classList.add('fa-copy');
      icon.style.color = "";
    }, 2000);
  };

  const themeObserver = new MutationObserver(() => {
    if (window.currentAssetSymbol) renderChart(window.currentAssetSymbol);
  });
  themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

  window.addEventListener('load', initDetail);
</script>

<style is:global>
  .main-frame, .content-panel, .sl-container { max-width: 100% !important; width: 100% !important; background: transparent !important; }
</style>

<style>
  .detail-wrapper { position: relative; width: 100%; color: var(--sl-color-text); }
  .wormhole-bg-fixed { position: fixed; inset: 0; z-index: -1; pointer-events: none; background: var(--sl-color-bg); }
  .header-nav { margin-bottom: 1rem; }
  .back-btn { color: var(--sl-color-gray-3); text-decoration: none; font-size: 0.9rem; font-weight: bold; }
  .main-grid { display: flex; flex-wrap: wrap; gap: 1rem; width: 100%; align-items: start; }
  .primary-column { flex: 1; min-width: 320px; display: flex; flex-direction: column; gap: 1rem; }
  .secondary-column { width: 320px; display: flex; flex-direction: column; gap: 1rem; }
  .glass-panel { background: var(--sl-color-bg-nav) !important; backdrop-filter: blur(20px); border: 1px solid var(--sl-color-gray-5) !important; border-radius: 0.5rem; padding: 1.5rem; }
  
  .top-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
  .type-tag { font-size: 0.7rem; text-transform: uppercase; background: rgba(157, 124, 253, 0.15); color: #9d7cfd; padding: 0.2rem 0.6rem; border-radius: 4px; font-weight: bold; border: 1px solid rgba(157, 124, 253, 0.3); }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: #444; }
  
  .asset-title { font-size: 2.5rem; margin: 0 !important; color: var(--sl-color-white) !important; }
  .sub-text { color: var(--sl-color-gray-3); margin: 0.5rem 0 1.5rem 0; font-size: 1rem; line-height: 1.4; }
  
  .price-stack { padding-top: 1.5rem; border-top: 1px solid var(--sl-color-gray-6); display: flex; flex-direction: column; gap: 1.5rem; }
  .price-item label { display: block; font-size: 0.75rem; color: var(--sl-color-gray-4); text-transform: uppercase; margin-bottom: 0.25rem; }
  .val-large { font-size: 3.2rem; font-weight: bold; line-height: 1; color: var(--sl-color-white); }
  .val-medium { font-size: 1.6rem; color: #9d7cfd; font-weight: bold; }
  
  .chart-box { padding: 0; overflow: hidden; }
  .box-label { padding: 1rem 1.5rem; font-size: 0.8rem; color: #9d7cfd; border-bottom: 1px solid var(--sl-color-gray-6); font-weight: bold; text-transform: uppercase; }
  .chart-container-inner { height: 500px; width: 100%; }
  
  h3 { font-size: 0.85rem; color: #9d7cfd; text-transform: uppercase; margin-bottom: 1.25rem !important; border-bottom: 1px solid var(--sl-color-gray-6); padding-bottom: 0.5rem; }
  .spec-row { margin-bottom: 1rem; }
  .spec-row label { display: block; font-size: 0.7rem; color: var(--sl-color-gray-4); text-transform: uppercase; margin-bottom: 0.2rem; }
  .val { color: var(--sl-color-white); font-weight: 500; font-size: 0.95rem; }
  
  /* OPRAVENÉ OŘEZÁVÁNÍ ID */
  .copy-field { 
    background: var(--sl-color-bg-inline-code); 
    padding: 0.6rem; 
    border-radius: 4px; 
    display: flex; 
    justify-content: space-between; 
    align-items: center; 
    cursor: pointer;
    font-size: 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    gap: 10px;
    transition: all 0.2s;
  }
  .copy-field:hover { border-color: #9d7cfd; background: var(--sl-color-gray-6); }
  .truncate-id { 
    overflow: hidden; 
    text-overflow: ellipsis; 
    white-space: nowrap; 
    display: block;
    flex: 1;
  }
  .copy-field i { color: var(--sl-color-gray-3); font-size: 0.9rem; }

  .schedule-wrap { background: var(--sl-color-bg-inline-code); padding: 0.75rem; border-radius: 4px; border: 1px solid var(--sl-color-gray-5); }
  .schedule-wrap code { font-size: 0.7rem; color: #9d7cfd; word-break: break-all; background: transparent !important; }
  .mono { font-family: var(--sl-font-mono); }
  
  @media (max-width: 800px) { .secondary-column { width: 100%; } .val-large { font-size: 2.4rem; } }
</style>

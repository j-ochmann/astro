---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import fs from 'node:fs';
import path from 'node:path';
import { PATHS } from '../../../scripts/fetch/fetch.config.ts'; 
import { getI18nPaths } from '@/content/config/i18n';

export async function getStaticPaths() {
  return getI18nPaths();
}

const { lang } = Astro.params;
const RAW_DIR = path.join(process.cwd(), PATHS.RAW, PATHS.CHAINLINK_ALL);

let rawData = [];
let latestFile = "";
let humanTimestamp = "No data";

try {
  if (fs.existsSync(RAW_DIR)) {
    const files = fs.readdirSync(RAW_DIR).filter(f => f.startsWith('chainlink_full_'));
    latestFile = files.sort().reverse()[0];
    if (latestFile) {
      rawData = JSON.parse(fs.readFileSync(path.join(RAW_DIR, latestFile), 'utf-8'));
      const parts = latestFile.replace('chainlink_full_', '').replace('.json', '').split('T');
      if (parts.length === 2) {
        const dateObj = new Date(`${parts[0]}T${parts[1].replace(/-/g, ':')}`);
        humanTimestamp = !isNaN(dateObj.getTime()) ? dateObj.toLocaleString(lang === 'cs' ? 'cs-CZ' : 'en-US') : "N/A";
      }
    }
  }
} catch (e) { console.error(e); }

const feeds = rawData
  .filter((f: any) => f.name && f.name !== 'Unknown')
  .map((f: any) => ({
    name: f.name.trim(),
    searchName: f.name.toLowerCase().replace(/\s+/g, ''),
    category: f.feedCategory && f.feedCategory !== 'medium' ? f.feedCategory : 'Asset',
    price: f.liveData?.realPrice || 0,
    decimals: f.liveData?.decimals || 8,
    updatedAt: f.liveData?.updatedAt ? new Date(f.liveData.updatedAt) : null,
    roundId: f.liveData?.roundId || 'N/A',
    address: f.proxyAddress || f.contractAddress || 'N/A'
  }))
  .sort((a: any, b: any) => a.name.localeCompare(b.name));

const RAY_COUNT = 65;
---

<StarlightPage frontmatter={{ title: "Chainlink Oracle Explorer", tableOfContents: false }}>
  
  <div class="explorer-visual-context">
    <div class="wormhole-background" aria-hidden="true">
      <svg viewBox="0 0 1000 1000" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="ray-gradient" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="10%" stop-color="var(--sl-color-accent)" stop-opacity="0" />
            <stop offset="40%" stop-color="var(--sl-color-accent)" stop-opacity="0.3" />
            <stop offset="90%" stop-color="var(--sl-color-accent-high)" stop-opacity="0" />
          </linearGradient>
        </defs>
        <g transform="translate(850, 250)">
          <g>
            <animateTransform attributeName="transform" type="rotate" from="0" to="360" dur="240s" repeatCount="indefinite" />
            {Array.from({ length: RAY_COUNT }).map((_, i) => (
              <rect x="-1" y="100" width="1" height="1000" fill="url(#ray-gradient)" transform={`rotate(${(360 / RAY_COUNT) * i})`} />
            ))}
          </g>
          <circle r="180" fill="var(--sl-color-bg)" filter="blur(50px)" />
        </g>
      </svg>
    </div>

    <div class="explorer-content">
      <div class="stats-grid">
        <div class="stat-card glass-panel">
          <span class="label">Total Feeds</span>
          <span class="value">{feeds.length}</span>
        </div>
        <div class="stat-card glass-panel">
          <span class="label">Last Sync</span>
          <span class="value">{humanTimestamp}</span>
        </div>
      </div>

      <div class="controls-row">
        <input type="text" id="oracleSearch" class="glass-panel" placeholder="Search pair..." autocomplete="off" />
        <div class="export-group">
          <button onclick="exportData('json')" class="glass-btn">JSON</button>
          <button onclick="exportData('csv')" class="glass-btn">CSV</button>
          <button onclick="exportData('xml')" class="glass-btn">XML</button>
          <button onclick="exportData('yaml')" class="glass-btn">YAML</button>
        </div>
      </div>

      <div class="table-container glass-panel">
        <table id="oracleTable">
          <thead>
            <tr>
              <th class="th-pair">Pair</th>
              <th class="th-price">Latest Price</th>
              <th class="th-status">Status</th>
              <th class="th-update">Last Update</th>
              <th class="th-address">Address</th>
              <th class="th-round">Round ID</th>
              <th class="th-cat">Category</th>
            </tr>
          </thead>
          <tbody>
            {feeds.map((f: any) => (
              <tr data-json={JSON.stringify(f)} data-name={f.searchName}>
                <td class="td-pair">
                  <a href={`/${lang}/market/chainlink/${f.address}/`} class="pair-link" title={f.name}>
                    {f.name}
                  </a>
                </td>
                <td class="cell-price">{f.price.toLocaleString(undefined, { maximumFractionDigits: 10 })}</td>
                <td><div class={`status-dot ${f.price > 0 ? 'active' : 'inactive'}`}></div></td>
                <td>{f.updatedAt ? f.updatedAt.toLocaleTimeString() : 'N/A'}</td>
                <td class="cell-mono opacity-50">{f.address.slice(0, 10)}...</td>
                <td class="cell-mono opacity-50">{f.roundId}</td>
                <td><span class="badge-cat">{f.category}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</StarlightPage>

<script is:inline>
  const searchInput = document.getElementById('oracleSearch');
  searchInput.addEventListener('input', () => {
    const term = searchInput.value.toLowerCase().replace(/\s+/g, '');
    document.querySelectorAll('#oracleTable tbody tr').forEach(row => {
      row.style.display = row.getAttribute('data-name').includes(term) ? '' : 'none';
    });
  });

  window.exportData = (type) => {
    const rows = Array.from(document.querySelectorAll('#oracleTable tbody tr:not([style*="none"])'))
      .map(tr => JSON.parse(tr.getAttribute('data-json')));
    if (!rows.length) return;
    let content = '', mime = 'text/plain';
    if (type === 'json') { content = JSON.stringify(rows, null, 2); mime = 'application/json'; }
    else if (type === 'csv') {
      const keys = Object.keys(rows[0]);
      content = [keys.join(','), ...rows.map(r => keys.map(k => `"${r[k]}"`).join(','))].join('\n');
      mime = 'text/csv';
    } else if (type === 'xml') {
      content = '<?xml version="1.0"?><root>' + rows.map(r => '<item>' + Object.entries(r).map(([k,v]) => `<${k}>${v}</${k}>`).join('') + '</item>').join('') + '</root>';
      mime = 'application/xml';
    } else if (type === 'yaml') {
      content = rows.map(r => Object.entries(r).map(([k,v]) => `${k}: ${v}`).join('\n')).join('\n---\n');
    }
    const blob = new Blob([content], { type: mime });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = `chainlink_export.${type}`; a.click();
  };
</script>

<style is:global>
  .main-frame, .content-panel, .sl-container { 
    max-width: 100% !important; width: 100% !important; margin: 0 !important; background: transparent !important; 
  }
  .sl-markdown-content > :first-child { margin-top: 0 !important; }
</style>

<style>
  .explorer-visual-context { position: relative; margin: -2rem -3rem; padding: 2rem 3rem; }
  .wormhole-background { position: fixed; inset: 0; z-index: -1; pointer-events: none; background: var(--sl-color-bg); }

  /* Sjednocená Glass receptura */
  .glass-panel {
    background: rgba(var(--sl-color-bg-nav-rgb), 0.85) !important;
    backdrop-filter: blur(30px) !important;
    border: 1px solid var(--sl-color-gray-5) !important;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }

  :root[data-theme='light'] .glass-panel {
    background: rgba(255, 255, 255, 0.8) !important;
    border-color: rgba(0, 0, 0, 0.1) !important;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.05);
  }

  /* Grid a karty */
  .stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 2rem; }
  .stat-card { 
    padding: 1.5rem; border-radius: 0.75rem; min-height: 100px;
    display: flex; flex-direction: column; justify-content: center; margin-top: 0 !important;
  }
  .label { font-size: 0.75rem; color: var(--sl-color-gray-3); text-transform: uppercase; margin-bottom: 0.25rem; }
  .value { font-size: 1.2rem; font-weight: bold; color: var(--sl-color-white); }
  :root[data-theme='light'] .value { color: #000 !important; }
  :root[data-theme='light'] .label { color: #444 !important; }

  /* Search bar */
  .controls-row { display: flex; gap: 1rem; margin-bottom: 1.5rem; height: 44px; align-items: stretch; }
  #oracleSearch { 
    flex: 1; padding: 0 1rem; border-radius: 0.5rem; color: var(--sl-color-white); height: 100%; outline: none;
  }
  :root[data-theme='light'] #oracleSearch { color: #000 !important; }

  /* Tlačítka - sdílejí skleněný vzhled s barevným akcentem */
  .export-group { display: flex; gap: 0.5rem; height: 100%; }
  .glass-btn { 
    background: rgba(var(--sl-color-accent-rgb), 0.2) !important;
    backdrop-filter: blur(30px) !important;
    border: 1px solid var(--sl-color-gray-5) !important;
    color: var(--sl-color-white) !important; 
    padding: 0 1.25rem; border-radius: 0.5rem; 
    cursor: pointer; font-size: 0.75rem; font-weight: bold;
    height: 100%; display: flex; align-items: center; margin: 0 !important;
    transition: all 0.2s ease;
  }
  .glass-btn:hover { 
    background: var(--sl-color-accent) !important; 
    border-color: var(--sl-color-accent-high) !important;
    box-shadow: 0 0 15px rgba(var(--sl-color-accent-rgb), 0.4);
  }
  :root[data-theme='light'] .glass-btn { color: var(--sl-color-accent-high) !important; }

  /* Tabulka */
  .table-container { border-radius: 0.75rem; overflow-x: auto; }
  table { width: 100%; border-collapse: separate; border-spacing: 0; min-width: 800px; }
  th { 
    background: rgba(var(--sl-color-accent-rgb), 0.1); 
    padding: 1rem; text-align: left; color: var(--sl-color-accent-high); 
    border-bottom: 2px solid var(--sl-color-gray-5);
    font-size: 0.8rem; white-space: nowrap;
  }

  tbody tr { background: rgba(255, 255, 255, 0.01); transition: background 0.1s ease; }
  tbody tr:hover { background: rgba(var(--sl-color-accent-rgb), 0.08); }

  td { padding: 0.85rem 1rem; border-bottom: 1px solid var(--sl-color-gray-6); white-space: nowrap; color: var(--sl-color-gray-2); }
  :root[data-theme='light'] td { color: #333; border-bottom-color: rgba(0,0,0,0.05); }

  .th-pair { width: 160px; }
  .td-pair { max-width: 160px; overflow: hidden; text-overflow: ellipsis; }
  .pair-link { color: var(--sl-color-accent-high) !important; font-weight: bold; text-decoration: none; }
  .pair-link:hover { text-decoration: underline; }
  .cell-price { font-family: 'JetBrains Mono', monospace; font-weight: bold; color: var(--sl-color-white); }
  :root[data-theme='light'] .cell-price { color: #000; }
  
  .status-dot { width: 10px; height: 10px; border-radius: 50%; margin: 0 auto; }
  .active { background: #10b981; box-shadow: 0 0 10px #10b981; }
  .inactive { background: #ef4444; }
  .badge-cat { font-size: 0.65rem; background: rgba(var(--sl-color-accent-rgb), 0.15); border: 1px solid rgba(var(--sl-color-accent-rgb), 0.2); padding: 0.2rem 0.5rem; border-radius: 4px; color: var(--sl-color-accent-high); }

  @media (max-width: 800px) {
    .stats-grid { grid-template-columns: 1fr; }
    .controls-row { height: auto; flex-direction: column; }
    .export-group { justify-content: space-between; }
  }
</style>

---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import SearchFilterBar from '@/components/root/SearchFilterBar.astro';
import fs from 'node:fs';
import path from 'node:path';
import { PATHS } from '../../../scripts/fetch/fetch.config.ts'; 
import { getI18nPaths } from '@/content/config/i18n';

export async function getStaticPaths() {
  return getI18nPaths();
}

const { lang } = Astro.params;
const RAW_DIR = path.join(process.cwd(), PATHS.RAW, PATHS.PYTH_ALL);

let rawData: any[] = [];
let humanTimestamp = "Initializing Live Data...";

if (fs.existsSync(RAW_DIR)) {
  try {
    const files = fs.readdirSync(RAW_DIR).filter(f => f.startsWith('pyth_full_'));
    const latestFile = files.sort().reverse()[0];
    if (latestFile) {
      rawData = JSON.parse(fs.readFileSync(path.join(RAW_DIR, latestFile), 'utf-8'));
    }
  } catch (e) { console.error("Build load error:", e); }
}

const feeds = rawData.map((f: any) => {
  const live = f.live_data?.price || { price: "0", expo: 0, publish_time: 0 };
  const fullId = f.id.startsWith('0x') ? f.id : `0x${f.id}`;
  const categoryName = String(f.attributes?.asset_type || 'Asset');
  
  return {
    id: fullId,
    name: String(f.attributes?.display_symbol || f.attributes?.symbol || 'Unknown'),
    searchName: String(f.attributes?.symbol || '').toLowerCase().replace(/\s+/g, ''),
    price: parseFloat(live.price),
    expo: live.expo,
    updatedAt: live.publish_time ? new Date(live.publish_time * 1000) : null,
    category: categoryName,
    detailUrl: `/${lang}/market/pyth/${fullId}`
  };
}).sort((a: any, b: any) => a.name.localeCompare(b.name));

// Výpočet kategorií včetně počtu prvků (pro badge v komponentě)
const categories = Array.from(new Set(feeds.map(f => f.category))).map(cat => ({
  label: String(cat),
  value: String(cat).toLowerCase(),
  count: feeds.filter(f => f.category === cat).length
}));

const RAY_COUNT = 65;
---

<StarlightPage frontmatter={{ title: "Pyth Network Explorer", tableOfContents: false }}>
  <div class="explorer-visual-context">
    <div class="wormhole-background" aria-hidden="true">
      <svg viewBox="0 0 1000 1000" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="ray-gradient-pyth" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="10%" stop-color="#e6dafe" stop-opacity="0" />
            <stop offset="40%" stop-color="#9d7cfd" stop-opacity="0.3" />
            <stop offset="90%" stop-color="#6633ee" stop-opacity="0" />
          </linearGradient>
        </defs>
        <g transform="translate(850, 250)">
          <g>
            <animateTransform attributeName="transform" type="rotate" from="0" to="360" dur="240s" repeatCount="indefinite" />
            {Array.from({ length: RAY_COUNT }).map((_, i) => (
              <rect x="-1" y="100" width="1" height="1000" fill="url(#ray-gradient-pyth)" transform={`rotate(${(360 / RAY_COUNT) * i})`} />
            ))}
          </g>
          <circle r="180" fill="var(--sl-color-bg)" filter="blur(50px)" />
        </g>
      </svg>
    </div>

    <div class="explorer-content">
      <div class="stats-grid">
        <div class="stat-card explorer-glass">
          <span class="label">Pyth Feeds</span>
          <span class="value" id="stat-total">{feeds.length}</span>
        </div>
        <div class="stat-card explorer-glass">
          <span class="label">Network Status</span>
          <span class="value" id="stat-sync">{humanTimestamp}</span>
        </div>
      </div>

      <SearchFilterBar 
        searchPlaceholder="Search Pyth symbols..." 
        filterLabel="Asset Type"
        filterOptions={categories}
      />

      <div class="table-container explorer-glass">
        <table id="oracleTable">
          <thead>
            <tr>
              <th class="th-pair">Symbol</th>
              <th class="th-price">Price</th>
              <th class="th-status">Live</th>
              <th class="th-update">Publish Time</th>
              <th class="th-address">Feed ID</th>
              <th class="th-cat">Type</th>
            </tr>
          </thead>
          <tbody>
            {feeds.map((f: any) => (
              <tr data-id={f.id} data-category={f.category.toLowerCase()} data-name={f.searchName}>
                <td class="td-pair">
                  <a href={f.detailUrl} class="pair-link">{f.name}</a>
                </td>
                <td class="cell-price js-price">
                  {f.price > 0 ? (f.price * Math.pow(10, f.expo)).toLocaleString(undefined, { maximumFractionDigits: 8 }) : "0.00"}
                </td>
                <td class="td-status">
                  <div class="status-dot js-status" style="background: #ef4444;"></div>
                </td>
                <td class="js-update cell-update">{f.updatedAt ? f.updatedAt.toLocaleTimeString() : 'N/A'}</td>
                <td class="cell-mono opacity-50 small">{f.id.slice(0, 14)}...</td>
                <td class="td-cat"><span class="badge-row">{f.category}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</StarlightPage>

<script is:inline define:vars={{ lang }}>
  window.exportData = (type) => {
    console.log(`Exporting as ${type}...`);
  };

  const syncLabel = document.getElementById('stat-sync');
  const searchInput = document.getElementById('searchTab');
  const tableRows = document.querySelectorAll('#oracleTable tbody tr');
  const activeFilterCountBadge = document.getElementById('activeFilterCount');
  const visibleIds = new Set();
  
  let activeCategory = null;

  function filterTable() {
    const term = searchInput ? searchInput.value.toLowerCase() : '';
    let visibleCount = 0;
    
    tableRows.forEach(row => {
      const name = row.getAttribute('data-name') || '';
      const category = row.getAttribute('data-category') || '';
      const matchesSearch = name.includes(term);
      const matchesCategory = !activeCategory || category === activeCategory;
      
      if (matchesSearch && matchesCategory) {
        row.style.display = '';
        visibleCount++;
      } else {
        row.style.display = 'none';
      }
    });

    // Aktualizace badge na tlačítku filtru
    if (activeFilterCountBadge) {
      activeFilterCountBadge.innerText = activeCategory ? "1" : "0";
    }
  }

  if (searchInput) {
    searchInput.addEventListener('input', filterTable);
  }

  // Logika výběru kategorie
  document.querySelectorAll('.cat-item').forEach(item => {
    item.addEventListener('click', (e) => {
      e.stopPropagation();
      const cat = item.getAttribute('data-cat');
      
      if (activeCategory === cat) {
        activeCategory = null;
        item.classList.remove('active');
      } else {
        document.querySelectorAll('.cat-item').forEach(i => i.classList.remove('active'));
        activeCategory = cat;
        item.classList.add('active');
      }
      filterTable();
      // Zavřít dropdown po výběru
      item.parentElement.classList.remove('show');
    });
  });

  // Přepínání View (Table/Grid) - UI část
  document.querySelectorAll('.view-item').forEach(item => {
    item.addEventListener('click', (e) => {
      e.stopPropagation();
      document.querySelectorAll('.view-item').forEach(i => i.classList.remove('active'));
      item.classList.add('active');
      const view = item.getAttribute('data-view');
      console.log("Switching to", view);
      item.parentElement.classList.remove('show');
    });
  });

  // Dropdown Toggle
  document.querySelectorAll('.glass-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const dropdown = btn.nextElementSibling;
      if (dropdown && dropdown.classList.contains('dropdown-content')) {
        const isShown = dropdown.classList.contains('show');
        document.querySelectorAll('.dropdown-content').forEach(d => d.classList.remove('show'));
        if (!isShown) dropdown.classList.add('show');
      }
    });
  });

  window.addEventListener('click', () => {
    document.querySelectorAll('.dropdown-content').forEach(d => d.classList.remove('show'));
  });

  // Live Updates
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      const id = entry.target.getAttribute('data-id');
      const dot = entry.target.querySelector('.js-status');
      if (entry.isIntersecting) {
        visibleIds.add(id);
      } else {
        visibleIds.delete(id);
        if (dot) {
          dot.style.background = '#ef4444';
          dot.style.boxShadow = 'none';
        }
      }
    });
  }, { threshold: 0.01, rootMargin: '100px' });

  tableRows.forEach(row => observer.observe(row));

  async function refreshData() {
    if (visibleIds.size === 0) return;
    const idsArray = Array.from(visibleIds);
    const chunkSize = 25; 
    const now = Math.floor(Date.now() / 1000);
    
    for (let i = 0; i < idsArray.length; i += chunkSize) {
      const chunk = idsArray.slice(i, i + chunkSize);
      const query = chunk.map(id => `ids[]=${id}`).join('&');
      const url = `https://hermes.pyth.network/v2/updates/price/latest?${query}&parsed=true`;

      try {
        const response = await fetch(url);
        if (!response.ok) continue;
        const data = await response.json();
        if (data && data.parsed) {
          data.parsed.forEach(item => {
            const normId = item.id.startsWith('0x') ? item.id : '0x' + item.id;
            const row = document.querySelector(`tr[data-id="${normId}"]`);
            if (row) {
              const priceCell = row.querySelector('.js-price');
              const statusDot = row.querySelector('.js-status');
              const updateCell = row.querySelector('.js-update');
              const val = parseFloat(item.price.price);
              const expo = parseInt(item.price.expo);
              const pubTime = parseInt(item.price.publish_time);
              const age = now - pubTime;

              if (val > 0) {
                const newPrice = val * Math.pow(10, expo);
                const formattedPrice = newPrice.toLocaleString(undefined, { maximumFractionDigits: 8 });
                if (priceCell.innerText !== formattedPrice) {
                  priceCell.innerText = formattedPrice;
                  priceCell.classList.add('price-flash');
                  setTimeout(() => priceCell.classList.remove('price-flash'), 2000);
                }
                updateCell.innerText = new Date(pubTime * 1000).toLocaleTimeString();
                if (age < 15) {
                   statusDot.style.background = '#10b981';
                   statusDot.style.boxShadow = '0 0 10px #10b981';
                } else if (age < 60) {
                   statusDot.style.background = '#f59e0b';
                   statusDot.style.boxShadow = '0 0 10px #f59e0b';
                } else {
                   statusDot.style.background = '#ef4444';
                   statusDot.style.boxShadow = 'none';
                }
              }
            }
          });
        }
      } catch (err) { console.error('Pyth fetch fail:', err); }
    }
    if (syncLabel) syncLabel.innerText = "Live / " + new Date().toLocaleTimeString();
  }
  setInterval(refreshData, 3000);
</script>

<style is:global>
  .main-frame, .content-panel, .sl-container { max-width: 100% !important; width: 100% !important; margin: 0 !important; background: transparent !important; }
  @keyframes flash-price { 0% { color: #9d7cfd; text-shadow: 0 0 10px #9d7cfd; } 100% { color: var(--sl-color-white); text-shadow: none; } }
  .price-flash { animation: flash-price 2s ease-out; }
</style>

<style>
  .explorer-visual-context { position: relative; margin: -2rem -3rem; padding: 2rem 3rem; }
  .wormhole-background { position: fixed; inset: 0; z-index: -1; pointer-events: none; background: var(--sl-color-bg); }
  
  .explorer-glass { 
    background: rgba(var(--sl-color-bg-nav-rgb), 0.7) !important; 
    backdrop-filter: blur(20px) !important; 
    border: 1px solid var(--sl-color-gray-5) !important; 
  }
  
  .stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 2rem; }
  .stat-card { padding: 1.5rem; border-radius: 0.75rem; min-height: 100px; display: flex; flex-direction: column; justify-content: center; margin-top: 0 !important; }
  .label { font-size: 0.75rem; color: var(--sl-color-gray-3); text-transform: uppercase; margin-bottom: 0.25rem; }
  .value { font-size: 1.2rem; font-weight: bold; color: var(--sl-color-white); }

  .table-container { border-radius: 0.75rem; overflow-x: auto; width: 100%; }
  table { width: 100%; border-collapse: separate; border-spacing: 0; table-layout: fixed; }
  
  th, td { padding: 1rem; border-bottom: 1px solid var(--sl-color-gray-6); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .th-pair, .td-pair { width: 20%; }
  .th-price, .cell-price { width: 20%; }
  .th-status, .td-status { width: 8%; text-align: center; }
  .th-update, .cell-update { width: 15%; }
  .th-address { width: 22%; }
  .th-cat, .td-cat { width: 15%; text-align: right; }

  th { background: rgba(157, 124, 253, 0.1); text-align: left; color: #9d7cfd; border-bottom: 2px solid var(--sl-color-gray-5); font-size: 0.8rem; }
  tbody tr { background: rgba(255, 255, 255, 0.01); }
  tbody tr:hover { background: rgba(157, 124, 253, 0.08); }
  
  .pair-link { color: #9d7cfd !important; font-weight: bold; text-decoration: none; }
  .cell-price { font-family: 'JetBrains Mono', monospace; font-weight: bold; color: var(--sl-color-white); }
  
  .status-dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; transition: all 0.3s ease; }
  
  /* Badge v řádku tabulky */
  .badge-row { 
    font-size: 0.65rem; 
    background: rgba(157, 124, 253, 0.1); 
    border: 1px solid rgba(157, 124, 253, 0.2); 
    padding: 0.2rem 0.5rem; 
    border-radius: 4px; 
    color: #9d7cfd; 
    text-transform: uppercase;
    font-weight: 600;
  }

  @media (max-width: 1000px) {
    table { table-layout: auto; }
    .th-address, .cell-mono { display: none; }
  }
</style>

              updateCell.innerText = new Date(item.price.publish_time * 1000).toLocaleTimeString();
            }
          });
        }
      }
    } catch (err) { console.error('Pyth API Error:', err); }
  }

  setInterval(refreshData, 3000);

  // Search Logic
  document.getElementById('oracleSearch')?.addEventListener('input', (e) => {
    const term = e.target.value.toLowerCase().replace(/\s+/g, '');
    document.querySelectorAll('#oracleTable tbody tr').forEach(row => {
      const isMatch = row.getAttribute('data-name').includes(term);
      row.style.display = isMatch ? '' : 'none';
      if (!isMatch) visibleIds.delete(row.getAttribute('data-id'));
    });
  });

  window.exportData = (type) => {
    const rows = Array.from(document.querySelectorAll('#oracleTable tbody tr:not([style*="none"])'))

---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import SearchFilterBar from '@/components/root/SearchFilterBar.astro';
import fs from 'node:fs';
import path from 'node:path';
import { PATHS } from '../../../scripts/fetch/fetch.config.ts'; 
import { getI18nPaths } from '@/content/config/i18n';

export async function getStaticPaths() {
  return getI18nPaths();
}

interface FeedItem {
  id: string;
  name: string;
  description: string;
  searchStr: string;
  price: number;
  conf: number;
  expo: number;
  updatedAt: number;
  category: string;
  isActive: boolean;
  detailUrl: string;
}

const { lang } = Astro.params;
const RAW_DIR = path.join(process.cwd(), PATHS.RAW, PATHS.PYTH_ALL);

let rawData: any[] = [];
if (fs.existsSync(RAW_DIR)) {
  try {
    const files = fs.readdirSync(RAW_DIR).filter((f: string) => f.startsWith('pyth_full_'));
    const latestFile = files.sort().reverse()[0];
    if (latestFile) {
      rawData = JSON.parse(fs.readFileSync(path.join(RAW_DIR, latestFile), 'utf-8'));
    }
  } catch (e) { console.error("Build load error:", e); }
}

const NOW_TS = Math.floor(Date.now() / 1000);
const allFeeds: FeedItem[] = rawData.map((f: any): FeedItem => {
  const live = f.live_data?.price || { price: "0", conf: "0", expo: 0, publish_time: 0 };
  const fullId = f.id.startsWith('0x') ? f.id : `0x${f.id}`;
  const priceVal = parseFloat(live.price);
  const upAt = live.publish_time;
  return {
    id: fullId,
    name: f.attributes?.display_symbol || f.attributes?.symbol || 'Unknown',
    description: f.attributes?.description || '',
    searchStr: `${f.attributes?.symbol} ${f.attributes?.description}`.toLowerCase(),
    price: priceVal,
    conf: parseFloat(live.conf),
    expo: live.expo,
    updatedAt: upAt,
    category: f.attributes?.asset_type || 'Other',
    isActive: priceVal > 0 && (NOW_TS - upAt < 3600),
    detailUrl: `/${lang}/market/pyth/${fullId}`
  };
}).sort((a: FeedItem, b: FeedItem) => a.name.localeCompare(b.name));

const catStats = allFeeds.reduce((acc: Record<string, number>, f: FeedItem) => {
  acc[f.category] = (acc[f.category] || 0) + (f.isActive ? 1 : 0);
  return acc;
}, {});

const activeTotal = allFeeds.filter((f: FeedItem) => f.isActive).length;

const categoryOptions = [
  { label: 'All Assets', value: 'All', count: activeTotal },
  ...Object.keys(catStats).sort().map((cat: string) => ({
    label: cat.replace('Crypto Redemption Rate', 'Crypto RR'),
    value: cat,
    count: catStats[cat]
  }))
];
---

<StarlightPage frontmatter={{ title: "Pyth Explorer", tableOfContents: false }}>
  <div class="explorer-visual-context">
    <div class="wormhole-background" aria-hidden="true">
      <svg viewBox="0 0 1000 1000" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="ray-gradient-pyth" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="10%" stop-color="#9d7cfd" stop-opacity="0" />
            <stop offset="50%" stop-color="#9d7cfd" stop-opacity="0.15" />
            <stop offset="90%" stop-color="#9d7cfd" stop-opacity="0" />
          </linearGradient>
        </defs>
        <g transform="translate(850, 250)">
          <g>
            <animateTransform attributeName="transform" type="rotate" from="0" to="360" dur="240s" repeatCount="indefinite" />
            {Array.from({ length: 65 }).map((_, i) => (
              <rect x="-1" y="100" width="1" height="1000" fill="url(#ray-gradient-pyth)" transform={`rotate(${(360 / 65) * i})`} />
            ))}
          </g>
        </g>
      </svg>
    </div>

    <div class="explorer-content">
      <SearchFilterBar 
          searchPlaceholder="Search symbol or description..." 
          filterLabel="Asset Classes"
          filterOptions={categoryOptions}
          viewLabel="View"
          downloadLabel="Export"
      />

      <div class="table-container glass-panel">
        <table id="oracleTable">
          <thead>
            <tr>
              <th style="padding-left: 1.5rem; width: 150px">Symbol</th>
              <th>Description</th>
              <th style="width: 140px">Price</th>
              <th class="text-center" style="width: 80px">Live</th>
              <th style="width: 140px">Confidence</th>
              <th style="text-align: right; padding-right: 1.5rem; width: 120px">Time</th>
            </tr>
          </thead>
          <tbody id="tableBody"></tbody>
        </table>
      </div>
    </div>
  </div>
</StarlightPage>

<script is:inline define:vars={{ allFeeds }}>
  import { initExplorer } from '/src/scripts/pyth-explorer.js';
  initExplorer(allFeeds);
</script>

<style is:global>
  /* Reset Starlight */
  .main-frame, .content-panel, .sl-container { 
    max-width: 100% !important; width: 100% !important; margin: 0 !important; background: transparent !important; 
  }
  header.header, h1 { display: none !important; }
  
  /* Reset pro zarovnání */
  *, *::before, *::after { box-sizing: border-box; }

  @keyframes flash-price {
    0% { color: #9d7cfd; text-shadow: 0 0 10px #9d7cfd; }
    100% { color: inherit; text-shadow: none; }
  }
  .price-flash { animation: flash-price 1s ease-out; }
</style>

<style>
  .explorer-visual-context { position: relative; margin: -2rem -3rem; padding: 2rem 3rem; }
  .wormhole-background { position: fixed; inset: 0; z-index: -1; pointer-events: none; background: var(--sl-color-bg); }

  .glass-panel {
    background: rgba(var(--sl-color-bg-nav-rgb), 0.85) !important;
    backdrop-filter: blur(30px) !important;
    border: 1px solid var(--sl-color-gray-5) !important;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }

  .table-container { border-radius: 0.75rem; overflow: hidden; }
  table { width: 100%; border-collapse: separate; border-spacing: 0; }
  th { 
    background: rgba(157, 124, 253, 0.1); 
    padding: 1rem; 
    text-align: left; 
    color: #9d7cfd; 
    border-bottom: 2px solid var(--sl-color-gray-5); 
    font-size: 0.8rem; 
    text-transform: uppercase; 
  }
  
  .text-center { text-align: center; }

  @media (max-width: 1000px) {
    th:nth-child(2), td:nth-child(2), th:nth-child(5), td:nth-child(5) { display: none; }
  }
</style>

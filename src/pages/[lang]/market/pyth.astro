---
// src/pages/[lang]/market/pyth.astro
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import SearchFilterBar from '@/components/root/SearchFilterBar.astro';
import fs from 'node:fs';
import path from 'node:path';
import { PATHS } from '../../../scripts/fetch/fetch.config.ts'; 
import { getI18nPaths } from '@/content/config/i18n';
import '@fortawesome/fontawesome-free/css/all.min.css';

export async function getStaticPaths() {
  return getI18nPaths();
}

const { lang } = Astro.params;
const RAW_DIR = path.join(process.cwd(), PATHS.RAW, PATHS.PYTH_ALL);

let rawData: any[] = [];
let humanTimestamp = "Initializing Live Data...";

if (fs.existsSync(RAW_DIR)) {
  try {
    const files = fs.readdirSync(RAW_DIR).filter(f => f.startsWith('pyth_full_'));
    const latestFile = files.sort().reverse()[0];
    if (latestFile) {
      rawData = JSON.parse(fs.readFileSync(path.join(RAW_DIR, latestFile), 'utf-8'));
    }
  } catch (e) { console.error("Build load error:", e); }
}

const feeds = rawData.map((f: any) => {
  const live = f.live_data?.price || { price: "0", expo: 0, publish_time: 0 };
  const fullId = f.id.startsWith('0x') ? f.id : `0x${f.id}`;
  const categoryName = String(f.attributes?.asset_type || 'Asset');
  const description = String(f.attributes?.description || '');
  const symbol = String(f.attributes?.display_symbol || f.attributes?.symbol || 'Unknown');
  
  return {
    id: fullId,
    name: symbol,
    description: description,
    searchName: `${symbol} ${description}`.toLowerCase(),
    price: parseFloat(live.price),
    expo: live.expo,
    updatedAt: live.publish_time ? new Date(live.publish_time * 1000) : null,
    category: categoryName,
    // detailUrl: `/${lang}/market/pyth/${fullId}`
    detailUrl: `/${lang}/market/pyth/asset/?id=${fullId}`
  };
}).sort((a: any, b: any) => a.name.localeCompare(b.name));

const categories = Array.from(new Set(feeds.map(f => f.category))).map(cat => ({
  label: String(cat),
  value: String(cat).toLowerCase(),
  count: feeds.filter(f => f.category === cat).length
}));

const RAY_COUNT = 65;
const timeOptions: Intl.DateTimeFormatOptions = { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false };
---

<StarlightPage frontmatter={{ title: "Pyth Network Explorer", tableOfContents: false }}>
  <div class="explorer-visual-context">
    <div class="wormhole-background" aria-hidden="true">
      <svg viewBox="0 0 1000 1000" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="ray-gradient-pyth" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="10%" stop-color="#e6dafe" stop-opacity="0" />
            <stop offset="40%" stop-color="#9d7cfd" stop-opacity="0.3" />
            <stop offset="90%" stop-color="#6633ee" stop-opacity="0" />
          </linearGradient>
        </defs>
        <g transform="translate(850, 250)">
          <g>
            <animateTransform attributeName="transform" type="rotate" from="0" to="360" dur="240s" repeatCount="indefinite" />
            {Array.from({ length: RAY_COUNT }).map((_, i) => (
              <rect x="-1" y="100" width="1" height="1000" fill="url(#ray-gradient-pyth)" transform={`rotate(${(360 / RAY_COUNT) * i})`} />
            ))}
          </g>
          <circle r="180" fill="var(--sl-color-bg)" filter="blur(50px)" />
        </g>
      </svg>
    </div>

    <div class="explorer-content">
      <div class="stats-grid">
        <div class="stat-card glass-panel">
          <span class="label">Pyth Feeds</span>
          <span class="value" id="stat-total">{feeds.length}</span>
        </div>
        <div class="stat-card glass-panel">
          <span class="label">Network Status</span>
          <span class="value" id="stat-sync">{humanTimestamp}</span>
        </div>
      </div>

      <SearchFilterBar 
        searchPlaceholder="Search symbol or description..." 
        filterLabel="Asset Type"
        filterOptions={categories}
      />

      <div class="table-container glass-panel" id="mainViewContainer">
        <table id="oracleTable">
          <thead>
            <tr>
              <th class="th-pair">Symbol</th>
              <th class="th-desc">Description</th>
              <th class="th-price">Price</th>
              <th class="th-status">Live</th>
              <th class="th-update">Publish Time</th>
              <th class="th-cat">Type</th>
            </tr>
          </thead>
          <tbody>
            {feeds.map((f: any) => (
              <tr data-id={f.id} data-category={f.category.toLowerCase()} data-search={f.searchName}>
                <td class="td-pair">
                  <a href={f.detailUrl} class="pair-link">{f.name}</a>
                </td>
                <td class="td-desc">
                  <span class="asset-desc">{f.description}</span>
                </td>
                <td class="cell-price js-price">
                  {f.price > 0 ? (f.price * Math.pow(10, f.expo)).toLocaleString(undefined, { maximumFractionDigits: 8 }) : "0.00"}
                </td>
                <td class="td-status">
                  <div class="status-dot js-status" style="background: #ef4444;"></div>
                </td>
                <td class="js-update cell-update">
                  {f.updatedAt ? f.updatedAt.toLocaleTimeString(lang, timeOptions) : 'N/A'}
                </td>
                <td class="td-cat"><span class="badge-row">{f.category}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</StarlightPage>

<script is:inline define:vars={{ lang }}>
  const syncLabel = document.getElementById('stat-sync');
  const searchInput = document.getElementById('searchTab');
  const tableRows = document.querySelectorAll('#oracleTable tbody tr');
  const viewContainer = document.getElementById('mainViewContainer');
  const visibleIds = new Set();
  
  let activeCategory = null;
  const timeOptions = { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false };

  function filterAll() {
    const term = searchInput ? searchInput.value.toLowerCase().trim() : '';
    tableRows.forEach(row => {
      const rowSearch = row.getAttribute('data-search') || '';
      const rowCat = row.getAttribute('data-category') || '';
      const matchesSearch = rowSearch.includes(term);
      const matchesCategory = !activeCategory || rowCat === activeCategory;
      
      if (matchesSearch && matchesCategory) {
        row.style.setProperty('display', '', 'important');
      } else {
        row.style.setProperty('display', 'none', 'important');
      }
    });
  }

  if (searchInput) searchInput.addEventListener('input', filterAll);

  document.addEventListener('click', (e) => {
    const btn = e.target.closest('.glass-btn');
    if (btn) {
      e.stopPropagation();
      const dropdown = btn.nextElementSibling;
      const isShown = dropdown?.classList.contains('show');
      document.querySelectorAll('.dropdown-content').forEach(d => d.classList.remove('show'));
      if (!isShown) dropdown?.classList.add('show');
      return;
    }

    const catItem = e.target.closest('.cat-item');
    if (catItem) {
      const val = catItem.getAttribute('data-cat');
      document.querySelectorAll('.cat-item').forEach(i => i.classList.remove('active'));
      catItem.classList.add('active');
      activeCategory = val || null;
      filterAll();
      catItem.closest('.dropdown-content')?.classList.remove('show');
      return;
    }

    const viewItem = e.target.closest('.view-item');
    if (viewItem) {
      const view = viewItem.getAttribute('data-view');
      document.querySelectorAll('.view-item').forEach(i => i.classList.remove('active'));
      viewItem.classList.add('active');
      if (view === 'grid') viewContainer.classList.add('view-grid');
      else viewContainer.classList.remove('view-grid');
      filterAll();
      viewItem.closest('.dropdown-content')?.classList.remove('show');
      return;
    }

    if (!e.target.closest('.dropdown')) {
      document.querySelectorAll('.dropdown-content').forEach(d => d.classList.remove('show'));
    }
  });

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      const id = entry.target.getAttribute('data-id');
      if (entry.isIntersecting) visibleIds.add(id); else visibleIds.delete(id);
    });
  }, { threshold: 0.01 });

  tableRows.forEach(row => observer.observe(row));

  async function refreshData() {
    if (visibleIds.size === 0) return;
    const idsArray = Array.from(visibleIds);
    const now = Math.floor(Date.now() / 1000);
    const query = idsArray.map(id => `ids[]=${id}`).join('&');
    const url = `https://hermes.pyth.network/v2/updates/price/latest?${query}&parsed=true`;

    try {
      const response = await fetch(url);
      const data = await response.json();
      data?.parsed?.forEach(item => {
        const normId = item.id.startsWith('0x') ? item.id : '0x' + item.id;
        const row = document.querySelector(`tr[data-id="${normId}"]`);
        if (row) {
          const priceCell = row.querySelector('.js-price');
          const statusDot = row.querySelector('.js-status');
          const updateCell = row.querySelector('.js-update');
          const val = parseFloat(item.price.price) * Math.pow(10, item.price.expo);
          const age = now - parseInt(item.price.publish_time);
          const formatted = val.toLocaleString(undefined, { maximumFractionDigits: 8 });
          
          if (priceCell.innerText !== formatted) {
            priceCell.innerText = formatted;
            priceCell.classList.add('price-flash');
            setTimeout(() => priceCell.classList.remove('price-flash'), 2000);
          }
          updateCell.innerText = new Date(item.price.publish_time * 1000).toLocaleTimeString(lang, timeOptions);
          statusDot.style.background = age < 15 ? '#10b981' : (age < 60 ? '#f59e0b' : '#ef4444');
          statusDot.style.boxShadow = age < 60 ? `0 0 10px ${statusDot.style.background}` : 'none';
        }
      });
    } catch (err) {}
    if (syncLabel) syncLabel.innerText = "Live / " + new Date().toLocaleTimeString(lang, timeOptions);
  }
  setInterval(refreshData, 3000);
</script>

<style is:global>
  .main-frame, .content-panel, .sl-container { max-width: 100% !important; width: 100% !important; margin: 0 !important; background: transparent !important; }
  
  /* GRID VIEW */
  .view-grid { background: transparent !important; border: none !important; backdrop-filter: none !important; box-shadow: none !important; }
  .view-grid table, .view-grid thead, .view-grid tbody, .view-grid tr, .view-grid td { display: block !important; border: none !important; margin: 0 !important; }
  .view-grid thead { display: none !important; }
  .view-grid tbody { display: grid !important; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)) !important; gap: 1.25rem !important; align-items: stretch !important; }
  .view-grid tr { display: flex !important; flex-direction: column !important; background: rgba(var(--sl-color-bg-nav-rgb), 0.6) !important; backdrop-filter: blur(20px) !important; border: 1px solid var(--sl-color-gray-5) !important; border-radius: 1rem !important; padding: 1.5rem !important; height: 100% !important; min-height: 240px !important; position: relative !important; }
  .view-grid tr[style*="display: none"] { display: none !important; }
  .view-grid td { width: 100% !important; padding: 0.3rem 0 !important; background: transparent !important; border: none !important; }
  .view-grid .td-pair { order: 1; }
  .view-grid .pair-link { font-size: 1.3rem; color: #9d7cfd !important; }
  .view-grid .td-desc { order: 2; flex-grow: 1; margin: 0.5rem 0 !important; }
  .view-grid .cell-price { order: 3; font-size: 1.6rem; border-top: 1px solid var(--sl-color-gray-6) !important; padding-top: 0.8rem !important; margin-top: auto; font-family: 'JetBrains Mono', monospace; }
  .view-grid .td-status { position: absolute !important; top: 1.5rem; right: 1.5rem; width: auto !important; padding: 0 !important; }

  @keyframes flash-price { 0% { color: #9d7cfd; text-shadow: 0 0 10px #9d7cfd; } 100% { color: inherit; text-shadow: none; } }
  .price-flash { animation: flash-price 2s ease-out; }
</style>

<style>
  .explorer-visual-context { position: relative; margin: -2rem -3rem; padding: 2rem 3rem; }
  .wormhole-background { position: fixed; inset: 0; z-index: -1; pointer-events: none; background: var(--sl-color-bg); }
  
  /* PŘEVZATO Z CHAINLINK.ASTRO PRO IDENTICKOU VÝŠKU */
  .glass-panel {
    background: rgba(var(--sl-color-bg-nav-rgb), 0.85) !important;
    backdrop-filter: blur(30px) !important;
    border: 1px solid var(--sl-color-gray-5) !important;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }

  .stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 2rem; }
  .stat-card { padding: 1.5rem; border-radius: 0.75rem; min-height: 100px; display: flex; flex-direction: column; justify-content: center; margin-top: 0 !important; }
  .label { font-size: 0.75rem; color: var(--sl-color-gray-3); text-transform: uppercase; margin-bottom: 0.25rem; }
  .value { font-size: 1.2rem; font-weight: bold; color: var(--sl-color-white); }
  
  .table-container { border-radius: 0.75rem; overflow-x: auto; width: 100%; }
  table { width: 100%; border-collapse: separate; border-spacing: 0; table-layout: fixed; }
  th, td { padding: 1rem; border-bottom: 1px solid var(--sl-color-gray-6); vertical-align: middle; }
  
  .th-pair, .td-pair { width: 100px; }
  .th-desc, .td-desc { width: auto; min-width: 200px; }
  .th-price, .cell-price { width: 130px; }
  .th-status, .td-status { width: 60px; text-align: center; }
  .th-update, .cell-update { width: 120px; }
  .th-cat, .td-cat { width: 130px; text-align: right; }

  th { background: rgba(157, 124, 253, 0.1); color: #9d7cfd; border-bottom: 2px solid var(--sl-color-gray-5); font-size: 0.8rem; text-align: left; }
  tbody tr:hover { background: rgba(157, 124, 253, 0.05); }
  
  .pair-link { color: #9d7cfd !important; font-weight: bold; text-decoration: none; }
  .asset-desc { font-size: 0.85rem; color: var(--sl-color-gray-3); line-height: 1.4; }
  .cell-price { font-family: 'JetBrains Mono', monospace; font-weight: bold; }
  .status-dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
  .badge-row { font-size: 0.65rem; background: rgba(157, 124, 253, 0.1); padding: 0.2rem 0.5rem; border-radius: 4px; color: #9d7cfd; font-weight: 600; }

  @media (max-width: 1000px) {
    .stats-grid { grid-template-columns: 1fr; }
    .th-desc, .td-desc { display: none; }
  }
</style>

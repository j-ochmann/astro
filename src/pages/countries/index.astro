---
// src/pages/countries/index.astro
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { countries, getAllContinents } from '@/content/config/i18n';

const continents = getAllContinents();
const allCountries = Object.values(countries).sort((a, b) => a.name.localeCompare(b.name));
---

<StarlightPage frontmatter={{ title: 'Atlas zemí světa', template: 'splash' }}>
  
  <p>Prozkoumejte podrobné statistiky zemí podle kontinentů.</p>

  {continents.map(continent => (
    <section>
      <h2>{continent}</h2>
      <div class="country-grid">
        {allCountries
          .filter(c => c.continent === continent)
          .map(country => (
            <a href={`/countries/${country.code.toLowerCase()}/`} class="country-card">
              <span class:list={['fi', `fi-${country.code.toLowerCase()}`]}></span>
              <span class="name">{country.name}</span>
            </a>
          ))}
      </div>
    </section>
  ))}

  <style>
    .country-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: 1rem;
      margin-bottom: 3rem;
    }

    .country-card {
      display: flex;
      align-items: center;
      gap: 0.8rem;
      padding: 0.75rem;
      background: var(--sl-color-gray-6);
      border: 1px solid var(--sl-color-hairline);
      border-radius: 0.5rem;
      text-decoration: none;
      color: var(--sl-color-white) !important;
      transition: all 0.2s ease;
    }

    .country-card:hover {
      background: var(--sl-color-gray-5);
      border-color: var(--sl-color-accent);
      transform: translateY(-2px);
    }

    .name {
      font-size: 0.9rem;
      font-weight: 500;
    }
  </style>
</StarlightPage>